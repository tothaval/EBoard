<UserControl x:Class="EBoardElementPluginMyNote.MyNoteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EBoardElementPluginMyNote"
             xmlns:vms="clr-namespace:EBoardElementPluginMyNote.ViewModels"
             xmlns:views="clr-namespace:EBoardElementPluginMyNote.Views"
             xmlns:eboardsdkarea="clr-namespace:EBoardSDK.Controls.Area;assembly=EBoardSDK"
             xmlns:eboardsdkProtocol="clr-namespace:EBoardSDK.Plugins.Elements.Protocol;assembly=EBoardSDK"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=local:MyNoteViewModel}"
             FontSize="{Binding ElementViewModel.FluidUI.Font.FontSize, NotifyOnSourceUpdated=True}"
             FontFamily="{Binding ElementViewModel.FluidUI.Font.FontFamily, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
             FontWeight="{Binding ElementViewModel.FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="visConv"/>
    </UserControl.Resources>

    <!--<UserControl.InputBindings>
        <MouseBinding MouseAction="LeftDoubleClick"
                          Command="{Binding NewNoteCommand}"/>
    </UserControl.InputBindings>-->

    <Border BorderBrush="Transparent" Margin="15"
    Background="Transparent">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <!--<ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>-->
            </Grid.ColumnDefinitions>

            <TabControl  Background="Transparent"
                 BorderThickness="0"
                 BorderBrush="Transparent"
                 Grid.Column="0"
                         HorizontalAlignment="Center"
                         HorizontalContentAlignment="Stretch"
                 >

                <TabItem x:Name="TI_log"  Header="Log"
                 Background="FloralWhite"
                 Foreground="Black"
                 BorderBrush="Transparent"
                 BorderThickness="0"
                         HorizontalAlignment="Center">
                    <eboardsdkProtocol:ProtocolView DataContext="{Binding Protocol}"
                                    HorizontalAlignment="Center"/>
                </TabItem>

                <TabItem x:Name="TI_notes" Header="Notes"
                 Background="FloralWhite"
                 Foreground="Black"                         
                 BorderBrush="Transparent"
                 BorderThickness="0">
                    <views:NotesView DataContext="{Binding Notes}"/>
                </TabItem>

                <TabItem x:Name="TI_matrix"  Header="Matrix"
                 Background="FloralWhite"
                 Foreground="Black"
                 BorderBrush="Transparent"
                 BorderThickness="0">
                    <eboardsdkarea:AreaView DataContext="{Binding AreaViewModel}"/>
                </TabItem>

                <TabItem x:Name="TI_history"  Header="History"
                 Background="FloralWhite"
                 Foreground="Black"
                 BorderBrush="Transparent"
                 BorderThickness="0">
                </TabItem>

            </TabControl>

            <!--<StackPanel Visibility="Hidden"
                        IsEnabled="False"
