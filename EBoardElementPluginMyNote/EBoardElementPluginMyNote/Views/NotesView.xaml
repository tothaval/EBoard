<UserControl x:Class="EBoardElementPluginMyNote.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EBoardElementPluginMyNote.Views"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:utils="clr-namespace:EBoardSDK.SharedMethods;assembly=EBoardSDK"
             xmlns:eboardsdkProtocol="clr-namespace:EBoardSDK.Plugins.Elements.Protocol;assembly=EBoardSDK"
             Foreground="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultTextBlock}" >
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBox}">
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding ViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="0 0 10 0"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding ViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderThickness" Value="3"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DefaultButtonBorder"
                           Background="{TemplateBinding Background}"
                           BorderBrush="{TemplateBinding BorderBrush}"
                           BorderThickness="3"                            
                           CornerRadius="5" 
                           MinHeight="25"
                           Margin="5"
                           Padding="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Background, NotifyOnSourceUpdated=True}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <utils:DateConverter x:Key="DateTimeConverter"/>

        <BooleanToVisibilityConverter x:Key="visConv"/>

        <!--<CornerRadius x:Key="Radius">15</CornerRadius>
        <CornerRadius x:Key="NoteRadius">15</CornerRadius>

        <sys:Double x:Key="FontSize">11.0</sys:Double>

        <Style TargetType="{x:Type Button}" x:Key="DefaultButton">
            <Setter Property="MinWidth" Value="25"/>
            <Setter Property="MinHeight" Value="25"/>
        </Style>

        <Style TargetType="{x:Type RichTextBox}" x:Key="HeaderRichTextBox">
        </Style>

        <Style TargetType="{x:Type RichTextBox}" x:Key="ContentRichTextBox">
        </Style>

        <Style TargetType="{x:Type RichTextBox}" x:Key="DateTimeRichTextBox">
        </Style>

        <Style TargetType="{x:Type TextBox}" x:Key="HeaderTextBox">
            <Setter Property="FontSize" Value="{DynamicResource HeaderFontSize}"/>
        </Style>

        <Style TargetType="{x:Type TextBox}" x:Key="ContentTextBox">
            <Setter Property="FontSize" Value="{DynamicResource ContentFontSize}"/>
        </Style>

        <Style TargetType="{x:Type TextBlock}" x:Key="DateTimeTextBlock">
            <Setter Property="FontSize" Value="{DynamicResource DateTimeFontSize}"/>
        </Style>-->
    </UserControl.Resources>

    <Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="1"
                    Grid.Column="0"     
                    Margin="0 0 7 0"
                    VerticalAlignment="Top"
                    >
                <Button Width="50"
                        Height="50"
                        Content="..."
                        Command="{Binding ShowHideCommand}"/>
            </Border>

            <Grid Grid.Row="1"
                  Grid.RowSpan="2"
                  Grid.Column="1"
                  Margin="0 0 10 0" 
                  Visibility="{Binding ShowHideClicked,
                Converter={StaticResource visConv}}">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition SharedSizeGroup="r1"/>
                </Grid.RowDefinitions>

                <Button Content="+" Command="{Binding NewNoteCommand}"
                        Grid.Column="0"
                    
                    />
                <Button Content="-"
                        Command="{Binding DeleteNoteCommand}"
                        CommandParameter="{Binding ElementName=LB_Notes, Path=SelectedItems}"
                        Grid.Column="2"/>

                <Border CornerRadius="{Binding ViewModel.FluidUI.Size.CorneRadius}"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Grid.Row="1"
                        BorderBrush="{Binding ViewModel.FluidUI.Design.Border}"
                        BorderThickness="5"
                        Padding="0"
                        >
                    <Border CornerRadius="{Binding ViewModel.FluidUI.Size.CorneRadius}">
                        <Border.OpacityMask>
                            <VisualBrush>
                                <VisualBrush.Visual>
                                    <Border 
                                        Background="Black"
                                        SnapsToDevicePixels="True"
                                        CornerRadius="{Binding ViewModel.FluidUI.Size.CorneRadius, RelativeSource={RelativeSource AncestorType=Border}}"
                                        Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}}"
                                        Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Border}}"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Border.OpacityMask>

                        <ListBox ItemsSource="{Binding Notes}"
                                 Name="LB_Notes"
                                 SelectedItem="{Binding Note, NotifyOnSourceUpdated=True}"
                                 SelectionMode="Extended"
                                 Foreground="{Binding ViewModel.FluidUI.Design.Foreground}"
                                >
                            <ListBox.ToolTip>
                                <ToolTip Background="{Binding ViewModel.FluidUI.Design.Background}"
                                         Foreground="{Binding ViewModel.FluidUI.Design.Foreground}"
                                         BorderBrush="{Binding ViewModel.FluidUI.Design.Border}"
                                         BorderThickness="2"
                                         Margin="5 0 5 0">
                                    <TextBlock >
                                        <Run Text="edited"/>
                                        <LineBreak/>
                                        <Run Text="title"/>
                                        <LineBreak/>
                                        <Run Text="created"/>
                                    </TextBlock>
                                </ToolTip>
                            </ListBox.ToolTip>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding ViewModel.FluidUI.Design.Background}"
                                            BorderBrush="{Binding ViewModel.FluidUI.Design.Border}"                                            
                                            BorderThickness="2">
                                        <Grid IsHitTestVisible="False">
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="{Binding DateTime_Edited, NotifyOnSourceUpdated=True,
                                                Converter={StaticResource DateTimeConverter}}"
                                                       Grid.Row="0"/>

                                            <TextBlock Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                       TextWrapping="Wrap"
                                                       Grid.Row="1"                                          
                                                       />
                                            <TextBlock Text="{Binding DateTime_Created, NotifyOnSourceUpdated=True,
                                                Converter={StaticResource DateTimeConverter}}"
                                                       Grid.Row="2"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Border>
            </Grid>

            <eboardsdkProtocol:ProtocolView DataContext="{Binding Note, NotifyOnSourceUpdated=True, Mode=OneWay}"
                                            Grid.Column="2"
                                            Grid.Row="1"
                                            MinWidth="250"
                                            MinHeight="250"/>
        </Grid>
    </Border>
</UserControl>

