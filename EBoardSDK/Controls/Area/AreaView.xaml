<UserControl x:Class="EBoardSDK.Controls.Area.AreaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EBoardSDK.Controls.Area"
             d:DataContext="{d:DesignInstance Type=local:AreaViewModel`1}"
             FontSize="{Binding ElementViewModel.FluidUI.Font.FontSize, NotifyOnSourceUpdated=True}"
             FontFamily="{Binding ElementViewModel.FluidUI.Font.FontFamily, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
             FontWeight="{Binding ElementViewModel.FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="booltovis"/>
        
        <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultTextBlock}" >
            <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBox}">
            <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding ElementViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0 0 10 0"/>
        </Style>

        <Style TargetType="Button" x:Key="btn">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="{Binding ElementViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            
            <!--<Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DefaultButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" 
                                CornerRadius="3" >
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding ElementViewModel.FluidUI.Design.Highlight, NotifyOnSourceUpdated=True}"/>
                    <Setter Property="Foreground" Value="Transparent"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                </Trigger>
            </Style.Triggers>-->
        </Style>
        
    </UserControl.Resources>
    
    <Grid Margin="5"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Background="Transparent"
                Foreground="{Binding ElementViewModel.FluidUI.Design.Foreground}"
                Style="{StaticResource btn}"
                Visibility="{Binding Path=IsMatrixChangeable, Converter={StaticResource booltovis}}"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Content="-"
                Width="20"
                Height="50"
                Grid.Column="0"
                Grid.Row="1"
                Command="{Binding RemoveLineCommand}"/>

        <Button Background="{Binding ElementViewModel.FluidUI.Design.Foreground}"
                Foreground="{Binding ElementViewModel.FluidUI.Design.Background}"
                Style="{StaticResource btn}"
                Visibility="{Binding Path=IsMatrixChangeable, Converter={StaticResource booltovis}}"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                TextBlock.TextAlignment="Center"
                Content="+"
                Width="20"
                Height="50"
                Grid.Column="0"                
                Grid.Row="2"
                Command="{Binding AddLineCommand}"/>

        <Button Background="Transparent"
                Foreground="{Binding ElementViewModel.FluidUI.Design.Foreground}"
                Style="{StaticResource btn}"
                Visibility="{Binding Path=IsMatrixChangeable, Converter={StaticResource booltovis}}"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Content="-"
                Width="50"
                Height="20"
                Grid.Column="1"
                Grid.Row="0"
                Command="{Binding RemoveRowCommand}"/>

        <Button Background="{Binding ElementViewModel.FluidUI.Design.Foreground}"
                Foreground="{Binding ElementViewModel.FluidUI.Design.Background}"
                Style="{StaticResource btn}"
                Visibility="{Binding Path=IsMatrixChangeable, Converter={StaticResource booltovis}}"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Content="+"
                Width="50"
                Height="20"
                Grid.Column="2"
                Grid.Row="0"
                Command="{Binding AddRowCommand}"/>

        <Border BorderBrush="{Binding ElementViewModel.FluidUI.Design.Border}"
                Visibility="{Binding Path=IsMatrixChangeable, Converter={StaticResource booltovis}}"
                Margin="20 0 0 0"
                MinWidth="25"
                Grid.Column="3"
                Grid.Row="0">
            <TextBlock Text="{Binding AreaVerticalOuterViewModel.HorizontalCount}"
                       HorizontalAlignment="Right"/>
        </Border>

        <Border BorderBrush="{Binding ElementViewModel.FluidUI.Design.Border}"
                Visibility="{Binding Path=IsMatrixChangeable, Converter={StaticResource booltovis}}"
                Margin="0 20 0 0"
                MinHeight="25"
                Grid.Column="0"
                Grid.Row="3">
            <TextBlock Text="{Binding AreaVerticalOuterViewModel.VerticalCount}"
                       TextAlignment="Center"
                       Margin="0"
                       Padding="0"/>
        </Border>

        <Border Grid.Column="1"
                Grid.ColumnSpan="4"
                Grid.Row="1"
                Grid.RowSpan="4"
                Background="Transparent"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <local:AreaVerticalOuterView DataContext="{Binding AreaVerticalOuterViewModel}"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch"
                                         HorizontalContentAlignment="Stretch"
                                         VerticalContentAlignment="Stretch"
                                         Background="Transparent"/>
        </Border>
    </Grid>
</UserControl>

<!-- EOF -->