<MenuItem x:Class="EBoardSDK.Controls.BrushSetup.BrushSetupView"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
          xmlns:local="clr-namespace:EBoardSDK.Controls.BrushSetup"
          xmlns:linear="clr-namespace:EBoardSDK.Controls.BrushSetup.LinearBrushSetup"
          xmlns:radial="clr-namespace:EBoardSDK.Controls.BrushSetup.RadialBrushSetup"
          xmlns:solid="clr-namespace:EBoardSDK.Controls.BrushSetup.SolidBrushSetup"
          d:DataContext="{d:DesignInstance Type=local:BrushSetupViewModel}"
          mc:Ignorable="d" 
          StaysOpenOnClick="True"
          d:DesignHeight="450" d:DesignWidth="800">

    <MenuItem.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultTextBlock}">
            <Setter Property="Background" Value="{Binding ViewModel.FluidUI.Design.Background}"/>
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground}"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground}"/>
            <Setter Property="BorderBrush" Value="{Binding ViewModel.FluidUI.Design.Border}"/>
            <Setter Property="BorderThickness" Value="3 0"/>

            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{Binding ViewModel.FluidUI.Design.Foreground}"/>
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Background}"/>
                </Trigger>

                <Trigger Property="IsSelected" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding ViewModel.FluidUI.Design.Highlight}"/>
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Background}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding ViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DefaultButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="3"                            
                                CornerRadius="5" 
                                MinWidth="50"
                                MinHeight="25"
                                Margin="5"
                                Padding="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Background, NotifyOnSourceUpdated=True}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </MenuItem.Resources>

    <TabControl Padding="5">
        <TabItem Header="Solid">
            <solid:SolidBrushSetupView DataContext="{Binding SolidBrush}"/>
        </TabItem>

        <TabItem Header="Linear">
            <linear:LinearBrushSetupView DataContext="{Binding LinearBrush}"/>
        </TabItem>

        <TabItem Header="Radial">
            <radial:RadialBrushSetupView DataContext="{Binding RadialBrush}"/>
        </TabItem>

        <TabItem Header="Image">
            <UniformGrid Columns="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="path"
                               Grid.Column="0"/>

                    <TextBox Text="{Binding ImagePath, UpdateSourceTrigger=Default, Delay=500}"
                             MaxWidth="200"
                             Grid.Column="1"/>
                </Grid>
                
                <Button Content="Image" Command="{Binding  SetImageCommand}"/>

                <Button Content="Reset" Command="{Binding ResetImageCommand}"/>
            </UniformGrid>
        </TabItem>

        <TabItem Header="Visual">
            <UniformGrid Columns="1">
                <TextBlock TextAlignment="Center">
                    <Run Text="Visual Brush examples"/>
                    <LineBreak/>
                    <Run Text="won't be restored on eboard start."/>
                </TextBlock>
                <Button Content="example 0"
                        Command="{Binding  ExampleVisualBrushCommand}"
                        CommandParameter="0"/>
                <Button Content="example 1"
                        Command="{Binding  ExampleVisualBrushCommand}"
                        CommandParameter="1"/>
                <Button Content="example 2"
                        Command="{Binding  ExampleVisualBrushCommand}"
                        CommandParameter="2"/>
                <Button Content="example 3"
                        Command="{Binding  ExampleVisualBrushCommand}"
                        CommandParameter="3"/>
                <Button Content="example 4"
                        Command="{Binding  ExampleVisualBrushCommand}"
                        CommandParameter="4"/>
            </UniformGrid>
        </TabItem>
    </TabControl>
</MenuItem>

<!-- EOF -->