<UserControl x:Class="EBoardSDK.Controls.BrushSetup.SolidBrushSetup.SolidBrushSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EBoardSDK.Controls.BrushSetup.SolidBrushSetup"
             xmlns:enums="clr-namespace:EBoardSDK.Enums"
             d:DataContext="{d:DesignInstance Type=local:SolidBrushSetupViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="SCBS">

    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultTextBlock}" >
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBox}">
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding ViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="0 0 10 0"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding ViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderThickness" Value="3"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DefaultButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="3"                            
                                CornerRadius="5" 
                                MinWidth="50"
                                MinHeight="25"
                                Margin="5"
                                Padding="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Background, NotifyOnSourceUpdated=True}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style TargetType="Slider" BasedOn="{StaticResource DefaultHorizontalSlider}">
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Margin" Value="10 0"/>
            <Setter Property="Maximum" Value="255"/>
            <Setter Property="Width" Value="256"/>
        </Style>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition SharedSizeGroup="A" Width="auto"/>
            <ColumnDefinition SharedSizeGroup="B" Width="*"/>
            <ColumnDefinition SharedSizeGroup="C" Width="auto"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Column="0"
              Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Text="Color"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Grid.Column="0"
                       Grid.Row="0"/>

            <Button Content="Reset"
                    Command="{Binding ResetCommand}"
                    Grid.Column="1"
                    Grid.Row="0"/>

            <TextBlock Text="{Binding ColorStringValue, NotifyOnSourceUpdated=True}"
                       Grid.Column="0"
                       Grid.ColumnSpan="2"
                       Grid.Row="1"/>

            <!--<ComboBox Text="by name:"
                      ItemsSource="{Binding ColorNames}"
                      SelectedItem="{Binding ColorName}"
                       Grid.Column="0"
                       Grid.ColumnSpan="2"
                       Grid.Row="2">
                --><!--<ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>--><!--                
            </ComboBox>-->
        </Grid>
        
        <Rectangle Fill="{Binding ColorBrush, Mode=OneWay, NotifyOnSourceUpdated=True}"
                   Margin="10 0"
                   MinWidth="100"
                   HorizontalAlignment="Stretch"
                   Stroke="{Binding ViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"
                   StrokeThickness="1"
                   Grid.Column="1"
                   Grid.Row="0"/>

        <Button Content="Ok"
                Command="{Binding OkCommand}"
                Grid.Column="2"
                Grid.Row="0"/>

        <TextBlock Text="Greyscale"
                   Grid.Column="0"
                   Grid.Row="1"/>
        <TextBox Text="{Binding GreyscaleValue, UpdateSourceTrigger=PropertyChanged, Delay=50}"
                 Grid.Column="1"
                 Grid.Row="1"/>
        <Slider Value="{Binding GreyscaleValue, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True, UpdateSourceTrigger=PropertyChanged}"
                Grid.Column="2"
                Grid.Row="1"/>

        <TextBlock Text="Red"
                   Grid.Row="2"
                   Grid.Column="0"/>
        <TextBox Text="{Binding RedValue, UpdateSourceTrigger=PropertyChanged, Delay=50}"
                 Grid.Column="1"
                 Grid.Row="2"/>
        <Slider Value="{Binding RedValue, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True, UpdateSourceTrigger=PropertyChanged}"
                Grid.Column="2"
                Grid.Row="2"/>

        <TextBlock Text="Green"
                   Grid.Column="0"
                   Grid.Row="3"/>
        <TextBox Text="{Binding GreenValue, UpdateSourceTrigger=PropertyChanged, Delay=50}"
                 Grid.Column="1"
                 Grid.Row="3"/>
        <Slider Value="{Binding GreenValue, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True, UpdateSourceTrigger=PropertyChanged}"
                Grid.Column="2"
                Grid.Row="3"/>

        <TextBlock Text="Blue"
                   Grid.Column="0"
                   Grid.Row="4"/>
        <TextBox Text="{Binding BlueValue, UpdateSourceTrigger=PropertyChanged, Delay=50}"
                 Grid.Column="1"
                 Grid.Row="4"/>
        <Slider Value="{Binding BlueValue, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True, UpdateSourceTrigger=PropertyChanged}"
                Grid.Column="2"
                Grid.Row="4"/>

        <TextBlock Text="Alpha"
                   Grid.Column="0"
                   Grid.Row="5"/>
        <TextBox Text="{Binding AlphaValue, UpdateSourceTrigger=PropertyChanged, Delay=50}"
                 Grid.Column="1"
                 Grid.Row="5"/>
        <Slider Value="{Binding AlphaValue, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True, UpdateSourceTrigger=PropertyChanged}"
                Grid.Column="2"
                Grid.Row="5"/>
    </Grid>
</UserControl>

<!-- EOF -->