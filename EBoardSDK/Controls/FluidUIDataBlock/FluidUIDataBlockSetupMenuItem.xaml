<MenuItem x:Class="EBoardSDK.Controls.FluidUIDataBlock.FluidUIDataBlockSetupMenuItem"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
          xmlns:local="clr-namespace:EBoardSDK.Controls.FluidUIDataBlock"
          xmlns:fuim="clr-namespace:EBoardSDK.Controls.FluidUIMenu"
          xmlns:fui_it="clr-namespace:EBoardSDK.Controls.FluidUIDataBlock.FluidUIIndexText"
          xmlns:fui_kt="clr-namespace:EBoardSDK.Controls.FluidUIDataBlock.FluidUIKeyText"
          d:DataContext="{d:DesignInstance Type=local:FluidUIDataBlockSetupMenuItemViewModel}"
          Header="Data"
          mc:Ignorable="d" 
          d:DesignHeight="450" d:DesignWidth="800"
          StaysOpenOnClick="True">

    <MenuItem.Resources>
        <Style TargetType="MenuItem" BasedOn="{StaticResource MenuItemStyle}" x:Key="menuitem">
            <Setter Property="BorderBrush" Value="{Binding ViewModel.FluidUI.Design.Border}"/>
            <Setter Property="TextBlock.Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground}"/>
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground}"/>
            <Setter Property="Background" Value="{Binding ViewModel.FluidUI.Design.Background}"/>
            <Setter Property="StaysOpenOnClick" Value="True"/>

            <Style.Triggers>
                <!--<Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Highlight}"/>
                </Trigger>

                <Trigger Property="IsSubmenuOpen" Value="false">
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground}"/>
                </Trigger>-->

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Highlight}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </MenuItem.Resources>

    <local:FluidUIDataBlockSetupView DataContext="{Binding SetupViewModel}"/>
</MenuItem>

<!-- EOF -->