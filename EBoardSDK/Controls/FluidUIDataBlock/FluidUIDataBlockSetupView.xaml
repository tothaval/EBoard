<MenuItem x:Class="EBoardSDK.Controls.FluidUIDataBlock.FluidUIDataBlockSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EBoardSDK.Controls.FluidUIDataBlock"
             xmlns:fui_it="clr-namespace:EBoardSDK.Controls.FluidUIDataBlock.FluidUIIndexText"
             d:DataContext="{d:DesignInstance Type=local:FluidUIDataBlockSetupViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <MenuItem.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultTextBlock}" >
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBox}">
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding ViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0 0 10 0"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding ViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderThickness" Value="3"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DefaultButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="3"                            
                                CornerRadius="5" 
                                MinWidth="50"
                                MinHeight="25"
                                Margin="5"
                                Padding="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Background, NotifyOnSourceUpdated=True}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground}"/>
            <Setter Property="BorderBrush" Value="{Binding ViewModel.FluidUI.Design.Border}"/>
            <Setter Property="BorderThickness" Value="3 0"/>

            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{Binding ViewModel.FluidUI.Design.Foreground}"/>
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Background}"/>
                </Trigger>

                <Trigger Property="IsSelected" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding ViewModel.FluidUI.Design.Highlight}"/>
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Background}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground}"/>
                </Trigger>
            </Style.Triggers>
            
        </Style>
    </MenuItem.Resources>

    <TabControl Background="Transparent">

        <!-- Title and Text -->
        <TabItem Header="Title and Text">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Text="Title"
                   VerticalAlignment="Center"
                   Grid.Column="0"
                   Grid.Row="0"/>
                <TextBox Text="{Binding ViewModel.FluidUI.DataBlock.Title, NotifyOnSourceUpdated=True}"
                 Grid.Column="1"
                 Grid.Row="0"/>

                <TextBlock Text="Text"
                   Grid.Column="0"
                   Grid.Row="1"/>
                <TextBox Text="{Binding ViewModel.FluidUI.DataBlock.Text, NotifyOnSourceUpdated=True}"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 Grid.Column="1"
                 Grid.Row="1"/>

                <Button Content="Reset"
                Command="{Binding ResetDataBlockCommand}"
                Grid.Column="2"
                Grid.Row="0"
                Grid.RowSpan="2"/>
            </Grid>
        </TabItem>


        <!-- Index Text List -->
        <TabItem Header="Index Text List">
            <Grid Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <ComboBox ItemsSource="{Binding FluidUIIndexTexts, NotifyOnSourceUpdated=True}"
                          SelectedItem="{Binding FluidUIIndexText}"
                          Foreground="{Binding ViewModel.FluidUI.Design.Foreground}"
                          Grid.Row="0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Background="Transparent"  ToolTip="{Binding Text}">
                                <Run Text="{Binding Index}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding Time}"/>
                            </TextBlock> 
                        </DataTemplate>
                    </ComboBox.ItemTemplate>    
                </ComboBox>

                <fui_it:FluidUIIndexTextView DataContext="{Binding FluidUIIndexText}"
                         Grid.Row="1"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                
                <Button Content="Add"
                        Command="{Binding AddIndexTextCommand}"
                        Grid.Column="0"/>
                <Button Content="Del"
                        Command="{Binding DeleteIndexTextCommand}"
                        Grid.Column="1"/>
                <Button Content="Clear"
                        Command="{Binding ClearIndexTextListCommand}"
                        Grid.Column="2"
                        />
                </Grid>
            </Grid>
        </TabItem>

        <!-- Key Text List -->
        <TabItem Header="Key Text List">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                
                
            </Grid>
        </TabItem>

        <!-- Quad Index Text -->
        <TabItem Header="Quad Index Text">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>


            </Grid>
        </TabItem>

        <!-- Quad Key Text -->
        <TabItem Header="Quad Key Text">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
            </Grid>
        </TabItem>
    </TabControl>
</MenuItem>

<!-- EOF -->