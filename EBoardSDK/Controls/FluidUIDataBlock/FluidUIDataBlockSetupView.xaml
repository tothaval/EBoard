<TabControl x:Class="EBoardSDK.Controls.FluidUIDataBlock.FluidUIDataBlockSetupView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            xmlns:local="clr-namespace:EBoardSDK.Controls.FluidUIDataBlock"
            xmlns:winds="clr-namespace:EBoardSDK.Windows"
            xmlns:fuim="clr-namespace:EBoardSDK.Controls.FluidUIMenu"
            xmlns:fui_it="clr-namespace:EBoardSDK.Controls.FluidUIDataBlock.FluidUIIndexText"
            xmlns:fui_kt="clr-namespace:EBoardSDK.Controls.FluidUIDataBlock.FluidUIKeyText"
            d:DataContext="{d:DesignInstance Type=local:FluidUIDataBlockSetupViewModel}"
            FontSize="{Binding ViewModel.FluidUI.Font.FontSize, NotifyOnSourceUpdated=True}"
            FontFamily="{Binding ViewModel.FluidUI.Font.FontFamily, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
            FontWeight="{Binding ViewModel.FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}"
            Foreground="{Binding ViewModel.FluidUI.Design.Foreground}"
            Style="{StaticResource DefaultTabControl}"
            mc:Ignorable="d" 
            d:DesignHeight="450" d:DesignWidth="800">

    <TabControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultTextBlock}" >
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBox}">
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding ViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding ViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DefaultButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="3"                            
                                CornerRadius="5" 
                                MinWidth="50"
                                MinHeight="25"
                                Margin="5"
                                Padding="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Background, NotifyOnSourceUpdated=True}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>

            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground}"/>
            <Setter Property="BorderBrush" Value="{Binding ViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>

            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="DefaultButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="3"                            
                                CornerRadius="5" 
                                MinWidth="50"
                                MinHeight="25"
                                Margin="5"
                                Padding="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background"
                                    TargetName="DefaultButtonBorder"
                                    Value="{Binding ViewModel.FluidUI.Design.Highlight}"/>
                                <!--<Setter Property="Foreground"
                                        Value="{Binding MainViewModel.FluidUI.Design.Highlight}"/>-->
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Background, NotifyOnSourceUpdated=True}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TabItem" BasedOn="{StaticResource DefaultTabItem}">
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground}"/>
            <Setter Property="BorderBrush" Value="{Binding ViewModel.FluidUI.Design.Border}"/>

            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{Binding ViewModel.FluidUI.Design.Foreground}"/>
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Background}"/>
                </Trigger>

                <Trigger Property="IsSelected" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding ViewModel.FluidUI.Design.Highlight}"/>
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Background}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </TabControl.Resources>

    <!-- Title and Text -->
    <TabItem Header="Title and Text">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid Visibility="{Binding HasStand, Converter={StaticResource VisibilityToCollapsed}}"
                  Grid.Column="0"
                  Grid.ColumnSpan="2"
                  Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto" SharedSizeGroup="stand1"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto" SharedSizeGroup="stand2"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="x"
                         Grid.Column="0"
                         Grid.Row="0"/>
                <Border BorderBrush="{Binding ViewModel.FluidUI.Design.Border}"
                      BorderThickness="0 0 2 0"
                      Margin="0 0 5 0"
                      Grid.Column="1"
                      Grid.Row="0">
                    <TextBlock Text="{Binding ViewModel.FluidUI.Stand.Position.X, NotifyOnSourceUpdated=True}"
                             TextAlignment="Right"
                             Padding="0 0 5 0"/>
                </Border>

                <TextBlock Text="y"
                         Grid.Column="0"
                         Grid.Row="1"/>
                <Border BorderBrush="{Binding ViewModel.FluidUI.Design.Border}"
                      BorderThickness="0 0 2 0"
                      Margin="0 0 5 0"
                      Grid.Column="1"
                      Grid.Row="1">
                    <TextBlock Text="{Binding ViewModel.FluidUI.Stand.Position.Y, NotifyOnSourceUpdated=True}"
                             TextAlignment="Right"
                             Padding="0 0 5 0"/>
                </Border>

                <TextBlock Text="z"
                         Grid.Column="2"
                         Grid.Row="0"/>
                <Border BorderBrush="{Binding ViewModel.FluidUI.Design.Border}"
                      BorderThickness="0 0 2 0"
                      Margin="0 0 5 0"
                      Grid.Column="3"
                      Grid.Row="0">
                    <TextBlock Text="{Binding ViewModel.FluidUI.Stand.Z, NotifyOnSourceUpdated=True}"
                             TextAlignment="Right"
                             Padding="0 0 5 0"/>
                </Border>

                <TextBlock Text="°"
                         Grid.Column="2"
                         Grid.Row="1"/>
                <Border BorderBrush="{Binding ViewModel.FluidUI.Design.Border}"
                      BorderThickness="0 0 2 0"
                      Margin="0 0 5 0"
                      Grid.Column="3"
                      Grid.Row="1">
                    <TextBlock Text="{Binding ViewModel.FluidUI.Stand.Angle, NotifyOnSourceUpdated=True}"
                             TextAlignment="Right"
                             Padding="0 0 5 0"/>
                </Border>
            </Grid>


            <TextBlock Text="Title"
                           VerticalAlignment="Center"
                           Grid.Column="0"
                           Grid.Row="1"/>
            <TextBox Text="{Binding Title, NotifyOnSourceUpdated=True}"
                         Grid.Column="1"
                         Grid.Row="1"/>

            <TextBlock Text="Text"
                           Grid.Column="0"
                           Grid.Row="2"/>
            <TextBox Text="{Binding Text, NotifyOnSourceUpdated=True}"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         MinWidth="100"
                         Grid.Column="1"
                         Grid.Row="2"/>

            <ToggleButton Content="ToolTip"
                              Grid.Column="2"
                              Grid.Row="0"
                              IsChecked="{Binding ShowToolTip}"/>

            <Button Content="Clear"
                        Command="{Binding ClearDataBlockTextAndTitleCommand}"
                        Grid.Column="3"
                        Grid.Row="0"/>

            <Button Content="Reset"
                        Command="{Binding ResetDataBlockTextAndTitleCommand}"
                        Grid.Column="4"
                        Grid.Row="0"/>
        </Grid>
    </TabItem>

    <!-- Save and Load fluid ui configurations -->
    <TabItem Header="Fluid UI"
             Visibility="{Binding TemplateCreation, Converter={StaticResource InverseVisibilityToCollapsed}}">
        <!-- saves the context menu invoking views fluid ui configuration -->
        <TabControl Background="Transparent">
            <TabItem Header="Save Configuration">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Content="copy"
                            Command="{Binding CopyConfigurationCommand}"
                            CommandParameter="{Binding DataContext, RelativeSource={RelativeSource AncestorType=winds:MainWindow, Mode=FindAncestor}}"
                            Grid.Column="0"/>
                    
                    <fuim:FluidUISelectionView DataContext="{Binding SaveSelectionViewModel}"
                                               ConfirmationButtonContent="save"
                                               Grid.Column="1"/>

                </Grid>
            </TabItem>

            <!-- loads and applies a fluid ui configuration to the context menu invoking view -->
            <TabItem Header="Load Configuration">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Content="paste"
                            Command="{Binding PasteConfigurationCommand}"
                            CommandParameter="{Binding DataContext, RelativeSource={RelativeSource AncestorType=winds:MainWindow, Mode=FindAncestor}}"
                            Grid.Column="0"/>

                    <fuim:FluidUISelectionView DataContext="{Binding LoadSelectionViewModel}"
                                               ConfirmationButtonContent="load"
                                               Grid.Column="1"/>
                </Grid>
            </TabItem>

            <TabItem Header="Previous Configuration">
                <Button Content="reset"
                        Command="{Binding ResetConfigurationToPreviousCommand}"/>
            </TabItem>
        </TabControl>
    </TabItem>

    <!-- Index Text List -->
    <TabItem Header="Index List">
        <Grid Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <ComboBox ItemsSource="{Binding FluidUIIndexTexts, NotifyOnSourceUpdated=True}"
                          SelectedItem="{Binding FluidUIIndexText}"
                          Foreground="{Binding ViewModel.FluidUI.Design.Foreground}"
                          Grid.Row="0">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Background="Transparent"  ToolTip="{Binding Text}">
                                <Run Text="{Binding Index}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding Time}"/>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Content="Add"
                            Command="{Binding AddIndexTextCommand}"
                            Grid.Column="0"/>
                <Button Content="Del"
                            Command="{Binding DeleteIndexTextCommand}"
                            Grid.Column="1"/>
                <Button Content="Clear"
                            Command="{Binding ClearIndexTextListCommand}"
                            Grid.Column="2"/>
            </Grid>

            <Border Visibility="{Binding InverseIndexTextListIsEmpty, Converter={StaticResource VisibilityToCollapsed}}"
                        Grid.Row="2">
                <fui_it:FluidUIIndexTextView DataContext="{Binding FluidUIIndexText}"/>
            </Border>
        </Grid>
    </TabItem>

    <!-- Key Text List -->
    <TabItem Header="Key List">
        <Grid Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <ComboBox ItemsSource="{Binding FluidUIKeyTexts, NotifyOnSourceUpdated=True}"
                          SelectedItem="{Binding FluidUIKeyText}"
                          Foreground="{Binding ViewModel.FluidUI.Design.Foreground}"
                          Grid.Row="0">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Background="Transparent"  ToolTip="{Binding Text}">
                                <Run Text="{Binding Key}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding Time}"/>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Content="Add"
                            Command="{Binding AddKeyTextCommand}"
                            Grid.Column="0"/>
                <Button Content="Del"
                            Command="{Binding DeleteKeyTextCommand}"
                            Grid.Column="1"/>
                <Button Content="Clear"
                            Command="{Binding ClearKeyTextListCommand}"
                            Grid.Column="2"/>
            </Grid>

            <Border Visibility="{Binding InverseKeyTextListIsEmpty, Converter={StaticResource VisibilityToCollapsed}}"
                        Grid.Row="2">
                <fui_kt:FluidUIKeyTextView DataContext="{Binding FluidUIKeyText}"/>
            </Border>
        </Grid>
    </TabItem>

    <!-- Quad Index Text -->
    <TabItem Header="Index Quad">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <ComboBox Foreground="{Binding ViewModel.FluidUI.Design.Foreground}"
                          ItemsSource="{Binding QuadIndexTexts, NotifyOnSourceUpdated=True}"
                          SelectedItem="{Binding SelectedIndexTextQuadValue, NotifyOnSourceUpdated=True}"
                          Grid.Row="0">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Background="Transparent"
                                       Text="{Binding QuadValueTargets}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Button Content="Reset"
                        Command="{Binding ResetSelectedIndexTextQuadValueCommand}"
                        Grid.Column="1"
                        Grid.Row="0"/>

            <fui_it:QuadFluidUIIndexTextView DataContext="{Binding SelectedIndexTextQuadValue}"
                                                 Grid.Column="0"
                                                 Grid.ColumnSpan="2"
                                                 Grid.Row="1"/>
        </Grid>
    </TabItem>

    <!-- Quad Key Text -->
    <TabItem Header="Key Quad">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Button Content="Reset"
                        Command="{Binding ResetSelectedKeyTextQuadValueCommand}"
                        Grid.Column="1"
                        Grid.Row="0"/>

            <ComboBox Foreground="{Binding ViewModel.FluidUI.Design.Foreground}"
                          ItemsSource="{Binding QuadKeyTexts, NotifyOnSourceUpdated=True}"
                          SelectedItem="{Binding SelectedKeyTextQuadValue, NotifyOnSourceUpdated=True}"
                          Grid.Row="0">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Background="Transparent"
                                       Text="{Binding QuadValueTargets}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <fui_kt:QuadFluidUIKeyTextView DataContext="{Binding SelectedKeyTextQuadValue}"
                                               Grid.Column="0"
                                               Grid.ColumnSpan="2"
                                               Grid.Row="1"/>
        </Grid>
    </TabItem>
</TabControl>

<!-- EOF -->