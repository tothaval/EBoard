<UserControl x:Class="EBoardSDK.Controls.FluidUIDataBlock.FluidUIIndexText.QuadFluidUIIndexTextView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EBoardSDK.Controls.FluidUIDataBlock.FluidUIIndexText"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <local:FluidUIIndexTextView DataContext="{Binding Value1}"
                                    Grid.Row="0"/>
        <local:FluidUIIndexTextView DataContext="{Binding Value2}"
                                    Grid.Row="1"/>
        <local:FluidUIIndexTextView DataContext="{Binding Value3}"
                                    Grid.Row="2"/>
        <local:FluidUIIndexTextView DataContext="{Binding Value4}"
                                    Grid.Row="3"/>

    </Grid>
</UserControl>

