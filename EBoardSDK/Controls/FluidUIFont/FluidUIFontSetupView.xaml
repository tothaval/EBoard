<Grid x:Class="EBoardSDK.Controls.FluidUIFont.FluidUIFontSetupView"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
          xmlns:local="clr-namespace:EBoardSDK.Controls.FluidUIFont"
          d:DataContext="{d:DesignInstance Type=local:FluidUIFontSetupViewModel}"
          mc:Ignorable="d" 
          d:DesignHeight="450" d:DesignWidth="800">

    <Grid.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultTextBlock}" >
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="Margin" Value="0 0 10 0"/>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBox}">
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding ViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="MinHeight" Value="65"/>
            <Setter Property="MinWidth" Value="65"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding ViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DefaultButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="3"                            
                                CornerRadius="5" 
                                MinWidth="50"
                                MinHeight="25"
                                Margin="5"
                                Padding="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Background, NotifyOnSourceUpdated=True}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Slider" BasedOn="{StaticResource DefaultHorizontalSlider}">
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="255"/>
            <Setter Property="Width" Value="256"/>
        </Style>
    </Grid.Resources>

    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <Grid.RowDefinitions>
        <RowDefinition/>
        <RowDefinition/>
        <RowDefinition/>
        <RowDefinition/>
        <RowDefinition/>
        <RowDefinition/>
    </Grid.RowDefinitions>

    <Button Content="Reset"
                Command="{Binding ResetCommand}"
                Grid.Column="1"
                Grid.ColumnSpan="3"
                Grid.Row="0"/>

    <!-- Font -->
    <TextBlock Text="Font"
               Grid.Column="0"
               Grid.Row="1"/>
    <ComboBox SelectedItem="{Binding FontFamily, UpdateSourceTrigger=PropertyChanged}"
              ItemsSource="{Binding Source={x:Static Fonts.SystemFontFamilies}}"
              Grid.Column="1"
              Grid.ColumnSpan="3"
              Grid.Row="1">
        <ComboBox.ItemTemplate>
            <DataTemplate>
                <TextBlock Text="{Binding Source}"
                           FontFamily="{Binding Source}"/>
            </DataTemplate>
        </ComboBox.ItemTemplate>
    </ComboBox>

    <!-- Font Size -->
    <TextBlock Text="Size"
               Grid.Column="0"
               Grid.Row="2"/>
    <TextBox Text="{Binding FontSizeValue, NotifyOnSourceUpdated=True}"
             FontSize="{Binding FontSizeValue}"
             Grid.Column="1"
             Grid.Row="2"/>
    <Slider Value="{Binding FontSizeValue, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True, UpdateSourceTrigger=PropertyChanged}"
            VerticalAlignment="Center"
            Grid.Column="2"
            Minimum="7"
            Maximum="42"
            Grid.Row="2"/>
    <Button Content="*"
            Command="{Binding ApplyFontSizeCommand}"
            Grid.Column="3"
            Grid.Row="2"/>

    <!-- Font Weight -->
    <TextBlock Text="Font Weight"
               Grid.Column="0"
               Grid.Row="3"/>
    <ComboBox SelectedItem="{Binding FontWeight}"
              ItemsSource="{Binding FontWeightList, UpdateSourceTrigger=PropertyChanged}"
              Grid.Column="1"
              Grid.ColumnSpan="3"
              Grid.Row="3">
        <ComboBox.ItemTemplate>
            <DataTemplate>
                <TextBlock Text="{Binding}"
                           FontWeight="{Binding}"/>
            </DataTemplate>
        </ComboBox.ItemTemplate>
    </ComboBox>
</Grid>

<!-- EOF -->