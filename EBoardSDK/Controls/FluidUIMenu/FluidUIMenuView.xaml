<MenuItem x:Class="EBoardSDK.Controls.FluidUIMenu.FluidUIMenuView"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
          xmlns:local="clr-namespace:EBoardSDK.Controls.FluidUIMenu"
          xmlns:ut="clr-namespace:EBoardSDK.Utilities"
          xmlns:bs="clr-namespace:EBoardSDK.Controls.BrushSetup"
          xmlns:esdkCtrlQuadSetup="clr-namespace:EBoardSDK.Controls.QuadValueSetup"
          xmlns:fluidUIDataBlock="clr-namespace:EBoardSDK.Controls.FluidUIDataBlock"
          xmlns:fluidUIDesign="clr-namespace:EBoardSDK.Controls.FluidUIDesign"
          xmlns:fluidUIFont="clr-namespace:EBoardSDK.Controls.FluidUIFont"
          xmlns:fluidUISize="clr-namespace:EBoardSDK.Controls.FluidUISize"
          xmlns:fluidUIStand="clr-namespace:EBoardSDK.Controls.FluidUIStand"
          xmlns:views="clr-namespace:EBoardSDK.Views"
          xmlns:conv="clr-namespace:EBoardSDK.SharedMethods"
          d:DataContext="{d:DesignInstance Type=local:FluidUIMenuViewModel}"
          FontSize="{Binding ViewModel.FluidUI.Font.FontSize, NotifyOnSourceUpdated=True}"
          FontFamily="{Binding ViewModel.FluidUI.Font.FontFamily, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
          FontWeight="{Binding ViewModel.FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}"
          Header="FluidUI"
          x:Name="FluidUISetupView"
          mc:Ignorable="d"
          d:DesignHeight="450" d:DesignWidth="800">

    <MenuItem.Resources>
        <conv:BooleanToVisibilityCollapsedConverter x:Key="booltocolconv"/>

        <Style TargetType="MenuItem" BasedOn="{StaticResource MenuItemStyle}" x:Key="menuitem">
            <Setter Property="BorderBrush" Value="{Binding ViewModel.FluidUI.Design.Border}"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="TextBlock.Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground}"/>
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground}"/>
            <Setter Property="Background" Value="{Binding ViewModel.FluidUI.Design.Background}"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Highlight}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource MenuItemStyle}" x:Key="sub">
            <Setter Property="BorderBrush" Value="{Binding ViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="TextBlock.Foreground" Value="{Binding ViewModel.FluidUIDesign.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="Background" Value="{Binding ViewModel.FluidUI.Design.Background, NotifyOnSourceUpdated=True}"/>
        </Style>

        <Style TargetType="Label" >
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground}"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}" x:Key="MenuButtonStyle">
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground}"/>
            <Setter Property="Background" Value="{Binding ViewModel.FluidUI.Design.Background}"/>
            <Setter Property="BorderBrush" Value="{Binding ViewModel.FluidUI.Design.Border}"/>
        </Style>
    </MenuItem.Resources>

    <fluidUIDataBlock:FluidUIDataBlockSetupView DataContext="{Binding FluidUIDataBlockSetupViewModel}"
                                                Style="{StaticResource menuitem}"
                                                Header="Data"/>

    <fluidUIDesign:FluidUIDesignSetupView DataContext="{Binding FluidUIDesignSetupViewModel}"
                                          Style="{StaticResource menuitem}"
                                          Header="Design"/>

    <fluidUIFont:FluidUIFontSetupView DataContext="{Binding FluidUIFontSetupViewModel}"
                                      Style="{StaticResource menuitem}"
                                      Header="Font"/>

    <fluidUISize:FluidUISizeSetupView DataContext="{Binding FluidUISizeSetupViewModel}"
                                      Style="{StaticResource menuitem}"
                                      Header="Size"/>

    <fluidUIStand:FluidUIStandSetupView DataContext="{Binding FluidUIStandSetupViewModel}"
                                        Style="{StaticResource menuitem}"
                                        Header="Stand"
                                        Visibility="{Binding FluidUIContextHasStand, Converter={StaticResource booltocolconv}}"/>

</MenuItem>

<!-- EOF -->