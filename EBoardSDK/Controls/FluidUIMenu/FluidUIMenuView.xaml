<MenuItem x:Class="EBoardSDK.Controls.FluidUIMenu.FluidUIMenuView"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
          xmlns:local="clr-namespace:EBoardSDK.Controls.FluidUIMenu"
          xmlns:fluidUIDataBlock="clr-namespace:EBoardSDK.Controls.FluidUIDataBlock"
          xmlns:fluidUIDesign="clr-namespace:EBoardSDK.Controls.FluidUIDesign"
          xmlns:fluidUIFont="clr-namespace:EBoardSDK.Controls.FluidUIFont"
          xmlns:fluidUISize="clr-namespace:EBoardSDK.Controls.FluidUISize"
          xmlns:fluidUIStand="clr-namespace:EBoardSDK.Controls.FluidUIStand"
          d:DataContext="{d:DesignInstance Type=local:FluidUIMenuViewModel}"
          Header="FluidUI"
          x:Name="FluidUISetupView"
          mc:Ignorable="d"
          d:DesignHeight="450" d:DesignWidth="800">

    <MenuItem.Resources>

        <Style TargetType="MenuItem" BasedOn="{StaticResource MenuItemStyle}" x:Key="menuitem">
            <Setter Property="BorderBrush" Value="{Binding ViewModel.FluidUI.Design.Border}"/>
            <Setter Property="TextBlock.Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground}"/>
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground}"/>
            <Setter Property="Background" Value="{Binding ViewModel.FluidUI.Design.Background}"/>
            <Setter Property="StaysOpenOnClick" Value="True"/>

            <Style.Triggers>
                <!--<Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Highlight}"/>
                </Trigger>

                <Trigger Property="IsSubmenuOpen" Value="false">
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground}"/>
                </Trigger>-->

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Highlight}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </MenuItem.Resources>

    <fluidUIDataBlock:FluidUIDataBlockSetupMenuItem DataContext="{Binding FluidUIDataBlockSetupViewModel}"
                                                    Style="{StaticResource menuitem}"/>

    <fluidUIDesign:FluidUIDesignSetupMenuItem DataContext="{Binding FluidUIDesignSetupViewModel}"
                                              Style="{StaticResource menuitem}"/>

    <fluidUIFont:FluidUIFontSetupMenuItem DataContext="{Binding FluidUIFontSetupViewModel}"
                                          Style="{StaticResource menuitem}"/>

    <fluidUISize:FluidUISizeSetupMenuItem DataContext="{Binding FluidUISizeSetupViewModel}"
                                          Style="{StaticResource menuitem}"/>

    <fluidUIStand:FluidUIStandSetupMenuItem DataContext="{Binding FluidUIStandSetupViewModel}"
                                            Style="{StaticResource menuitem}"
                                            Visibility="{Binding DataContext.FluidUIContextHasStand, Converter={StaticResource VisibilityToCollapsed}, RelativeSource={RelativeSource AncestorType=local:FluidUIMenuView, Mode=FindAncestor}}"/>
</MenuItem>

