    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition />
        </Grid.RowDefinitions>

        <ComboBox ItemsSource="{Binding Source={StaticResource selectionTargetsEnum}, NotifyOnSourceUpdated=True}"
                  SelectedItem="{Binding SelectionTarget}"
                  Foreground="{Binding ViewModel.FluidUI.Design.Foreground}"
                  Grid.Column="0"
                  Grid.Row="0">

            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Background="Transparent"
                               Text="{Binding}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <ComboBox ItemsSource="{Binding SelectedPlugins, NotifyOnSourceUpdated=True}"
                  SelectedItem="{Binding SelectedPlugin}"
                  Foreground="{Binding ViewModel.FluidUI.Design.Foreground}"
                  Visibility="{Binding IsTitleSelected, Converter={StaticResource InverseVisibilityToCollapsed}}"
                  Grid.Column="1"
                  Grid.Row="0">

            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Background="Transparent"
                               Text="{Binding PluginName}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBox Text="{Binding TitleString, UpdateSourceTrigger=PropertyChanged, Delay=1000}"
                             Visibility="{Binding IsTitleSelected, Converter={StaticResource VisibilityToCollapsed}}"
                             Grid.Column="1"
                             Grid.Row="0"/>
    </Grid>
</UserControl>

