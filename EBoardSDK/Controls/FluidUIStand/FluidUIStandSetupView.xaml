<Grid x:Class="EBoardSDK.Controls.FluidUIStand.FluidUIStandSetupView"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
          xmlns:local="clr-namespace:EBoardSDK.Controls.FluidUIStand"
          xmlns:sm="clr-namespace:EBoardSDK.SharedMethods"
          d:DataContext="{d:DesignInstance Type=local:FluidUIStandSetupViewModel}"
          mc:Ignorable="d" 
          d:DesignHeight="450" d:DesignWidth="800"
          Visibility="{Binding FluidUIContextHasStand, Converter={StaticResource VisibilityToCollapsed}}">

    <Grid.Resources>
        <sm:BooleanToVisibilityCollapsedConverter x:Key="VisibilityToCollapsed"/>

        <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultTextBlock}" >
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBox}">
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding ViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="MinWidth" Value="65"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding ViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DefaultButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="3"                            
                                CornerRadius="5" 
                                MinWidth="50"
                                MinHeight="25"
                                Margin="5"
                                Padding="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Background, NotifyOnSourceUpdated=True}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Width" Value="400" />
            <Setter Property="Margin" Value="10 0"/>

            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground}"/>
        </Style>
    </Grid.Resources>

    <Grid.RowDefinitions>
        <RowDefinition/>
        <RowDefinition/>
    </Grid.RowDefinitions>

    <Button Content="Reset"
                Command="{Binding ResetStandCommand}"
                Grid.Column="1"
                Grid.ColumnSpan="4"
                Grid.Row="0"/>

    <Grid Visibility="{Binding ElementContextArea, Converter={StaticResource VisibilityToCollapsed}}"
          Grid.Row="1">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="A"/>
            <ColumnDefinition Width="Auto" SharedSizeGroup="B"/>
            <ColumnDefinition Width="Auto" SharedSizeGroup="C"/>
            <ColumnDefinition Width="Auto" SharedSizeGroup="D"/>
            <ColumnDefinition Width="*" SharedSizeGroup="E"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
    
    <!-- x position (left eboard screen border distance -->
    <TextBlock Text="X"
                   Grid.Column="0"
                   Grid.Row="1"/>
    <TextBox Text="{Binding XPosition, UpdateSourceTrigger=PropertyChanged, Delay=5}"
                 Grid.Column="1"
                 Grid.Row="1"/>

    <Slider Value="{Binding XPosition, UpdateSourceTrigger=PropertyChanged, Delay=1}"
                Minimum="{Binding XMinimumValue, NotifyOnSourceUpdated=True}"
                Maximum="{Binding XMaximumValue, NotifyOnSourceUpdated=True}"
                Grid.Column="4"
                Grid.Row="1"
                />

    <!-- y position (top eboard screen border distance -->
    <TextBlock Text="Y"
                   Grid.Column="0"
                   Grid.Row="2"/>
    <TextBox Text="{Binding YPosition, UpdateSourceTrigger=PropertyChanged, Delay=5}"
                 Grid.Column="1"
                 Grid.Row="2"/>

    <Slider Value="{Binding YPosition, UpdateSourceTrigger=PropertyChanged, Delay=1}"
                Minimum="{Binding YMinimumValue, NotifyOnSourceUpdated=True}"
                Maximum="{Binding YMaximumValue, NotifyOnSourceUpdated=True}"
                Grid.Column="4"
                Grid.Row="2"
                />

    <!-- z level -->
    <TextBlock Text="Z"
                   Grid.Column="0"
                   Grid.Row="3"/>
    <TextBox Text="{Binding ZIndexValue, UpdateSourceTrigger=PropertyChanged, Delay=5}"
                 Grid.Column="1"
                 Grid.Row="3"/>

    <Slider Value="{Binding ZIndexValue, UpdateSourceTrigger=PropertyChanged, Delay=1}"
                Minimum="{Binding ZMinimumValue, NotifyOnSourceUpdated=True}"
                Maximum="{Binding ZMaximumValue, NotifyOnSourceUpdated=True}"
                Grid.Column="4"
                Grid.Row="3"
                />

    <!-- rotation -->
    <TextBlock Text="° Z"
                   Grid.Column="0"
                   Grid.Row="4"/>
    <TextBox Grid.Column="1"
                 Grid.Row="4"
                 Text="{Binding RotationAngleValue,UpdateSourceTrigger=PropertyChanged, Delay=5}"/>
    <Slider Value="{Binding RotationAngleValue, UpdateSourceTrigger=PropertyChanged, Delay=1}"
                Minimum="-180"
                Maximum="180"
                Grid.Column="4"
                Grid.ColumnSpan="3"
                Grid.Row="4"
                />

    <!-- tranform origin -->
    <TextBlock Text="° x:y"
                   Grid.Column="0"
                   Grid.Row="5"/>
    <TextBox Text="{Binding XTransformOrigin, UpdateSourceTrigger=PropertyChanged, Delay=500, StringFormat=N4}"
                 Grid.Column="1"
                 Grid.Row="5"/>
    <TextBlock Text=":"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   Grid.Column="2"
                   Grid.Row="5"/>
    <TextBox Text="{Binding YTransformOrigin, UpdateSourceTrigger=PropertyChanged, Delay=500, StringFormat=N4}"
                 Grid.Column="3"
                 Grid.Row="5"/>

    <!-- skew transformation X -->
    <TextBlock Text="° X"
                   Grid.Column="0"
                   Grid.Row="6"/>
    <TextBox Grid.Column="1"
                 Grid.Row="6"
                 Text="{Binding SkewAngleX,UpdateSourceTrigger=PropertyChanged, Delay=5, StringFormat=N4}"/>
    <Slider Value="{Binding SkewAngleX, UpdateSourceTrigger=PropertyChanged, Delay=1}"
                Minimum="-180"
                Maximum="180"
                Grid.Column="4"
                Grid.ColumnSpan="3"
                Grid.Row="6"/>

    <!-- skew transformation Y -->
    <TextBlock Text="° Y"
                   Grid.Column="0"
                   Grid.Row="7"/>
    <TextBox Grid.Column="1"
                 Grid.Row="7"
                 Text="{Binding SkewAngleY,UpdateSourceTrigger=PropertyChanged, Delay=5, StringFormat=N4}"/>
    <Slider Value="{Binding SkewAngleY, UpdateSourceTrigger=PropertyChanged, Delay=1}"
                Minimum="-180"
                Maximum="180"
                Grid.Column="4"
                Grid.ColumnSpan="3"
                Grid.Row="7"/>

    <!-- skew center point -->
    <TextBlock Text="° X:Y"
                   Grid.Column="0"
                   Grid.Row="8"/>
    <TextBox Text="{Binding SkewCenterX, UpdateSourceTrigger=PropertyChanged, Delay=500, StringFormat=N4}"
                 Grid.Column="1"
                 Grid.Row="8"/>
    <TextBlock Text=":"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   Grid.Column="2"
                   Grid.Row="8"/>
    <TextBox Text="{Binding SkewCenterY, UpdateSourceTrigger=PropertyChanged, Delay=500, StringFormat=N4}"
                 Grid.Column="3"
                 Grid.Row="8"/>
    </Grid>


    <Grid Visibility="{Binding ScreenContextArea, Converter={StaticResource VisibilityToCollapsed}}"
          Grid.Row="1">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="A"/>
            <ColumnDefinition Width="Auto" SharedSizeGroup="B"/>
            <ColumnDefinition Width="Auto" SharedSizeGroup="C"/>
            <ColumnDefinition Width="Auto" SharedSizeGroup="D"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- x position (left eboard screen border distance -->
        <TextBlock Text="X min"
                   HorizontalAlignment="Center"
                   Grid.Column="0"
                   Grid.Row="0"/>
        <TextBox Text="{Binding XMinimumValue, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                 Grid.Column="1"
                 Grid.Row="0"/>
        
        <TextBlock Text="X max"
                   HorizontalAlignment="Center"
                   Grid.Column="2"
                   Grid.Row="0"/>
        <TextBox Text="{Binding XMaximumValue, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                 Grid.Column="3"
                 Grid.Row="0"/>

        <!-- y position (top eboard screen border distance -->
        <TextBlock Text="Y min"
                   HorizontalAlignment="Center"
                   Grid.Column="0"
                   Grid.Row="1"/>
        <TextBox Text="{Binding YMinimumValue, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                 Grid.Column="1"
                 Grid.Row="1"/>
        <TextBlock Text="Y max"
                   HorizontalAlignment="Center"
                   Grid.Column="2"
                   Grid.Row="1"/>
        <TextBox Text="{Binding YMaximumValue, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                 Grid.Column="3"
                 Grid.Row="1"/>

        <!-- z level -->
        <TextBlock Text="Z min"
                   HorizontalAlignment="Center"
                   Grid.Column="0"
                   Grid.Row="2"/>
        <TextBox Text="{Binding ZMinimumValue, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                 Grid.Column="1"
                 Grid.Row="2"/>
        
        <TextBlock Text="Z max"
                   HorizontalAlignment="Center"
                   Grid.Column="2"
                   Grid.Row="2"/>
        <TextBox Text="{Binding ZMaximumValue, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                 Grid.Column="3"
                 Grid.Row="2"/>
    </Grid>
</Grid>

<!-- EOF -->