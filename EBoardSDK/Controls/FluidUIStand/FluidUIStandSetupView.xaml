<MenuItem x:Class="EBoardSDK.Controls.FluidUIStand.FluidUIStandSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EBoardSDK.Controls.FluidUIStand"
             xmlns:ut="clr-namespace:EBoardSDK.Utilities"
             d:DataContext="{d:DesignInstance Type=local:FluidUIStandSetupViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"          
             >

    <MenuItem.Resources>

        <ut:VisibilityConverterToCollapsed x:Key="VisibilityToCollapsed"/>

        <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultTextBlock}">
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBox}">
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Width" Value="400" />

            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground}"/>
        </Style>
    </MenuItem.Resources>

    <Grid Visibility="{Binding FluidUIContextHasStand, Converter={StaticResource VisibilityToCollapsed}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="A"/>
            <ColumnDefinition Width="Auto" SharedSizeGroup="B"/>
            <ColumnDefinition Width="*" SharedSizeGroup="C"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- x position (left eboard screen border distance -->
        <TextBlock Text="X"
                   Grid.Column="0"
                   Grid.Row="0"/>
        <TextBlock Grid.Column="1"
                   Grid.Row="0">
            <TextBox Text="{Binding XPosition, NotifyOnSourceUpdated=True}"/>
            <Run Text=" / "/>
            <Run Text="{Binding XMaximumValue, NotifyOnSourceUpdated=True}"/>
        </TextBlock>
        <Slider Value="{Binding XSliderValue, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True, UpdateSourceTrigger=PropertyChanged}"
                Minimum="-100"
                Maximum="{Binding XMaximumValue, NotifyOnSourceUpdated=True}"
                Grid.Column="2"
                Grid.Row="0"
                />

        <!-- y position (top eboard screen border distance -->
        <TextBlock Text="Y"
                   Grid.Column="0"
                   Grid.Row="1"/>
        <TextBlock Grid.Column="1"
                   Grid.Row="1">
            <Run Text="{Binding YPosition, NotifyOnSourceUpdated=True}"/>
            <Run Text=" / "/>
            <Run Text="{Binding YMaximumValue, NotifyOnSourceUpdated=True}"/>
        </TextBlock>
        <Slider Value="{Binding YSliderValue, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True, UpdateSourceTrigger=PropertyChanged}"
                Minimum="-100"
                Maximum="{Binding YMaximumValue, UpdateSourceTrigger=PropertyChanged, Delay=20}"
                Grid.Column="2"
                Grid.Row="1"
                />

        <!-- z level -->
        <TextBlock Text="Z"
                   Grid.Column="0"
                   Grid.Row="2"/>
        <TextBlock Grid.Column="1"
                   Grid.Row="2">
            <Run Text="{Binding ZIndexValue, NotifyOnSourceUpdated=True}"/>
            <Run Text=" / "/>
            <Run Text="{Binding ZMaximumValue, NotifyOnSourceUpdated=True}"/>
        </TextBlock>        
        <Slider Value="{Binding ZIndexValue, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True, UpdateSourceTrigger=PropertyChanged}"
                Minimum="{Binding ZMinimumValue, NotifyOnSourceUpdated=True}"
                Maximum="{Binding ZMaximumValue, NotifyOnSourceUpdated=True}"
                Grid.Column="2"
                Grid.Row="2"
                />

        <!-- rotation -->
        <TextBlock Text="°"
                   Grid.Column="0"
                   Grid.Row="3"/>
        <TextBlock Grid.Column="1"
                   Grid.Row="3"
                   Text="{Binding RotationAngleValue, NotifyOnSourceUpdated=True}"/>
        <Slider Value="{Binding RotationAngleValue, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True, UpdateSourceTrigger=PropertyChanged}"
                Minimum="-180"
                Maximum="180"
                Grid.Column="2"
                Grid.Row="3"
                />
    </Grid>
</MenuItem>

<!-- EOF -->