<UserControl x:Class="EBoardSDK.Controls.QuadValueSetup.QuadValueSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EBoardSDK.Controls.QuadValueSetup"
             mc:Ignorable="d"                           
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="QVS">

    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultTextBlock}" >
            <Setter Property="Foreground" Value="{Binding BrushManagement.Foreground, NotifyOnSourceUpdated=True}"/>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBox}">
            <Setter Property="Foreground" Value="{Binding BrushManagement.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding BrushManagement.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="0 0 10 0"/>
        </Style>

        <Style TargetType="Slider" >
            <Setter Property="Maximum" Value="{Binding ElementName=QVS, Path=Maximum}"/>
            <Setter Property="Foreground" Value="{Binding BrushManagement.Foreground, NotifyOnSourceUpdated=True, Mode=OneWay}"/>
            <Setter Property="SmallChange" Value="1"/>
            <Setter Property="LargeChange" Value="5"/>
            <Setter Property="Interval" Value="1"/>
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="MinWidth" Value="350"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Margin" Value="10 0"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding BrushManagement.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding BrushManagement.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderThickness" Value="3"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DefaultButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="3"                            
                                CornerRadius="5" 
                                MinWidth="50"
                                MinHeight="25"
                                Margin="5"
                                Padding="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding BrushManagement.Foreground, NotifyOnSourceUpdated=True}"/>
                    <Setter Property="Foreground" Value="{Binding BrushManagement.Background, NotifyOnSourceUpdated=True}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{Binding BrushManagement.Foreground, NotifyOnSourceUpdated=True}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition SharedSizeGroup="A" Width="Auto"/>
            <ColumnDefinition SharedSizeGroup="B" Width="*"/>
            <ColumnDefinition SharedSizeGroup="C" Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Overview and Control -->
        <Grid Grid.Row="0"
              Grid.Column="0"
              Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Text="Values"
                       Grid.Row="0"/>

            <TextBlock Text="{Binding QuadValueString}" 
                       Grid.Row="1"/>
        </Grid>

        <Button Content="Reset"
                Command="{Binding OkCommand}"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Grid.Row="0"/>

        <!-- Value All -->
        <TextBlock Text="All"
                   Grid.Column="0"
                   Grid.Row="1"/>
        <TextBox Text="{Binding All, UpdateSourceTrigger=PropertyChanged, Delay=50}"
                 Grid.Column="1"
                 Grid.Row="1"/>
        <Slider Value="{Binding All, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True, UpdateSourceTrigger=PropertyChanged}"
                Grid.Column="2"
                Grid.Row="1"/>

        <!-- Value 1 -->
        <TextBlock Text="{Binding ElementName=QVS, Path=Value1}"
                   Grid.Column="0"
                   Grid.Row="2"/>
        <TextBox Text="{Binding TopLeft, UpdateSourceTrigger=PropertyChanged, Delay=50}"
                 Grid.Column="1"
                 Grid.Row="2"/>
        <Slider Value="{Binding TopLeft, NotifyOnSourceUpdated=True, UpdateSourceTrigger=PropertyChanged}"
                Grid.Column="2"
                Grid.Row="2"/>

        <!-- Value 2 -->
        <TextBlock Text="{Binding ElementName=QVS, Path=Value2}"
                   Grid.Column="0"
                   Grid.Row="3"/>
        <TextBox Text="{Binding TopRight, UpdateSourceTrigger=PropertyChanged, Delay=50}"
                 Grid.Column="1"
                 Grid.Row="3"/>
        <Slider Value="{Binding TopRight, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True, UpdateSourceTrigger=PropertyChanged}"
                Grid.Column="2"
                Grid.Row="3"/>

        <!-- Value 3 -->
        <TextBlock Text="{Binding ElementName=QVS, Path=Value3}"
                   Grid.Column="0"
                   Grid.Row="4"/>
        <TextBox Text="{Binding BottomRight, UpdateSourceTrigger=PropertyChanged, Delay=50}"
                 Grid.Column="1"
                 Grid.Row="4"/>
        <Slider Value="{Binding BottomRight, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True, UpdateSourceTrigger=PropertyChanged}"
                Grid.Column="2"
                Grid.Row="4"/>

        <!-- Value 4 -->
        <TextBlock Text="{Binding ElementName=QVS, Path=Value4}"
                   Grid.Column="0"
                   Grid.Row="5"/>
        <TextBox Text="{Binding BottomLeft, UpdateSourceTrigger=PropertyChanged, Delay=50}"
                 Grid.Column="1"
                 Grid.Row="5"/>
        <Slider Value="{Binding BottomLeft, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True, UpdateSourceTrigger=PropertyChanged}"
                Grid.Column="2"
                Grid.Row="5"/>
    </Grid>
</UserControl>

<!-- EOF -->