<UserControl x:Class="EBoardSDK.Controls.ScreenSetup.ScreenSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EBoardSDK.Controls.ScreenSetup"
             xmlns:ebb="clr-namespace:EBoardSDK.Plugins.Eboard.EboardBrowser"
             d:DataContext="{d:DesignInstance Type=local:ScreenSetupViewModel}"
             FontSize="{Binding ViewModel.FluidUI.Font.FontSize, NotifyOnSourceUpdated=True}"
             FontFamily="{Binding ViewModel.FluidUI.Font.FontFamily, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
             FontWeight="{Binding ViewModel.FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}"
             Foreground="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"
             Opacity="{Binding ViewModel.FluidUI.Design.Opacity, NotifyOnSourceUpdated=True}"
             ClipToBounds="True"             
             mc:Ignorable="d" 
             x:Name="ScreenSetupViewName"
             d:DesignHeight="450" d:DesignWidth="800">


    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultTextBlock}" >
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="Margin" Value="10 0 10 0"/>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBox}">
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding ViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding ViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DefaultButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="3"                            
                                CornerRadius="5" 
                                MinWidth="50"
                                MinHeight="25"
                                Margin="5"
                                Padding="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Background, NotifyOnSourceUpdated=True}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ToolTip" BasedOn="{StaticResource DefaultToolTip}">
            <Setter Property="Background" Value="{Binding ViewModel.FluidUI.Design.Background}"/>
            <Setter Property="BorderBrush" Value="{Binding ViewModel.FluidUI.Design.Border}"/>
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground}"/>
            <Setter Property="FontSize" Value="{Binding ViewModel.FluidUI.Font.FontSize}"/>
            <Setter Property="FontFamily" Value="{Binding ViewModel.FluidUI.Font.FontFamily, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"/>
            <Setter Property="FontWeight" Value="{Binding ViewModel.FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}"/>
        </Style>
    </UserControl.Resources>


    <Border Background="{Binding ViewModel.FluidUI.Design.Background}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto" SharedSizeGroup="A"/>
                    <ColumnDefinition Width="2*" SharedSizeGroup="B"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <Button Content="Add"
                        Command="{Binding AddEboardCommand}"
                        Grid.Column="0"
                        Grid.ColumnSpan="4"
                        Grid.Row="0"/>

                <Button Content="Deselect"
                        Margin="0 0 5 0"
                        Command="{Binding DeselectEboardCommand}"
                        Grid.Column="0"
                        Grid.Row="1"
                        Grid.RowSpan="5"/>

                <Button Content="Edit"
                        Margin="5 0 0 0"
                        Command="{Binding EditEboardParametersCommand}"
                        Grid.Column="3"
                        Grid.Row="1"
                        Grid.RowSpan="5"/>

                <Button Content="Delete"
                        Command="{Binding DeleteSelectedScreensCommand}"
                        Grid.Column="0"
                        Grid.ColumnSpan="4"
                        Grid.Row="6"/>

                <TextBlock Text="Name"
                       Grid.Column="1"
                       Grid.Row="1"/>

                <TextBlock Text="Depth"
                       Grid.Column="1"
                       Grid.Row="2"/>

                <TextBlock Text="Width"
                       Grid.Column="1"
                       Grid.Row="3"/>

                <TextBlock Text="Height"
                       Grid.Column="1"
                       Grid.Row="4"/>
                
                <TextBlock Text="Opacity"
                Grid.Column="1"
                Grid.Row="5"/>
                
                <TextBox Text="{Binding EboardName}"
                             Grid.Column="2"
                             Grid.Row="1"/>

                <TextBox Text="{Binding EboardDepth}"
                             Grid.Column="2"
                             Grid.Row="2"/>

                <TextBox Text="{Binding EboardWidth}"
                             Grid.Column="2"
                             Grid.Row="3"/>

                <TextBox Text="{Binding EboardHeight}"
                             Grid.Column="2"
                             Grid.Row="4"/>

                <TextBox Text="{Binding EboardOpacity}"
                             Grid.Column="2"
                             Grid.Row="5"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="A"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <Grid.ToolTip>
                    <ToolTip>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="A"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="B"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Screen stats"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="2"
                                       Grid.Row="0"/>

                            <TextBlock Text="Created"
                                       Grid.Column="0"
                                       Grid.Row="1"/>
                            <TextBlock Text="{Binding EboardCreatedDate, NotifyOnSourceUpdated=True}"
                                       Grid.Column="1"
                                       Grid.Row="1"/>

                            <TextBlock Text="Total Count"
                                       Grid.Column="0"
                                       Grid.Row="2"/>
                            <TextBlock Text="{Binding TotalPluginCount, NotifyOnSourceUpdated=True}"
                                       Grid.Column="1"
                                       Grid.Row="2"/>

                            <TextBlock Text="Addons"
                                       Grid.Column="0"
                                       Grid.Row="3"/>
                            <TextBlock Text="{Binding AddonCount, NotifyOnSourceUpdated=True}"
                                       Grid.Column="1"
                                       Grid.Row="3"/>

                            <TextBlock Text="Elements"
                                       Grid.Column="0"
                                       Grid.Row="4"/>
                            <TextBlock Text="{Binding ElementCount, NotifyOnSourceUpdated=True}"
                                       Grid.Column="1"
                                       Grid.Row="4"/>

                            <TextBlock Text="Shapes"
                                       Grid.Column="0"
                                       Grid.Row="5"/>
                            <TextBlock Text="{Binding ShapeCount, NotifyOnSourceUpdated=True}"
                                       Grid.Column="1"
                                       Grid.Row="5"/>

                            <TextBlock Text="Areas"
                                 Grid.Column="0"
                                 Grid.Row="6"/>
                            <TextBlock Text="{Binding AreaCount, NotifyOnSourceUpdated=True}"
                                 Grid.Column="1"
                                 Grid.Row="6"/>

                            <TextBlock Text="Tools"
                                 Grid.Column="0"
                                 Grid.Row="7"/>
                            <TextBlock Text="{Binding ToolCount, NotifyOnSourceUpdated=True}"
                                 Grid.Column="1"
                                 Grid.Row="7"/>
                        </Grid>
                    </ToolTip>
                </Grid.ToolTip>

                <TextBlock VerticalAlignment="Center"
                               Grid.Column="0"
                               Grid.Row="0">
                            <Run Text="Selected"/>
                </TextBlock>
                <TextBlock VerticalAlignment="Center"
                           Grid.Column="1"
                           Grid.Row="0">
                            <Run Text="{Binding ViewModel.EboardBrowserViewModel.CurrentSelectionID, NotifyOnSourceUpdated=True}"/>
                            <Run Text="/"/>
                            <Run Text="{Binding ViewModel.EboardCount, Mode=OneWay, NotifyOnSourceUpdated=True}"/>
                </TextBlock>

                <TextBlock Text="Title"
                           Grid.Column="0"
                           Grid.Row="1"/>
                <TextBlock Text="{Binding EBoardViewModel.FluidUI.DataBlock.Title}"
                           Grid.Column="1"
                           Grid.Row="1"/>

                <TextBlock Text="Text"
                           Grid.Column="0"
                           Grid.Row="2"/>
                <TextBlock Text="{Binding EBoardViewModel.FluidUI.DataBlock.Text}"
                           TextAlignment="Left"
                           HorizontalAlignment="Left"
                           TextWrapping="WrapWithOverflow"
                           MaxWidth="400"
                           Grid.Column="1"
                           Grid.Row="2"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>

