<UserControl x:Class="EBoardSDK.Plugins.Areas.TwoXThreeVImageArea.TwoXThreeImageAreaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EBoardSDK.Plugins.Areas.TwoXThreeVImageArea"
             xmlns:controls="clr-namespace:EBoardSDK.Controls.Area"            
             xmlns:image="clr-namespace:EBoardSDK.Plugins.Elements.Image"    
             d:DataContext="{d:DesignInstance Type=local:TwoXThreeImageAreaViewModel}"   
              mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <UniformGrid Columns="2" Rows="3">
            <image:ImageView DataContext="{Binding ImageViewModel1}"/>
            <image:ImageView DataContext="{Binding ImageViewModel2}"/>
            <image:ImageView DataContext="{Binding ImageViewModel3}"/>
            <image:ImageView DataContext="{Binding ImageViewModel4}"/>
            <image:ImageView DataContext="{Binding ImageViewModel5}"/>
            <image:ImageView DataContext="{Binding ImageViewModel6}"/>
        </UniformGrid>
        
        <!--<controls:AreaView DataContext="{Binding AreaViewModel}"
                           HorizontalContentAlignment="Stretch"
                           HorizontalAlignment="Stretch"/>-->
    </Border>
</UserControl>
