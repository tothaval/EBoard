<UserControl x:Class="EBoardSDK.Plugins.Eboard.Coordinates.CoordinatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EBoardSDK.Plugins.Eboard.Coordinates"
             d:DataContext="{d:DesignInstance Type=local:CoordinatesViewModel}"
             FontSize="{Binding ElementViewModel.FluidUI.Font.FontSize, NotifyOnSourceUpdated=True}"
             FontFamily="{Binding ElementViewModel.FluidUI.Font.FontFamily, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
             FontWeight="{Binding ElementViewModel.FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultTextBlock}" >
            <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Padding" Value="20 0 10 0"/>
            <Setter Property="Margin" Value="0 0 13 0"/>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBox}">
            <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding ElementViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="CaretBrush" Value="{Binding ElementViewModel.FluidUI.Design.Foreground}"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Padding" Value="20 0 10 0"/>
            <Setter Property="Margin" Value="0 0 10 0"/>
        </Style>

        <Style TargetType="MenuItem" BasedOn="{StaticResource MenuItemStyle}" x:Key="menuitem">
            <Setter Property="BorderBrush" Value="{Binding ElementViewModel.FluidUI.Design.Border}"/>
            <Setter Property="TextBlock.Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground}"/>
            <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground}"/>
            <Setter Property="Background" Value="{Binding ElementViewModel.FluidUI.Design.Background}"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Highlight}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <!--<Grid.ContextMenu>
            <ContextMenu Style="{StaticResource ContextMenuStyle}"
                         BorderBrush="{Binding ElementViewModel.FluidUI.Design.Border}"
                         BorderThickness="3">
                <MenuItem Header="Axis Length"
                          Style="{StaticResource menuitem}">
                    <TextBox Text="{Binding AxisLength, UpdateSourceTrigger=Default}"/>
                </MenuItem>                          
            </ContextMenu>
        </Grid.ContextMenu>-->

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Column="0"
                Height="1"
                Width="1"
                x:Name="CoordinateMarkerCenterPoint"
                Background="Transparent"/>

        <Line X1="{Binding AxisLengthHalf}"
              X2="{Binding AxisLengthHalf}"
              Y1="{Binding AxisLength}"
              Y2="0"
              StrokeThickness="1"              
              Stroke="{Binding ElementViewModel.FluidUI.Design.Foreground}"
              Grid.Column="0"/>

        <Line X1="{Binding AxisLength}"
              X2="0"
              Y1="{Binding AxisLengthHalf}"
              Y2="{Binding AxisLengthHalf}"
              StrokeThickness="1"
              Stroke="{Binding ElementViewModel.FluidUI.Design.Foreground}"
              Grid.Column="0"/>

        
        
        <Grid Grid.Column="1"
              VerticalAlignment="Center"
              Margin="10 0 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" SharedSizeGroup="A"/>
                <ColumnDefinition Width="auto" SharedSizeGroup="B"/>
                <ColumnDefinition Width="auto" SharedSizeGroup="C"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Screen"
                       Grid.Column="0"
                       Grid.Row="0"/>

            <TextBox Text="{Binding XCoord, UpdateSourceTrigger=Default, Delay=5}"
                     Grid.Column="1"
                     Grid.Row="0"/>
            <TextBox Text="{Binding YCoord, UpdateSourceTrigger=Default, Delay=5}"
                     Grid.Column="2"
                     Grid.Row="0"/>

            <TextBlock Text="Mouse"
                       Grid.Column="0"
                       Grid.Row="1"/>

            <TextBlock Text="{Binding Xmouse, NotifyOnSourceUpdated=True}"
                       Grid.Column="1"
                       Grid.Row="1"/>
            <TextBlock Text="{Binding Ymouse, NotifyOnSourceUpdated=True}"
                       Grid.Column="2"
                       Grid.Row="1"/>
        </Grid>

        <TextBlock Text="{Binding CoordinatesWrongMessage}"
                   Foreground="{Binding ElementViewModel.FluidUI.Design.Highlight}"
                   Visibility="{Binding IsRotated, Converter={StaticResource VisibilityToCollapsed}}"
                   Grid.Column="1"
                   Grid.Row="1"/>
    </Grid>
</UserControl>

<!-- EOF -->