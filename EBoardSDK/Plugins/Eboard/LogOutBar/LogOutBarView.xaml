<UserControl x:Class="EBoardSDK.Plugins.Eboard.LogOutBar.LogOutBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EBoardSDK.Plugins.Eboard.LogOutBar"
             xmlns:sm="clr-namespace:EBoardSDK.SharedMethods"
             xmlns:About="clr-namespace:EBoardSDK.Plugins.Eboard.About"             
             xmlns:Manual="clr-namespace:EBoardSDK.Plugins.Eboard.Manual"
             d:DataContext="{d:DesignInstance Type=local:LogOutBarViewModel}"
             FontSize="{Binding MainViewModel.FluidUI.Font.FontSize, NotifyOnSourceUpdated=True}"
             FontFamily="{Binding MainViewModel.FluidUI.Font.FontFamily, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
             FontWeight="{Binding MainViewModel.FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <sm:BooleanToVisibilityCollapsedConverter x:Key="VisibilityToCollapsed"/>

        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Foreground" Value="{Binding MainViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding MainViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="Visibility" Value="{Binding ExitOnly, Converter={StaticResource InverseVisibilityToCollapsed}}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DefaultButtonBorder"
                   Background="{TemplateBinding Background}"
                   BorderBrush="{TemplateBinding BorderBrush}"
                   BorderThickness="3"                            
                   CornerRadius="5" 
                   MinWidth="50"
                   MinHeight="25"
                   Margin="5"
                   Padding="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding MainViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                    <Setter Property="Foreground" Value="{Binding MainViewModel.FluidUI.Design.Background, NotifyOnSourceUpdated=True}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{Binding MainViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Border Background="{Binding MainViewModel.FluidUI.Design.Background}"
                Grid.Column="0"
                Grid.ColumnSpan="4"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Visibility="{Binding InstantiatedAsElement, Converter={StaticResource VisibilityToCollapsed}}"/>

        <Button Content="{Binding TxtManual}"
                Command="{Binding InvokeOrShowManualCommand}"
                Grid.Column="0">
            <Button.ToolTip>
                <ToolTip Visibility="{Binding ScreenExists, Converter={StaticResource InverseVisibilityToCollapsed}}"
                         StaysOpen="True">
                </ToolTip>
            </Button.ToolTip>
        </Button>

        <Button Content="{Binding TxtAbout}"
                Command="{Binding InvokeOrShowAboutCommand}"
                Grid.Column="1">
            <Button.ToolTip>
                <ToolTip 
                         StaysOpen="True">
                </ToolTip>
            </Button.ToolTip>
        </Button>

        <Button Content="{Binding TxtShutDownMachine}"
                Command="{Binding ShutDownCommand}"
                Visibility="Visible"
                Grid.Column="2"
                HorizontalAlignment="Stretch"/>

        <Button Content="{Binding TxtExitEboard}"
                Command="{Binding CloseCommand}"
                Visibility="Visible"                 
                Grid.Column="3"/>

        <Border Visibility="{Binding ManualClicked, Converter={StaticResource VisibilityToCollapsed}}"
                Grid.Column="0"
                Grid.ColumnSpan="4"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Grid.Row="1">
            <Manual:ManualView DataContext="{Binding ManualViewModel}"/>
        </Border>

        <Border Visibility="{Binding AboutClicked, Converter={StaticResource VisibilityToCollapsed}}"
                Grid.Column="0"
                Grid.ColumnSpan="4"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Grid.Row="1">
            <About:AboutView DataContext="{Binding AboutViewModel}"/>
        </Border>
    </Grid>
</UserControl>

<!-- EOF -->