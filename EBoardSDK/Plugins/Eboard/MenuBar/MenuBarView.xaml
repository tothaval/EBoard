<UserControl x:Class="EBoardSDK.Plugins.Eboard.MenuBar.MenuBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:winds="clr-namespace:EBoardSDK.Windows"
             xmlns:local="clr-namespace:EBoardSDK.Plugins.Eboard.MenuBar"
             xmlns:vms="clr-namespace:EBoardSDK.ViewModels"
             xmlns:views="clr-namespace:EBoardSDK.Views"
             d:DataContext="{d:DesignInstance Type=local:MenuBarViewModel}"
             FontSize="{Binding MainViewModel.FluidUI.Font.FontSize, NotifyOnSourceUpdated=True}"
             FontFamily="{Binding MainViewModel.FluidUI.Font.FontFamily,NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
             FontWeight="{Binding MainViewModel.FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="mainwindowmenubarname">

    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultTextBlock}" >
            <Setter Property="Foreground" Value="{Binding MainViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBox}">
            <Setter Property="Foreground" Value="{Binding MainViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding MainViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Foreground" Value="{Binding MainViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding MainViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DefaultButtonBorder"
                   Background="{TemplateBinding Background}"
                   BorderBrush="{TemplateBinding BorderBrush}"
                   BorderThickness="3"                            
                   CornerRadius="5" 
                   MinWidth="50"
                   MinHeight="25"
                   Margin="5"
                   Padding="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding MainViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                    <Setter Property="Foreground" Value="{Binding MainViewModel.FluidUI.Design.Background, NotifyOnSourceUpdated=True}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{Binding MainViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="Foreground" Value="{Binding MainViewModel.FluidUI.Design.Foreground}"/>
            <Setter Property="BorderBrush" Value="{Binding MainViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="Visibility" Value="{Binding InvokeOnly, Converter={StaticResource InverseVisibilityToCollapsed}}"/>
            <Setter Property="Opacity" Value="{Binding MainViewModel.FluidUI.Design.Opacity}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="DefaultButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="3"                            
                                CornerRadius="5" 
                                MinWidth="50"
                                MinHeight="25"
                                Margin="5"
                                Padding="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background"
                                    TargetName="DefaultButtonBorder"
                                    Value="{Binding MainViewModel.FluidUI.Design.Highlight}"/>
                                <!--<Setter Property="Foreground"
                                        Value="{Binding MainViewModel.FluidUI.Design.Highlight}"/>-->
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding MainViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                    <Setter Property="Foreground" Value="{Binding MainViewModel.FluidUI.Design.Background, NotifyOnSourceUpdated=True}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{Binding MainViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="MenuItem" BasedOn="{StaticResource MenuItemStyle}" x:Key="menuitem">
            <Setter Property="BorderBrush" Value="{Binding ScreenBrushManagement.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="TextBlock.Foreground" Value="{Binding ScreenBrushManagement.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="Foreground" Value="{Binding ScreenBrushManagement.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="Background" Value="{Binding ScreenBrushManagement.Background, NotifyOnSourceUpdated=True}"/>
            <Setter Property="FontSize" Value="{Binding ScreenFontManagement.FontSize, NotifyOnSourceUpdated=True}" />
            <Setter Property="FontFamily" Value="{Binding ScreenFontManagement.FontFamily, NotifyOnTargetUpdated=True, NotifyOnSourceUpdated=True}" />
            <Setter Property="FontWeight" Value="{Binding ScreenFontManagement.FontWeight, NotifyOnTargetUpdated=True, NotifyOnSourceUpdated=True}" />
            <Setter Property="StaysOpenOnClick" Value="False"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Grid SnapsToDevicePixels="true">
                            <DockPanel x:Name="dp" >
                                <ContentPresenter x:Name="Icon"
                                              ContentSource="Icon"
                                              Margin="0" 
                                              VerticalAlignment="Center"/>
                                <Path x:Name="GlyphPanel"
                                      FlowDirection="LeftToRight"
                                      Margin="0"
                                      Visibility="Collapsed"
                                      VerticalAlignment="Center"/>
                                <ContentPresenter x:Name="content"
                                                  ContentSource="Header"
                                                  Margin="10 5" 
                                                  RecognizesAccessKey="True"/>
                            </DockPanel>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="true"
                                   Focusable="false"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   PopupAnimation="{DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}"
                                   Placement="Right" VerticalOffset="0" HorizontalOffset="-10">

                                <Border 
                                Background="{TemplateBinding Background}"
                                   Opacity="{Binding DataContext.MenuBar.ScreenBrushManagement.Opacity, RelativeSource={RelativeSource AncestorType=winds:MainWindow, Mode=FindAncestor}}"
                                    CornerRadius="5"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                        BorderBrush="{TemplateBinding BorderBrush}">
                                    <ScrollViewer x:Name="SubMenuScrollViewer"
                                                  CanContentScroll="true"
                                                  Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly={x:Type FrameworkElement}}}">
                                        <Grid RenderOptions.ClearTypeHint="Enabled">
                                            <ItemsPresenter x:Name="ItemsPresenter"
                                                            KeyboardNavigation.DirectionalNavigation="Cycle"
                                                            Grid.IsSharedSizeScope="true"
                                                            Margin="5, 2, 5, 2"                                                        
                                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                            KeyboardNavigation.TabNavigation="Cycle"/>
                                        </Grid>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <!--<ControlTemplate.Triggers>

                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="TextBlock.Foreground" Value="{DynamicResource SelectedEboardBrowserBrushHighlight}"/>
                        </Trigger>

                        <Trigger Property="IsHighlighted" Value="False">
                            <Setter Property="TextBlock.Foreground" Value="{DynamicResource SelectedEboardBrowserBrushForeground}"/>
                        </Trigger>

                    </ControlTemplate.Triggers>-->
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter Property="Foreground" Value="{Binding ScreenBrushManagement.Highlight}"/>
                </Trigger>

                <Trigger Property="IsSubmenuOpen" Value="false">
                    <Setter Property="Foreground" Value="{Binding ScreenBrushManagement.Foreground}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{Binding ScreenBrushManagement.Highlight}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Foreground" Value="{Binding ScreenBrushManagement.Foreground}"/>
                </Trigger>
            </Style.Triggers>

        </Style>

        <Style TargetType="MenuItem" x:Key="PluginLogoMenuItem">
            <Setter Property="Command" Value="{Binding DataContext.InvokePluginCommand, RelativeSource={RelativeSource AncestorType=Menu}}"/>
            <Setter Property="CommandParameter" Value="{Binding}" />

            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{Binding ScreenBrushManagement.Foreground, NotifyOnSourceUpdated=True, RelativeSource={RelativeSource AncestorType=Menu, Mode=FindAncestor}}"/>
            <Setter Property="FontSize" Value="{Binding ScreenFontManagement.FontSize, NotifyOnSourceUpdated=True}" />
            <Setter Property="FontFamily" Value="{Binding ScreenFontManagement.FontFamily, NotifyOnTargetUpdated=True, NotifyOnSourceUpdated=True}" />
            <Setter Property="FontWeight" Value="{Binding ScreenFontManagement.FontWeight, NotifyOnTargetUpdated=True, NotifyOnSourceUpdated=True}" />

            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid Background="Transparent"
                              Opacity="{Binding DataContext.MenuBar.ScreenBrushManagement.Opacity, RelativeSource={RelativeSource AncestorType=winds:MainWindow, Mode=FindAncestor}}"
                              VerticalAlignment="Center"
                              Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Fill="{Binding PluginLogo}"
                                       MinWidth="25"
                                       MinHeight="25"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding PluginName}"
                                       Foreground="{Binding DataContext.MenuBar.ScreenBrushManagement.Foreground, RelativeSource={RelativeSource AncestorType=winds:MainWindow, Mode=FindAncestor}}"
                                       FontSize="{Binding DataContext.MenuBar.ScreenFontManagement.FontSize, RelativeSource={RelativeSource AncestorType=winds:MainWindow, Mode=FindAncestor}}"
                                       FontFamily="{Binding DataContext.MenuBar.ScreenFontManagement.FontFamily, RelativeSource={RelativeSource AncestorType=winds:MainWindow, Mode=FindAncestor}}"
                                       FontWeight="{Binding DataContext.MenuBar.ScreenFontManagement.FontWeight, RelativeSource={RelativeSource AncestorType=winds:MainWindow, Mode=FindAncestor}}"                                       
                                       VerticalAlignment="Center"
                                       Grid.Column="1">
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{Binding ScreenBrushManagement.Highlight, NotifyOnSourceUpdated=True}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Foreground" Value="{Binding ScreenBrushManagement.Foreground, NotifyOnSourceUpdated=True}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Left">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Background="{Binding MainViewModel.FluidUI.Design.Background}"
                Grid.Column="0"
                Grid.ColumnSpan="4"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Visibility="{Binding InstantiatedAsElement, Converter={StaticResource VisibilityToCollapsed}}"/>

        <ToggleButton Content="Eboard Browser"
                      FontSize="{Binding MainViewModel.FluidUI.Font.FontSize, NotifyOnSourceUpdated=True}"
                      IsChecked="{Binding EBoardBrowserSwitch,
                NotifyOnSourceUpdated=True,
                UpdateSourceTrigger=PropertyChanged}"
                      Grid.Column="0"/>
        
        <Border Visibility="{Binding InvokeOnly, Converter={StaticResource InverseVisibilityToCollapsed}}"
                Grid.Column="1">           
        
        <ToggleButton Content="Screen Control"
                      FontSize="{Binding MainViewModel.FluidUI.Font.FontSize, NotifyOnSourceUpdated=True}"    
                      IsChecked="{Binding ScreenControlSwitch,
                NotifyOnSourceUpdated=True,
                UpdateSourceTrigger=PropertyChanged}"
                      Visibility="{Binding IsActiveScreenNotNull, Converter={StaticResource VisibilityToCollapsed}}"/>
        </Border>
        
        <Border Background="{Binding ScreenBrushManagement.Background}"
                BorderBrush="{Binding ScreenBrushManagement.Border}"
                Visibility="{Binding IsActiveScreenNotNull, Converter={StaticResource VisibilityToCollapsed}}"
                Opacity="{Binding ScreenBrushManagement.Opacity}"
                BorderThickness="3"
                CornerRadius="5"
                Grid.Column="2">
            <Menu Foreground="{Binding ScreenBrushManagement.Foreground}"
                  Opacity="{Binding ScreenBrushManagement.Opacity, RelativeSource={RelativeSource AncestorType=winds:MainWindow, Mode=FindAncestor}}"
                  Background="{Binding ScreenBrushManagement.Background}">
                <MenuItem Header="Addons"
                          Style="{StaticResource menuitem}"
                          ItemsSource="{Binding FoundAddons}"
                          ItemContainerStyle="{StaticResource PluginLogoMenuItem}"/>
                <MenuItem Header="Elements"
                          Style="{StaticResource menuitem}"
                          ItemsSource="{Binding FoundElements}"
                          ItemContainerStyle="{StaticResource PluginLogoMenuItem}"/>
                <MenuItem Header="Shapes"
                          Style="{StaticResource menuitem}"
                          ItemsSource="{Binding FoundShapes}"
                          ItemContainerStyle="{StaticResource PluginLogoMenuItem}"/>
                <MenuItem Header="Areas"
                          Style="{StaticResource menuitem}"
                          ItemsSource="{Binding FoundAreas}"
                          ItemContainerStyle="{StaticResource PluginLogoMenuItem}"/>
                <MenuItem Header="Tools"
                          Style="{StaticResource menuitem}"
                          ItemsSource="{Binding FoundTools, NotifyOnSourceUpdated=True}"
                          ItemContainerStyle="{StaticResource PluginLogoMenuItem}"/>
                <MenuItem Header="System"
                          Style="{StaticResource menuitem}"
                          ItemsSource="{Binding FoundSystem, NotifyOnSourceUpdated=True}"
                          ItemContainerStyle="{StaticResource PluginLogoMenuItem}"/>
                <MenuItem Header="Eboard"
                          Style="{StaticResource menuitem}"
                          ItemsSource="{Binding FoundEboard, NotifyOnSourceUpdated=True}"
                          ItemContainerStyle="{StaticResource PluginLogoMenuItem}"/>
            </Menu>
        </Border>
    </Grid>
</UserControl>

<!-- EOF -->