<UserControl x:Class="EBoardSDK.Plugins.Eboard.PluginManager.PluginManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EBoardSDK.Plugins.Eboard.PluginManager"
             xmlns:fuim="clr-namespace:EBoardSDK.Controls.FluidUIMenu"
             d:DataContext="{d:DesignInstance Type=local:PluginManagerViewModel}"
             FontSize="{Binding ElementViewModel.FluidUI.Font.FontSize, NotifyOnSourceUpdated=True}"
             FontFamily="{Binding ElementViewModel.FluidUI.Font.FontFamily, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
             FontWeight="{Binding ElementViewModel.FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultTextBlock}" >
            <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBox}">
            <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding ElementViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding ElementViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DefaultButtonBorder"
                   Background="{TemplateBinding Background}"
                   BorderBrush="{TemplateBinding BorderBrush}"
                   BorderThickness="3"                            
                   CornerRadius="5" 
                   MinWidth="50"
                   MinHeight="25"
                   Margin="5"
                   Padding="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                    <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Background, NotifyOnSourceUpdated=True}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Header}"
                   Grid.Column="0"
                   Grid.Row="0"/>

        <Button Content="show plugins"
                Command="{Binding ShowInstalledPluginsCommand}"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Grid.Row="1"/>

        <TextBlock Text="{Binding PluginFolder}"
                   ToolTip="plugin folder"
                   TextAlignment="Left"
                   HorizontalAlignment="Left"
                   Grid.Column="3"
                   Grid.Row="1"/>

        <Button Content="select folder"
                Command="{Binding SelectFolderCommand}"
                Grid.Column="0"
                Grid.Row="2"/>

        <fuim:PluginSelectionView DataContext="{Binding PluginSelectionViewModel, NotifyOnSourceUpdated=True}"
                                  Grid.Column="1"
                                  Grid.Row="2"/>
        
        <!--<Button Content="install plugin"
                Command="{Binding InstallPluginCommand}"
                Grid.Column="2"
                Grid.Row="2"/>

        <Button Content="Uninstall plugin"
                Command="{Binding UninstallPluginCommand}"
                Grid.Column="3"
                Grid.Row="2"/>-->


        <TextBlock Text="selected folder:"
                   ToolTip="plugin folder"
                   TextAlignment="Left"
                   HorizontalAlignment="Left"
                   Margin="10 0 0 0"
                   Grid.Column="0"
                   Grid.Row="3"/>

        <TextBlock Text="{Binding SelectedFolder}"
                   ToolTip="{Binding SelectedFolder}"
                   TextAlignment="Left"
                   HorizontalAlignment="Left"
                   Margin="10 0 0 0"
                   Grid.Column="1"
                   Grid.ColumnSpan="3"
                   Grid.Row="3"/>

        <TextBlock Text="selected plugin:"
                  ToolTip="plugin folder"
                  TextAlignment="Left"
                  HorizontalAlignment="Left"
                  Margin="10 0 0 0"
                  Grid.Column="0"
                  Grid.Row="4"/>

        <TextBlock Text="{Binding SelectedPluginFile.PluginName}"
                   ToolTip="selected plugin"
                   TextAlignment="Left"
                   HorizontalAlignment="Left"
                   Margin="10 0 0 0"
                   Grid.Column="1"
                   Grid.ColumnSpan="3"
                   Grid.Row="4"/>
        
        <TextBlock Grid.Column="0"
                   Grid.ColumnSpan="4"
                   Grid.Row="5"
                   Margin="10 0 0 0">
            
            <Run Text="Logo  |  "/>
            <Run Text="Name  |  "/>
            <Run Text="Category  |  "/>
            <Run Text="Policies  |  "/>
            <Run Text="nr of plugins in selected folder: "/>
            <Run Text="{Binding PluginCount, Mode=OneWay}"/>
        </TextBlock>

        <ListBox ItemsSource="{Binding PluginsInSelectedFolder}"
                 SelectedItem="{Binding SelectedPluginFile}"
                 Grid.Column="0"
                 Grid.ColumnSpan="4"
                 Grid.Row="6">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Fill="{Binding PluginLogo}"
                                   Grid.Column="0"
                                   Width="50"
                                   Height="50"/>
                        <TextBlock Text="{Binding PluginName}"
                                   VerticalAlignment="Center"
                                   Width="150"
                                   Margin="10 0 0 0"
                   Foreground="Red"
                                   Grid.Column="1"/>
                        <TextBlock Text="{Binding PluginCategory}"
                                   VerticalAlignment="Center"
                                   Width="100"
                                   Margin="10 0 0 0"
                   Foreground="Red"
                                   Grid.Column="2"/>
                        <TextBlock Text="{Binding ElementScreenIntegrationConstraints.InstantiationPolicy}"
                                   VerticalAlignment="Center"
                                   Width="100"
                                   Margin="10 0 0 0"
                   Foreground="Red"
                                   Grid.Column="3"/>
                        <TextBlock Text="{Binding ElementScreenIntegrationConstraints.AcceptedScreenTypes}"
                                   VerticalAlignment="Center"
                                   Width="100"
                                   Margin="10 0 0 0"
                                   Background="Gray"
                   Foreground="Red"
                                   Grid.Column="4"/>
                        <TextBlock Text="{Binding ElementScreenIntegrationConstraints.AcceptedScreenIdentities}"
                                   VerticalAlignment="Center"
                                   Width="100"
                                   Margin="10 0"
                                   Background="LightGreen"
                   Foreground="Red"
                                   Grid.Column="5"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>

