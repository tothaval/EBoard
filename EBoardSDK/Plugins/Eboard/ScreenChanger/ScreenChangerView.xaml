<UserControl x:Class="EBoardSDK.Plugins.Eboard.ScreenChanger.ScreenChangerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EBoardSDK.Plugins.Eboard.ScreenChanger"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             
             Background="Transparent">

    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultTextBlock}" >
            <Setter Property="Foreground" Value="{Binding MainViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBox}">
            <Setter Property="Foreground" Value="{Binding MainViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding MainViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="0 0 10 0"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding MainViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding MainViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderThickness" Value="3"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DefaultButtonBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="3"                            
                    CornerRadius="5" 
                    MinWidth="50"
                    MinHeight="25"
                    Margin="5"
                    Padding="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding MainViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                    <Setter Property="Foreground" Value="{Binding MainViewModel.FluidUI.Design.Background, NotifyOnSourceUpdated=True}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{Binding MainViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ToolTip" BasedOn="{StaticResource DefaultToolTip}">
            <Setter Property="Background" Value="{Binding MainViewModel.FluidUI.Design.Background}"/>
            <Setter Property="BorderBrush" Value="{Binding MainViewModel.FluidUI.Design.Border}"/>
            <Setter Property="Foreground" Value="{Binding MainViewModel.FluidUI.Design.Foreground}"/>
            <Setter Property="FontSize" Value="{Binding MainViewModel.FluidUI.Font.FontSize}"/>
            <Setter Property="FontFamily" Value="{Binding MainViewModel.FluidUI.Font.FontFamily, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"/>
            <Setter Property="FontWeight" Value="{Binding MainViewModel.FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        
        <Grid.ToolTip>
            <ToolTip Background="Transparent"
                          BorderBrush="Transparent"
                           FontSize="{Binding MainViewModel.FluidUI.Font.FontSize}"
                          BorderThickness="0">
                <Border Background="{Binding MainViewModel.FluidUI.Design.Background}"
                          BorderBrush="{Binding MainViewModel.FluidUI.Design.Border}"
                          BorderThickness="3"
                          CornerRadius="3">
                    <TextBlock Margin="3">
                              <Run Text="Eboard: "/>   
                              <Run Text="{Binding MainViewModel.NavigationContextViewModel.EboardBrowserViewModel.SelectedEboard.FluidUI.DataBlock.Title}"/>
                              <LineBreak/>
                              <Run Text="{Binding MainViewModel.NavigationContextViewModel.EboardBrowserViewModel.CurrentSelectionID}"/>
                              <Run Text="/"/>
                              <Run Text="{Binding MainViewModel.NavigationContextViewModel.EboardCount, Mode=OneWay, NotifyOnSourceUpdated=True}"/>
                    </TextBlock>
                </Border>
            </ToolTip>
        </Grid.ToolTip>

        <Border Visibility="{Binding InstantiatedAsElement, Converter={StaticResource VisibilityToCollapsed}}"
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="4">
            <TextBlock FontWeight="Bold"
                       Text="{Binding Name}"
                       Foreground="{Binding ElementViewModel.FluidUI.Design.Foreground}"
                       Visibility="{Binding ElementViewModel.HideControl3, Converter={StaticResource InverseVisibilityToCollapsed}}"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Left"/>
        </Border>
        
        <Border Background="{Binding MainViewModel.FluidUI.Design.Background}"
                Grid.Column="0"
                Grid.ColumnSpan="5"
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Visibility="{Binding InstantiatedAsElement, Converter={StaticResource VisibilityToCollapsed}}"/>

        <Button Content="|&lt;&lt;"
                Command="{Binding FirstEboardCommand}"
                Grid.Column="0"
                Grid.Row="1"/>

        <Button Content="&lt;"
                Command="{Binding PrevEboardCommand}"
                Grid.Column="1"
                Grid.Row="1"/>

        <TextBox Text="{Binding MainViewModel.NavigationContextViewModel.EboardBrowserViewModel.ScreenSetupViewModel.EboardName, UpdateSourceTrigger=Default}"
                 Visibility="{Binding MainViewModel.MenuBar.IsActiveScreenNotNull, Converter={StaticResource VisibilityToCollapsed}}"
                 HorizontalAlignment="Center"
                 HorizontalContentAlignment="Center"
                 Grid.Column="2"
                 Grid.Row="1"
                 BorderThickness="0"/>

        <Button Content="&gt;"
                Command="{Binding NextEboardCommand}"
                Grid.Column="3"
                Grid.Row="1"/>

        <Button Content="&gt;&gt;|"
                Command="{Binding LastEboardCommand}"
                Grid.Column="4"
                Grid.Row="1"/>
    </Grid>
</UserControl>

<!-- EOF -->