<UserControl x:Class="EBoardSDK.Plugins.Elements.BasicAV.BasicAVMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EBoardSDK.Plugins.Elements.BasicAV"
             d:DataContext="{d:DesignInstance Type=local:BasicAVMainViewModel}"
             FontSize="{Binding ElementViewModel.FluidUI.Font.FontSize, NotifyOnSourceUpdated=True}"
             FontFamily="{Binding ElementViewModel.FluidUI.Font.FontFamily, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
             FontWeight="{Binding ElementViewModel.FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}"             
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Padding="{Binding ElementViewModel.FluidUI.Size.Padding}">

    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{Binding ElementViewModel.FluidUI.Design.Background}"/>
            <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="MinWidth" Value="20"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding ElementPluginName}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{Binding ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"
                   Grid.Column="0" Grid.ColumnSpan="4"
                   Grid.Row="0"/>

        <Button Grid.Column="0"
                Grid.Row="2"
                Content="{Binding SelectButtonContent}"
                Command="{Binding SelectCommand}"/>

            <Button Grid.Column="1"
                Grid.Row="2"
                Content="{Binding PlayButtonContent}"
                Command="{Binding PlayCommand}"/>

            <Button Grid.Column="2"
                Grid.Row="2"
                Content="{Binding PauseButtonContent}"
                Command="{Binding PauseCommand}"/>

            <Button Grid.Column="3"
                Grid.Row="2"
                Content="{Binding StopButtonContent}"
                Command="{Binding StopCommand}"/>

        <!--<MediaElement Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Volume="{Binding Volume, NotifyOnSourceUpdated=True}"/>-->

        <Border Grid.Column="0" Grid.ColumnSpan="4"
                Grid.Row="1">
            <ContentControl Content="{Binding Media}"/>
        </Border>

        <StatusBar x:Name="ui_statusBar" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4"
                   Foreground="{Binding ElementViewModel.FluidUI.Design.Foreground}"
                   Background="{Binding ElementViewModel.FluidUI.Design.Background}">

            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <StatusBarItem Grid.Column="0">
                <TextBlock Text="{Binding PlayTimeString, NotifyOnSourceUpdated=True}"/>
            </StatusBarItem>

            <StatusBarItem Grid.Column="1" HorizontalContentAlignment="Stretch">
                <Slider Name="sliProgress"
                        Thumb.DragStarted="sliProgress_DragStarted"
                        Thumb.DragCompleted="sliProgress_DragCompleted"
                        Minimum="0"
                        Maximum="{Binding MaximumPlayTime}"
                        Value="{Binding PlayTimeSpan, NotifyOnSourceUpdated=True}"
                        MinWidth="100"
                        />
            </StatusBarItem>

            <StatusBarItem Grid.Column="2">
                <TextBlock Text="{Binding MaximumPlayTimeString, NotifyOnSourceUpdated=True}"/>
            </StatusBarItem>

            <StatusBarItem Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" HorizontalContentAlignment="Stretch">
                <ProgressBar Name="pbVolume" MinWidth="50" Height="12" MouseWheel="Grid_MouseWheel"
                             Maximum="1" Value="{Binding Volume, NotifyOnSourceUpdated=True}" />
            </StatusBarItem>

        </StatusBar>

        <TextBlock Text="{Binding FileName}" FontSize="10"
                   Foreground="{Binding ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"
                   Grid.Column="0" Grid.ColumnSpan="4"
                   Grid.Row="4"/>
    </Grid>
</UserControl>

