<UserControl x:Class="EBoardSDK.Plugins.Elements.BasicAV.BasicAVMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EBoardSDK.Plugins.Elements.BasicAV"
             d:DataContext="{d:DesignInstance Type=local:BasicAVMainViewModel}"
             FontSize="{Binding ElementViewModel.FluidUI.Font.FontSize, NotifyOnSourceUpdated=True}"
             FontFamily="{Binding ElementViewModel.FluidUI.Font.FontFamily, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
             FontWeight="{Binding ElementViewModel.FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}"             
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Padding="{Binding ElementViewModel.FluidUI.Size.Padding}">

    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultTextBlock}" >
            <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="MinWidth" Value="25"/>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBox}">
            <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding ElementViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="CaretBrush" Value="{Binding ElementViewModel.FluidUI.Design.Foreground}"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10 5"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="MaxWidth" Value="100"/>
            <Setter Property="MaxHeight" Value="50"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="StatusBarItem">
            <Setter Property="Background" Value="{Binding ElementViewModel.FluidUI.Design.Background}"/>
            <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground}"/>
            <Setter Property="FontFamily" Value="{Binding ElementViewModel.FluidUI.Font.FontFamily, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"/>
            <Setter Property="FontSize" Value="{Binding ElementViewModel.FluidUI.Font.FontSize, NotifyOnSourceUpdated=True}"/>
            <Setter Property="FontWeight" Value="{Binding ElementViewModel.FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding ElementViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DefaultButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="3"                            
                                CornerRadius="5" 
                                MinWidth="50"
                                MinHeight="25"
                                Margin="5"
                                Padding="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                    <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Background, NotifyOnSourceUpdated=True}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ToggleButton">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>

            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground}"/>
            <Setter Property="BorderBrush" Value="{Binding ElementViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderThickness" Value="3"/>

            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="DefaultButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="3"                            
                                CornerRadius="5" 
                                MinWidth="50"
                                MinHeight="25"
                                Margin="5"
                                Padding="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background"
                                    TargetName="DefaultButtonBorder"
                                    Value="{Binding ElementViewModel.FluidUI.Design.Highlight}"/>
                                <!--<Setter Property="Foreground"
                                        Value="{Binding MainViewModel.FluidUI.Design.Highlight}"/>-->
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                    <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Background, NotifyOnSourceUpdated=True}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Name}"
                   Visibility="{Binding ElementViewModel.HideControl3, Converter={StaticResource InverseVisibilityToCollapsed}}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Grid.Column="2"
                   Grid.ColumnSpan="3"
                   Grid.Row="0"/>

        <UniformGrid Rows="1"
                     Grid.Column="2"
                     Grid.Row="1">
            <Button Content="{Binding SelectButtonContent}"
                    Command="{Binding SelectCommand}"/>

            <ToggleButton Content="replay"
                          IsChecked="{Binding ActivateReplay, UpdateSourceTrigger=PropertyChanged}"
                          Visibility="{Binding IsMediaSelected, Converter={StaticResource VisibilityToCollapsed}}"/>

            <ToggleButton Content="unlink"
                          IsChecked="{Binding UnlinkOnEnd, UpdateSourceTrigger=PropertyChanged}"
                          Visibility="{Binding IsMediaSelected, Converter={StaticResource VisibilityToCollapsed}}"/>
        </UniformGrid>

        <!--<Border Visibility="{Binding ContainerIsArea, Converter={StaticResource InverseVisibilityToCollapsed}}"
                Grid.Column="1"
                Grid.Row="1"
                Grid.RowSpan="5">
            <ToggleButton Content="&lt;"
                      IsChecked="{Binding ShowGroupToggleButton}"
                      Visibility="{Binding IsMediaSelected, Converter={StaticResource VisibilityToCollapsed}}"
                      HorizontalAlignment="Left"
                      Padding="0"
                      Margin="0"
                      HorizontalContentAlignment="Left"/>
        </Border>

        <Border Visibility="{Binding ContainerIsArea, Converter={StaticResource InverseVisibilityToCollapsed}}"
                Grid.Column="0"
                Grid.Row="1"
                Grid.RowSpan="4">
            <UniformGrid Columns="1"
                         Visibility="{Binding ShowGroupToggleButton, Converter={StaticResource VisibilityToCollapsed}}">
                <ToggleButton Content="group"
                      IsChecked="{Binding IsGrouped, UpdateSourceTrigger=PropertyChanged}"
                      Grid.Column="4"
                      Grid.Row="1"
                      Grid.RowSpan="5"/>
                <TextBox Text="{Binding ProcessingOrder, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                     Visibility="{Binding IsGrouped, Converter={StaticResource VisibilityToCollapsed}}"
                     HorizontalContentAlignment="Center"/>
            </UniformGrid>
        </Border>-->

        <Border Visibility="{Binding ContainerIsArea, Converter={StaticResource InverseVisibilityToCollapsed}}"
                Grid.Column="3"
                Grid.Row="1"
                Grid.RowSpan="5">
            <ToggleButton Content="&gt;"
                          IsChecked="{Binding ShowDestructToggleButton}"
                          Visibility="{Binding IsMediaSelected, Converter={StaticResource VisibilityToCollapsed}}"
                          HorizontalAlignment="Left"
                          Padding="0"
                          Margin="0"
                          HorizontalContentAlignment="Left"/>
        </Border>

        <Border Visibility="{Binding ContainerIsArea, Converter={StaticResource InverseVisibilityToCollapsed}}"
                Grid.Column="4"
                Grid.Row="1"
                Grid.RowSpan="5">
            <ToggleButton Content="destruct"
                          IsChecked="{Binding DestructOnEnd, UpdateSourceTrigger=PropertyChanged}"
                          Visibility="{Binding ShowDestructToggleButton, Converter={StaticResource VisibilityToCollapsed}}"/>
        </Border>

        <UniformGrid Visibility="{Binding IsMediaSelected, Converter={StaticResource VisibilityToCollapsed}}"
                     Grid.Column="2"
                     Grid.Row="2"
                     Rows="1">
            <Button Content="{Binding PlayButtonContent}"
                    Command="{Binding PlayCommand}"/>

            <Button Content="{Binding PauseButtonContent}"
                    Command="{Binding PauseCommand}"/>

            <Button Content="{Binding StopButtonContent}"
                    Command="{Binding StopCommand}"/>
        </UniformGrid>

        <!--<MediaElement Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Volume="{Binding Volume, NotifyOnSourceUpdated=True}"/>-->

        <Border Visibility="{Binding IsMediaSelected, Converter={StaticResource VisibilityToCollapsed}}"
                Grid.Column="2"
                Grid.Row="1">
            <ContentControl Content="{Binding Media}"/>
        </Border>

        <StatusBar x:Name="ui_statusBar"
                   Grid.Row="3"
                   Grid.Column="2"
                   Foreground="{Binding ElementViewModel.FluidUI.Design.Foreground}"
                   Background="{Binding ElementViewModel.FluidUI.Design.Background}"
                   Visibility="{Binding IsMediaSelected, Converter={StaticResource VisibilityToCollapsed}}">

            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <StatusBarItem Grid.Column="0">
                <TextBlock Text="{Binding PlayTimeString, NotifyOnSourceUpdated=True}"/>
            </StatusBarItem>

            <StatusBarItem Grid.Column="1"
                           HorizontalContentAlignment="Stretch">
                <Slider Name="sliProgress"
                        Thumb.DragStarted="sliProgress_DragStarted"
                        Thumb.DragCompleted="sliProgress_DragCompleted"
                        Minimum="0"
                        Maximum="{Binding MaximumPlayTime}"
                        Value="{Binding PlayTimeSpan, NotifyOnSourceUpdated=True}"
                        MinWidth="100"
                        />
            </StatusBarItem>

            <StatusBarItem Grid.Column="2">
                <TextBlock Text="{Binding MaximumPlayTimeString, NotifyOnSourceUpdated=True}"/>
            </StatusBarItem>

            <StatusBarItem Grid.Column="0"
                           Grid.ColumnSpan="3"
                           Grid.Row="1"
                           HorizontalContentAlignment="Stretch">
                <ProgressBar Name="pbVolume"
                             MinWidth="50"
                             Height="12"
                             MouseWheel="Grid_MouseWheel"
                             Maximum="1"
                             Value="{Binding Volume, NotifyOnSourceUpdated=True}" />
            </StatusBarItem>

        </StatusBar>

        <TextBlock Text="{Binding FileName}"
                   ToolTip="{Binding FileName}"
                   MaxWidth="200"
                   Grid.Column="2"
                   Grid.Row="4"/>
    </Grid>
</UserControl>

<!-- EOF -->