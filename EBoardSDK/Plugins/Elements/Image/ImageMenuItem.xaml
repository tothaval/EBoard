<UserControl x:Class="EBoardSDK.Plugins.Elements.Image.ImageMenuItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EBoardSDK.Plugins.Elements.Image"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=local:ImageMenuItemViewModel}"
             FontSize="{Binding ViewModel.ElementViewModel.FluidUI.Font.FontSize, NotifyOnSourceUpdated=True}"
             FontFamily="{Binding ViewModel.ElementViewModel.FluidUI.Font.FontFamily, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
             FontWeight="{Binding ViewModel.ElementViewModel.FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}"
             >

    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultTextBlock}" >
            <Setter Property="Foreground" Value="{Binding ViewModel.ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBox}">
            <Setter Property="Foreground" Value="{Binding ViewModel.ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding ViewModel.ElementViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>        
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Ratio"
                       Grid.Row="0"/>

            <TextBox Text="{Binding ViewModel.Ratio, UpdateSourceTrigger=PropertyChanged, Delay=1000}"
                     Grid.Row="1"/>
        </Grid>

        <Grid Visibility="{Binding ViewModel.IsImageNotSet, Converter={StaticResource InverseVisibilityToCollapsed}}"
              Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Opacity"
                       Grid.Row="0"/>

            <TextBox Text="{Binding ViewModel.OpacityValue}"
                        TextWrapping="NoWrap"
                        Width="200"
                        Padding="0 0 15 0"
                        Grid.Row="1"/>

            <Slider Value="{Binding ViewModel.OpacityValue}"
                       Background="{Binding ViewModel.ElementViewModel.FluidUI.Design.Background}"
                       Minimum="0"
                       Maximum="1"
                       Width="200"
                       SmallChange="0.05"
                       LargeChange="0.1"
                       Grid.Row="2"/>
        </Grid>
    </Grid>
</UserControl>

