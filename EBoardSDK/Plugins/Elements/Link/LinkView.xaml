<UserControl x:Class="EBoardSDK.Plugins.Elements.Link.LinkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EBoardSDK.Plugins.Elements.Link"
             xmlns:conv="clr-namespace:EBoardSDK.SharedMethods"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=local:LinkViewModel}"
             FontSize="{Binding ElementViewModel.FluidUI.Font.FontSize, NotifyOnSourceUpdated=True}"
             FontFamily="{Binding ElementViewModel.FluidUI.Font.FontFamily, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
             FontWeight="{Binding ElementViewModel.FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}"
             >

    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultTextBlock}" >
            <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBox}">
            <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding ElementViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0 0 10 0"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding ElementViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderThickness" Value="3"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DefaultButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="3"                            
                                CornerRadius="5" 
                                MinWidth="50"
                                MinHeight="25"
                                Margin="5"
                                Padding="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                    <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Background, NotifyOnSourceUpdated=True}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="MenuItem" BasedOn="{StaticResource MenuItemStyle}" x:Key="menuitem">
            <Setter Property="BorderBrush" Value="{Binding ElementViewModel.FluidUI.Design.Border}"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="TextBlock.Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground}"/>
            <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground}"/>
            <Setter Property="Background" Value="{Binding ElementViewModel.FluidUI.Design.Background}"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Highlight}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ToolTip" BasedOn="{StaticResource DefaultToolTip}">
            <Setter Property="Background" Value="{Binding ElementViewModel.FluidUI.Design.Background}"/>
            <Setter Property="BorderBrush" Value="{Binding ElementViewModel.FluidUI.Design.Border}"/>
            <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground}"/>
            <Setter Property="FontSize" Value="{Binding ElementViewModel.FluidUI.Font.FontSize}"/>
            <Setter Property="FontFamily" Value="{Binding ElementViewModel.FluidUI.Font.FontFamily, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"/>
            <Setter Property="FontWeight" Value="{Binding ElementViewModel.FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}"/>
        </Style>
    </UserControl.Resources>

    <Grid MinHeight="30" MinWidth="30"
          Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   FontWeight="Bold"
                   Text="{Binding Name}"
                   Visibility="{Binding ElementViewModel.HideControl3, Converter={StaticResource InverseVisibilityToCollapsed}}"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Left"/>
        
        <Button Command="{Binding LinkFileCommand}"
                Visibility="{Binding IsLinkEmpty, NotifyOnSourceUpdated=True, Converter={StaticResource VisibilityToCollapsed}}"
                Grid.Column="0"
                Grid.Row="1">
            <TextBlock>
                <Run Text="file"/>
                <LineBreak/>
                <Run Text="{Binding LinkStatusText, NotifyOnSourceUpdated=True}"/>
            </TextBlock>
        </Button>

        <Button Command="{Binding LinkFolderCommand}"
                Visibility="{Binding IsLinkEmpty, NotifyOnSourceUpdated=True, Converter={StaticResource VisibilityToCollapsed}}"
                Grid.Column="1"
                Grid.Row="1">
            <TextBlock>
                <Run Text="folder"/>
                <LineBreak/>
                <Run Text="{Binding LinkStatusText, NotifyOnSourceUpdated=True}"/>
            </TextBlock>
        </Button>

        <Button Command="{Binding LinkWebCommand}"
                Visibility="{Binding IsLinkEmpty, NotifyOnSourceUpdated=True, Converter={StaticResource VisibilityToCollapsed}}"
                Grid.Column="3"
                Grid.Row="1">
            <TextBlock>
                <Run Text="web"/>
                <LineBreak/>                
                <TextBox Text="{Binding LinkTargetPath, Delay=100, UpdateSourceTrigger=PropertyChanged}"
                         MinWidth="50">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SaveLinkTargetNameCommandCommand}"/>
                            </TextBox.InputBindings>
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Background" Value="{Binding ElementViewModel.FluidUI.Design.Foreground}"/>
                                    <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Background}"/>
                                    <Setter Property="CaretBrush" Value="{Binding ElementViewModel.FluidUI.Design.Highlight}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Highlight}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="False">
                                            <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Background}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
            </TextBlock>
        </Button>

        <Button Command="{Binding ExecuteLinkTargetCommand}"
                Visibility="{Binding IsLinked, Converter={StaticResource VisibilityToCollapsed}}"
                Grid.Column="0"
                Grid.Row="1">
            <Button.InputBindings>
                <MouseBinding Gesture="Control+Leftclick" Command="{Binding ResetCommand}"/>
            </Button.InputBindings>

            <Button.ToolTip>
                <ToolTip Content="{Binding LinkTargetPath, NotifyOnSourceUpdated=True}"/>
            </Button.ToolTip>

            <Button.Content>
                <Border  Margin="5"  HorizontalAlignment="Stretch">
                    <Border.ContextMenu>
                        <ContextMenu Background="{Binding ElementViewModel.FluidUI.Design.Background}"
                                     Foreground="{Binding ElementViewModel.FluidUI.Design.Foreground}"
                                     BorderBrush="{Binding ElementViewModel.FluidUI.Design.Border}"
                                     Style="{StaticResource ContextMenuStyle}">
                            <MenuItem Header="{Binding EditText, NotifyOnSourceUpdated=True}" Style="{StaticResource menuitem}"
                            Command="{Binding EditLinkTargetNameCommand}"/>
                        </ContextMenu>
                    </Border.ContextMenu>

                    <Grid >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <Image Source="{Binding ImageSource, NotifyOnSourceUpdated=True}"
                           Grid.Row="0"/>

                        <TextBox Text="{Binding LinkTargetName, Delay=100, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0"
                             Grid.Row="2"
                             IsReadOnly="{Binding IsEditLinkTargetNameTextBoxReadOnly, NotifyOnSourceUpdated=True}"
                             IsReadOnlyCaretVisible="{Binding InverseEditBoolForTextBoxCaretSetting, NotifyOnSourceUpdated=True}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SaveLinkTargetNameCommandCommand}"/>
                            </TextBox.InputBindings>
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers> 
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Highlight}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="False">
                                            <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>                            
                        </TextBox>
                    </Grid>
                </Border>
            </Button.Content>
        </Button>
    </Grid>
</UserControl>

