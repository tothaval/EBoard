<UserControl x:Class="EBoardSDK.Plugins.Elements.Link.LinkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EBoardSDK.Plugins.Elements.Link"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=local:LinkViewModel}"
             >

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style TargetType="MenuItem" BasedOn="{StaticResource MenuItemStyle}" x:Key="menuitem">
            <Setter Property="BorderBrush" Value="{Binding BrushManagement.Border}"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="TextBlock.Foreground" Value="{Binding BrushManagement.Foreground}"/>
            <Setter Property="Foreground" Value="{Binding BrushManagement.Foreground}"/>
            <Setter Property="Background" Value="{Binding BrushManagement.Background}"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{Binding BrushManagement.Highlight}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Foreground" Value="{Binding BrushManagement.Foreground}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid MinHeight="30" MinWidth="30"
          Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!--<Label Content="{Binding EpicText}" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>-->
        <Button Content="{Binding LinkStatusText, NotifyOnSourceUpdated=True}" Command="{Binding LinkCommand}"
                    Background="{Binding BrushManagement.Background, NotifyOnSourceUpdated=True}"
                    Foreground="{Binding BrushManagement.Foreground, NotifyOnSourceUpdated=True}"
                    Visibility="{Binding IsLinkEmpty, NotifyOnSourceUpdated=True, Converter={StaticResource BoolToVisibilityConverter}}"
                Style="{StaticResource EBoardBrowserViewButtonStyle}"
                    Grid.Column="0" Grid.Row="0"/>
        
        <Button Command="{Binding ExecuteLinkTargetCommand}"
                    Visibility="{Binding IsLinked, Converter={StaticResource BoolToVisibilityConverter}}"
                    Grid.Column="0" Grid.Row="0"                    
                    Background="{Binding BrushManagement.Background, NotifyOnSourceUpdated=True}"
                    Foreground="{Binding BrushManagement.Foreground, NotifyOnSourceUpdated=True}"
                Style="{StaticResource EBoardBrowserViewButtonStyle}">
            <Button.InputBindings>
                <MouseBinding Gesture="Control+Leftclick" Command="{Binding ResetCommand}"/>
            </Button.InputBindings>

            <Button.ToolTip>
                <ToolTip Content="{Binding LinkTargetPath, NotifyOnSourceUpdated=True}"
                         Background="{Binding BrushManagement.Background}"
                         Foreground="{Binding BrushManagement.Foreground}"
                         BorderBrush="{Binding BrushManagement.Border}"
                         BorderThickness="1"/>
            </Button.ToolTip>

            <Button.Content>
                <Border  Margin="5"  HorizontalAlignment="Stretch">
                    <Border.ContextMenu>
                        <ContextMenu Background="{Binding BrushManagement.Background}"
                       Foreground="{Binding BrushManagement.Foreground}"
                       BorderBrush="{Binding BrushManagement.Border}"
                       Style="{StaticResource ContextMenuStyle}">
                            <MenuItem Header="{Binding EditText, NotifyOnSourceUpdated=True}" Style="{StaticResource menuitem}"
                            Command="{Binding EditLinkTargetNameCommand}"/>
                        </ContextMenu>
                    </Border.ContextMenu>
                    
                    <Grid >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <Image Source="{Binding ImageSource, NotifyOnSourceUpdated=True}"
                           Grid.Row="0"/>

                    <TextBox Text="{Binding LinkTargetName, Delay=100, UpdateSourceTrigger=PropertyChanged}"
                             Background="{Binding BrushManagement.Background}"
                             Foreground="{Binding BrushManagement.Foreground}"
                             BorderBrush="{Binding BrushManagement.Border}"
                             BorderThickness="0"
                             Grid.Row="1"
                             IsReadOnly="{Binding IsEditLinkTargetNameTextBoxReadOnly, NotifyOnSourceUpdated=True}"
                             IsReadOnlyCaretVisible="{Binding InverseEditBoolForTextBoxCaretSetting, NotifyOnSourceUpdated=True}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SaveLinkTargetNameCommandCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </Grid>
                </Border>
            </Button.Content>
        </Button>

    </Grid>
</UserControl>