<UserControl x:Class="EBoardSDK.Plugins.Elements.Protocol.ProtocolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EBoardSDK.Plugins.Elements.Protocol"
             xmlns:utils="clr-namespace:EBoardSDK.SharedMethods"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             d:DataContext="{d:DesignInstance Type=local:ProtocolViewModel}"
             FontSize="{Binding ElementViewModel.FluidUI.Font.FontSize, NotifyOnSourceUpdated=True}"
             FontFamily="{Binding ElementViewModel.FluidUI.Font.FontFamily, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
             FontWeight="{Binding ElementViewModel.FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>
        <utils:DateConverter x:Key="DateTimeConverter"/>

        <Style TargetType="{x:Type Button}" x:Key="DefaultButton">
            <Setter Property="MinWidth" Value="25"/>
            <Setter Property="MinHeight" Value="25"/>
        </Style>

        <Style TargetType="{x:Type RichTextBox}" x:Key="HeaderRichTextBox">
        </Style>

        <Style TargetType="{x:Type RichTextBox}" x:Key="ContentRichTextBox">
        </Style>

        <Style TargetType="{x:Type RichTextBox}" x:Key="DateTimeRichTextBox">
        </Style>

        <Style TargetType="{x:Type TextBox}" x:Key="HeaderTextBox">
        </Style>

        <Style TargetType="{x:Type TextBox}" x:Key="ContentTextBox">
        </Style>

        <Style TargetType="{x:Type TextBlock}" x:Key="DateTimeTextBlock">
        </Style>
        
    </UserControl.Resources>

    <Border BorderBrush="{Binding ElementViewModel.FluidUI.Design.Border}"
            BorderThickness="5"
            CornerRadius="{Binding ElementViewModel.FluidUI.Size.CornerRadius}"
            Margin="{Binding ElementViewModel.FluidUI.Size.Margin}"
            Padding="{Binding ElementViewModel.FluidUI.Size.Padding}">
        <Border x:Name="MainBorder"
            CornerRadius="{Binding ElementViewModel.FluidUI.Size.CornerRadius}">
            <Border.OpacityMask>
                <VisualBrush>
                    <VisualBrush.Visual>
                        <Border 
                    Background="{Binding ElementViewModel.FluidUI.Design.Background}"
                    SnapsToDevicePixels="True"
                    CornerRadius="{Binding ElementViewModel.FluidUI.Size.CornerRadius, RelativeSource={RelativeSource AncestorType=Border}}"
                            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}}"
                    Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Border}}"
                    />
                    </VisualBrush.Visual>
                </VisualBrush>
            </Border.OpacityMask>

            <Grid Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <Button Command="{Binding NewEntryCommand}"
                        Background="Transparent"
                        BorderBrush="{Binding ElementViewModel.FluidUI.Design.Border}"
                        Grid.Row="0">
                    <Button.Content>
                        <!-- TODO: change button to a style with highlight as hover color-->
                        <TextBlock Text="{Binding CurrentDateTime, Converter={StaticResource DateTimeConverter}, NotifyOnSourceUpdated=True}"
                                   Style="{StaticResource DateTimeTextBlock}"
                                   Background="{Binding ElementViewModel.FluidUI.Design.Background}"
                                   Foreground="{Binding ElementViewModel.FluidUI.Design.Foreground}"
                                   Padding="5"/>
                    </Button.Content>
                </Button>

                <TextBox x:Name="TX_Title"
                         Style="{StaticResource HeaderTextBox}"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="Wrap"
                         Padding="5 5 20 5"
                         Grid.Row="1"
                         MinWidth="100"                         
                         Background="{Binding ElementViewModel.FluidUI.Design.Background}"
                         Foreground="{Binding ElementViewModel.FluidUI.Design.Foreground}"
                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged, Delay=200}"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="True"
                      Grid.Row="2">
                    <TextBox x:Name="TX_Note"
                     Style="{StaticResource ContentTextBox}"
                         MinWidth="150"
                         MinHeight="150"                            
                             Padding="5 5 20 5"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             IsUndoEnabled="True"
                             TextWrapping="Wrap"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         VerticalAlignment="Stretch"
                         Background="{Binding ElementViewModel.FluidUI.Design.Background}"
                         Foreground="{Binding ElementViewModel.FluidUI.Design.Foreground}"
                             Width="250"
                             Height="250"
                     Text="{Binding Content, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                         />
                </ScrollViewer>
            </Grid>
        </Border>
    </Border>
</UserControl>

<!-- EOF -->