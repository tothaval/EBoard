                        Command="{Binding SaveStandardTextModelToFileCommand}"
                        Grid.Column="0"/>

                        <Button Content="Load"
                        Command="{Binding LoadStandardTextModelFromFileCommand}"
                        Grid.Column="1"/>
                    </Grid>
                </MenuItem>

                <MenuItem Header="Setup"
                          Style="{StaticResource menuitem}">
                    <MenuItem Header="Title"
                          Style="{StaticResource menuitem}">
                        <fluiduifont:FluidUIFontSetupMenuItem DataContext="{Binding TitleFontSetup}"
                                                      Style="{StaticResource menuitem}"/>
                        <ComboBox Foreground="{Binding ElementViewModel.FluidUI.Design.Foreground}"
                          ItemsSource="{Binding TextAlignments, NotifyOnSourceUpdated=True}"
                          SelectedItem="{Binding TitleAlignmentValue, NotifyOnSourceUpdated=True}"
                          Grid.Row="0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Background="Transparent"
                                           Text="{Binding }"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </MenuItem>
                </MenuItem>
                
                <MenuItem Header="Shape"
                          Style="{StaticResource menuitem}"
                          Command="{Binding MakeTextShapeCommand}"/>

            </ContextMenu>
        </Border.ContextMenu>-->
        
        <Grid HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBox Grid.Row="0"
                     Text="{Binding Title, NotifyOnSourceUpdated=True}"
                     IsReadOnly="{Binding IsTitleSet}"
                     IsReadOnlyCaretVisible="False"
                     FontFamily="{Binding TitleFont.FontFamily}"
                     FontSize="{Binding TitleFont.FontSize}"
                     FontWeight="{Binding TitleFont.FontWeight}"
                     BorderThickness="{Binding TitleTextBoxBorderThickness}"
                     BorderBrush="{Binding TitleTextBoxBorderBrush}"
                     Background="{Binding TitleTextBoxBrush}"
                     Foreground="{Binding ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"
                     CaretBrush="{Binding ElementViewModel.FluidUI.Design.Foreground}"
                     TextAlignment="{Binding TitleAlignmentValue}"
                     Visibility="{Binding CanShowTitle, Converter={StaticResource VisibilityToCollapsed}}"
                     TextWrapping="Wrap"
                     HorizontalAlignment="Stretch">
                
                <TextBox.InputBindings>
                    <MouseBinding Gesture="Control+Leftclick" Command="{Binding SetTitleCommand}"/>
                    <KeyBinding Gesture="Enter" Command="{Binding ConfirmTitleCommand}"/>
                </TextBox.InputBindings>
            </TextBox>

        <TextBox Grid.Row="1"
                 Text="{Binding Text}"
                 BorderThickness="0"
                 FontFamily="{Binding ElementViewModel.FluidUI.Font.FontFamily}"
                 FontSize="{Binding ElementViewModel.FluidUI.Font.FontSize}"
                 FontWeight="{Binding ElementViewModel.FluidUI.Font.FontWeight}"
                 Foreground="{Binding ElementViewModel.FluidUI.Design.Foreground}"
                 CaretBrush="{Binding ElementViewModel.FluidUI.Design.Foreground}"
                 TextAlignment="{Binding TextAlignmentValue}"
                 Visibility="{Binding CanShowText, Converter={StaticResource VisibilityToCollapsed}}"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalAlignment="Stretch"
                 VerticalContentAlignment="{Binding TextVerticalAlignment}"
                 VerticalAlignment="Stretch">
            </TextBox>
        </Grid>
    </Border>
</UserControl>

