<UserControl x:Class="EBoardSDK.Plugins.Elements.StandardText.StandardTextView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EBoardSDK.Plugins.Elements.StandardText"
             d:DataContext="{d:DesignInstance Type=local:StandardTextViewModel}"
             FontSize="{Binding ElementViewModel.FluidUI.Font.FontSize, NotifyOnSourceUpdated=True}"
             FontFamily="{Binding ElementViewModel.FluidUI.Font.FontFamily, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
             FontWeight="{Binding ElementViewModel.FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             >

    <UserControl.Resources>
        <Style TargetType="Label" >
            <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground}"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        
        <Style TargetType="MenuItem" BasedOn="{StaticResource MenuItemStyle}" x:Key="menuitem">
            <Setter Property="BorderBrush" Value="{Binding ElementViewModel.FluidUI.Design.Border}"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="TextBlock.Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground}"/>
            <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground}"/>
            <Setter Property="Background" Value="{Binding ElementViewModel.FluidUI.Design.Background}"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Highlight}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>
    
    <Border>
        <Border.ContextMenu>
            <ContextMenu Background="{Binding ElementViewModel.FluidUI.Design.Background}"
                         Foreground="{Binding ElementViewModel.FluidUI.Design.Foreground}"
                         BorderBrush="{Binding ElementViewModel.FluidUI.Design.Border}"
                         Style="{StaticResource ContextMenuStyle}">
                <MenuItem Header="Title" Style="{StaticResource menuitem}">
                    <WrapPanel Orientation="Horizontal">
                        <Label Content="FontSize"
                                           MinWidth="50"/>
                        <Label Content="{Binding FontSizeTitle, NotifyOnSourceUpdated=True}"
                               MinWidth="35"/>
                        <Slider Value="{Binding FontSizeTitle, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True, UpdateSourceTrigger=PropertyChanged}"
                                Minimum="7"
                                Maximum="80"
                                MinWidth="100"
                                SmallChange="1"
                                LargeChange="5"
                                Interval="1"
                                Orientation="Horizontal"/>
                    </WrapPanel>
                </MenuItem>
                
                <MenuItem Header="Text" Style="{StaticResource menuitem}">
                    <WrapPanel Orientation="Horizontal">
                        <Label Content="FontSize"
                                           MinWidth="50"/>
                        <Label Content="{Binding FontSize, NotifyOnSourceUpdated=True}"
                               MinWidth="35"/>
                        <Slider Value="{Binding FontSize, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True, UpdateSourceTrigger=PropertyChanged}"
                            Minimum="7"
                            Maximum="80"
                            MinWidth="100"
                            SmallChange="1"
                            LargeChange="5"
                            Interval="1"
                            Orientation="Horizontal"/>
                    </WrapPanel>
                </MenuItem>
            </ContextMenu>
        </Border.ContextMenu>
        
        <Grid HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Margin="{Binding ElementViewModel.FluidUI.Size.Margin}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" HorizontalAlignment="Stretch" Background="Transparent"/>

            <TextBox Grid.Row="0"
                     IsReadOnly="{Binding IsTitleSet}"
                     IsReadOnlyCaretVisible="False"
                     FontSize="{Binding FontSizeTitle}"
                     BorderThickness="{Binding TitleTextBoxBorderThickness}"
                     BorderBrush="{Binding TitleTextBoxBrush}"
                     MinWidth="50"
                     Background="{Binding TitleTextBoxBrush}"
                     Foreground="{Binding ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"
                     FontWeight="Bold"
                     Text="{Binding Title, NotifyOnSourceUpdated=True}"
                     TextWrapping="Wrap"
                     HorizontalAlignment="Center">
                
                <TextBox.InputBindings>
                    <MouseBinding Gesture="Control+Leftclick" Command="{Binding SetTitleCommand}"/>
                    <KeyBinding Gesture="Enter" Command="{Binding ConfirmTitleCommand}"/>
                </TextBox.InputBindings>
            </TextBox>

        <TextBox Grid.Row="1"
                 Text="{Binding Text}"
                 Margin="5"
                 Padding="5"
                 BorderThickness="3"
                 FontSize="{Binding FontSize}"
                 Background="Transparent"
                 Foreground="{Binding ElementViewModel.FluidUI.Design.Foreground}"
                 BorderBrush="{Binding ElementViewModel.FluidUI.Design.Border}"
                 CaretBrush="{Binding ElementViewModel.FluidUI.Design.Foreground}"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch">
            </TextBox>
        </Grid>
    </Border>
</UserControl>

