<UserControl x:Class="EBoardSDK.Plugins.Shapes.Polygon.PolygonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EBoardSDK.Plugins.Shapes.Polygon"
             xmlns:controls="clr-namespace:EBoardSDK.Controls.FluidUIMenu"
             xmlns:conv="clr-namespace:EBoardSDK.SharedMethods"
             xmlns:esdkfuim="clr-namespace:EBoardSDK.Controls.FluidUIMenu"
             d:DataContext="{d:DesignInstance Type=local:PolygonViewModel}"
             FontSize="{Binding FluidUI.Font.FontSize, NotifyOnSourceUpdated=True}"
             FontFamily="{Binding FluidUI.Font.FontFamily, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
             FontWeight="{Binding FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}"
             ClipToBounds="True"
             SnapsToDevicePixels="True"             
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             
             AllowDrop="True"
             Drop="UserControl_Drop">
    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultTextBlock}" >
            <Setter Property="Foreground" Value="{Binding FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="25"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="tbstyle" BasedOn="{StaticResource DefaultTextBlock}" >
            <Setter Property="Foreground" Value="{Binding FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="25"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBox}">
            <Setter Property="Foreground" Value="{Binding FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{Binding FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DefaultButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="3"                            
                                CornerRadius="5" 
                                MinWidth="50"
                                MinHeight="25"
                                Margin="5"
                                Padding="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                    <Setter Property="Foreground" Value="{Binding FluidUI.Design.Background, NotifyOnSourceUpdated=True}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{Binding FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="MenuItem" BasedOn="{StaticResource MenuItemStyle}" x:Key="menuitem">
            <Setter Property="BorderBrush" Value="{Binding FluidUI.Design.Border}"/>
            <Setter Property="TextBlock.Foreground" Value="{Binding FluidUI.Design.Foreground}"/>
            <Setter Property="Foreground" Value="{Binding FluidUI.Design.Foreground}"/>
            <Setter Property="Background" Value="{Binding FluidUI.Design.Background}"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{Binding FluidUI.Design.Highlight}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Foreground" Value="{Binding FluidUI.Design.Foreground}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource MenuItemStyle}" x:Key="sub">
            <Setter Property="BorderBrush" Value="{Binding FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="TextBlock.Foreground" Value="{Binding FluidUI.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="Foreground" Value="{Binding FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="Background" Value="{Binding FluidUI.Design.Background, NotifyOnSourceUpdated=True}"/>
        </Style>

        <Style TargetType="ToolTip" BasedOn="{StaticResource DefaultToolTip}">
            <Setter Property="Background" Value="{Binding FluidUI.Design.Background}"/>
            <Setter Property="BorderBrush" Value="{Binding FluidUI.Design.Border}"/>
            <Setter Property="Foreground" Value="{Binding FluidUI.Design.Foreground}"/>
            <Setter Property="FontSize" Value="{Binding FluidUI.Font.FontSize}"/>
            <Setter Property="FontFamily" Value="{Binding FluidUI.Font.FontFamily, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"/>
            <Setter Property="FontWeight" Value="{Binding FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}"/>
        </Style>
    </UserControl.Resources>

    <Grid ClipToBounds="True"
          Visibility="{Binding ElementViewModel.HideControl1, Converter={StaticResource InverseVisibilityToCollapsed}}">
        <Grid.ContextMenu>
            <ContextMenu Background="{Binding FluidUI.Design.Background}"
               BorderBrush="{Binding FluidUI.Design.Border}"
               Foreground="{Binding FluidUI.Design.Foreground}"
               Style="{StaticResource ContextMenuStyle}">

                <TextBlock Text="{Binding FluidUI.DataBlock.Title, NotifyOnSourceUpdated=True}"/>

                <MenuItem Header="Edit Polygon"
                          Command="{Binding EditCommand}"
                          Style="{StaticResource menuitem}"/>

                <MenuItem Header="Clear Points"
                          Command="{Binding ClearPointsCommand}"
                          Style="{StaticResource menuitem}"
                          Visibility="{Binding ResetPolygon, Converter={StaticResource VisibilityToCollapsed}}"/>

                <MenuItem Header="Hide"
                          Style="{StaticResource menuitem}">
                    <ToggleButton Content="Hide Element"
                                  IsChecked="{Binding ElementViewModel.HideControl0}"
                                  HorizontalAlignment="Left"/>
                    <ToggleButton Content="Hide Shape"
                                  IsChecked="{Binding ElementViewModel.HideControl1}"
                                  HorizontalAlignment="Left"/>
                </MenuItem>

                <MenuItem Header="Stroke"
                              Style="{StaticResource menuitem}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Stroke"
                           Grid.Column="0"/>

                        <TextBlock Text="{Binding StrokeThickness, StringFormat=N0}"
                           Grid.Column="1"/>

                        <Slider Value="{Binding StrokeThickness}"
                        Minimum="0"
                        Maximum="100"
                        MinWidth="101"
                        SmallChange="1"
                        LargeChange="5"
                           Grid.Column="2"/>
                    </Grid>
                </MenuItem>

                <esdkfuim:FluidUIMenuView DataContext="{Binding FluidUIMenuViewModel, NotifyOnSourceUpdated=True}"
                                Style="{StaticResource menuitem}"/>

                <MenuItem Header="Delete"
                          Command="{Binding DeleteElementCommand}"
                          Style="{StaticResource menuitem}"/>
            </ContextMenu>
        </Grid.ContextMenu>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   FontWeight="Bold"
                   Text="{Binding Name}"
                   Visibility="{Binding ElementViewModel.HideControl3, Converter={StaticResource InverseVisibilityToCollapsed}}"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"/>

        <Polygon Visibility="{Binding PolygonReady, Converter={StaticResource VisibilityToCollapsed}}"
                 Fill="{Binding FluidUI.Design.Background, NotifyOnSourceUpdated=True}"
                 StrokeThickness="{Binding StrokeThickness, NotifyOnSourceUpdated=True}"
                 Stroke="{Binding FluidUI.Design.Border, NotifyOnSourceUpdated=True}"
                 Margin="{Binding FluidUI.Size.Margin, NotifyOnSourceUpdated=True}"
        
                 Points="{Binding PolygonPointCollection, NotifyOnSourceUpdated=True}"
                 
                 StrokeDashArray="1 1 2"
                 StrokeDashCap="Triangle"
                 
                 StrokeLineJoin="Round"
                 StrokeEndLineCap="Round"
                 
                 SnapsToDevicePixels="True"
                 ClipToBounds="True"
                 
                 Stretch="None"
                                  
                 MinWidth="10"
                 MinHeight="10"
                 
                 Grid.Row="1">
            <Polygon.LayoutTransform>
                <ScaleTransform ScaleX="{Binding FluidUI.Size.ScaleX}"
                                ScaleY="{Binding FluidUI.Size.ScaleY}"/>
            </Polygon.LayoutTransform>
        </Polygon>

        <Border Background="{Binding FluidUI.Design.Background, NotifyOnSourceUpdated=True}"
                BorderBrush="{Binding FluidUI.Design.Border, NotifyOnSourceUpdated=True}"
                BorderThickness="{Binding FluidUI.Size.BorderThickness}"
                Padding="{Binding FluidUI.Size.Padding}"
                CornerRadius="{Binding FluidUI.Size.CornerRadius}"
                
                Width="{Binding FluidUI.Size.Width}"
                Height="{Binding FluidUI.Size.Height}"
                
                Visibility="{Binding ResetPolygon, Converter={StaticResource VisibilityToCollapsed}}"
                Grid.Row="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBox Text="{Binding NewPoint, UpdateSourceTrigger=PropertyChanged}"
                         TextAlignment="Center"
                         Grid.Column="0"
                         Grid.ColumnSpan="3"
                         Grid.Row="0">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Execute" Command="{Binding AddPointCommand}" />
                        <KeyBinding Key="Return" Command="{Binding AddPointCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <Button Content="Add Point"
                        Command="{Binding AddPointCommand}"
                        Grid.Column="0"
                        Grid.Row="1"/>

                <Button Content="Edit Point"
                        Command="{Binding EditPointCommand}"
                        Grid.Column="1"
                        Grid.Row="1"/>

                <Button Content="Delete Point"
                        Command="{Binding DeletePointCommand}"
                        Grid.Column="2"
                        Grid.Row="1"/>

                <Button Content="Create Polygon"
                        Command="{Binding CreateCommand}"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Grid.Row="2"/>

                <Button Content="Clear Points"
                     Command="{Binding ClearPointsCommand}"
                        Visibility="{Binding BelowMinimumPointCount, Converter={StaticResource InverseVisibilityToCollapsed}}"
                     Grid.Column="0"
                     Grid.ColumnSpan="3"
                     Grid.Row="3"/>

                <TextBlock Text="at least 3 points are required"
                           Foreground="{Binding FluidUI.Design.Highlight}"
                           Visibility="{Binding BelowMinimumPointCount, Converter={StaticResource VisibilityToCollapsed}}"
                           Grid.Column="0"
                           Grid.ColumnSpan="3"
                           Grid.Row="4"/>

                <ListBox ItemsSource="{Binding Points, NotifyOnSourceUpdated=True}"
                         SelectedItem="{Binding SelectedPoint}"
                         x:Name="PointCollectionListBox"
                         HorizontalContentAlignment="Center"
                         Grid.Column="0"
                         Grid.ColumnSpan="3"
                         Grid.Row="5">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Foreground="{Binding FluidUI.Design.Foreground, RelativeSource={RelativeSource AncestorType=ListBox, Mode=FindAncestor}}"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<!-- EOF -->    