<UserControl x:Class="EBoardSDK.Plugins.Shapes.Rectangle.RectangleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EBoardSDK.Plugins.Shapes.Rectangle"
             xmlns:controls="clr-namespace:EBoardSDK.Controls.FluidUIMenu"
             xmlns:conv="clr-namespace:EBoardSDK.SharedMethods"
             xmlns:esdkfuim="clr-namespace:EBoardSDK.Controls.FluidUIMenu"
             d:DataContext="{d:DesignInstance Type=local:RectangleViewModel}"
             FontSize="{Binding ViewModel.FluidUI.Font.FontSize, NotifyOnSourceUpdated=True}"
             FontFamily="{Binding ViewModel.FluidUI.Font.FontFamily, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
             FontWeight="{Binding ViewModel.FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultTextBlock}" >
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="25"/>
        </Style>
        
        <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBox}">
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding ViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0 0 10 0"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding ViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderThickness" Value="3"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DefaultButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="3"                            
                                CornerRadius="5" 
                                MinWidth="50"
                                MinHeight="25"
                                Margin="5"
                                Padding="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Background, NotifyOnSourceUpdated=True}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <conv:BooleanToVisibilityCollapsedConverter x:Key="booltocolconv"/>

        <Style TargetType="MenuItem" BasedOn="{StaticResource MenuItemStyle}" x:Key="menuitem">
            <Setter Property="BorderBrush" Value="{Binding ViewModel.FluidUI.Design.Border}"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="TextBlock.Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground}"/>
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground}"/>
            <Setter Property="Background" Value="{Binding ViewModel.FluidUI.Design.Background}"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Highlight}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource MenuItemStyle}" x:Key="sub">
            <Setter Property="BorderBrush" Value="{Binding ViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="TextBlock.Foreground" Value="{Binding ViewModel.FluidUI.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="Background" Value="{Binding ViewModel.FluidUI.Design.Background, NotifyOnSourceUpdated=True}"/>
        </Style>

        <Style TargetType="ToolTip" BasedOn="{StaticResource DefaultToolTip}">
            <Setter Property="Background" Value="{Binding ViewModel.FluidUI.Design.Background}"/>
            <Setter Property="BorderBrush" Value="{Binding ViewModel.FluidUI.Design.Border}"/>
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground}"/>
            <Setter Property="FontSize" Value="{Binding ViewModel.FluidUI.Font.FontSize}"/>
            <Setter Property="FontFamily" Value="{Binding ViewModel.FluidUI.Font.FontFamily, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"/>
            <Setter Property="FontWeight" Value="{Binding ViewModel.FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}"/>
        </Style>
    </UserControl.Resources>

    <Rectangle
        Fill="{Binding ViewModel.FluidUI.Design.Background, NotifyOnSourceUpdated=True}"
        StrokeThickness="{Binding StrokeThickness, NotifyOnSourceUpdated=True}"
        Stroke="{Binding ViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"
        Margin="{Binding ViewModel.FluidUI.Size.Margin, NotifyOnSourceUpdated=True}"
        
        MinWidth="10"
        MinHeight="10"
        
        Width="{Binding ViewModel.FluidUI.Size.Width}"
        Height="{Binding ViewModel.FluidUI.Size.Height}">

        <Rectangle.ToolTip>
            <ToolTip Visibility="{Binding ViewModel.FluidUI.DataBlock.ShowToolTip, NotifyOnSourceUpdated=True, Converter={StaticResource booltocolconv}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto" SharedSizeGroup="stand1"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto" SharedSizeGroup="stand2"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="x"
                               Grid.Column="0"
                               Grid.Row="0"/>
                    <Border BorderBrush="{Binding ViewModel.FluidUI.Design.Border}"
                            BorderThickness="0 0 2 0"
                            Margin="0 0 5 0"
                            Grid.Column="1"
                            Grid.Row="0">
                        <TextBlock Text="{Binding ViewModel.FluidUI.Stand.Position.X, NotifyOnSourceUpdated=True}"
                                   TextAlignment="Right"
                                   Padding="0 0 5 0"/>
                    </Border>

                    <TextBlock Text="y"
                               Grid.Column="0"
                               Grid.Row="1"/>
                    <Border BorderBrush="{Binding ViewModel.FluidUI.Design.Border}"
                            BorderThickness="0 0 2 0"
                            Margin="0 0 5 0"
                            Grid.Column="1"
                            Grid.Row="1">
                        <TextBlock Text="{Binding ViewModel.FluidUI.Stand.Position.Y, NotifyOnSourceUpdated=True}"
                                   TextAlignment="Right"
                                   Padding="0 0 5 0"/>
                    </Border>

                    <TextBlock Text="z"
                               Grid.Column="2"
                               Grid.Row="0"/>
                    <Border BorderBrush="{Binding ViewModel.FluidUI.Design.Border}"
                            BorderThickness="0 0 2 0"
                            Margin="0 0 5 0"
                            Grid.Column="3"
                            Grid.Row="0">
                        <TextBlock Text="{Binding ViewModel.FluidUI.Stand.Z, NotifyOnSourceUpdated=True}"
                                   TextAlignment="Right"
                                   Padding="0 0 5 0"/>
                    </Border>

                    <TextBlock Text="°"
                               Grid.Column="2"
                               Grid.Row="1"/>
                    <Border BorderBrush="{Binding ViewModel.FluidUI.Design.Border}"
                            BorderThickness="0 0 2 0"
                            Margin="0 0 5 0"
                            Grid.Column="3"
                            Grid.Row="1">
                        <TextBlock Text="{Binding ViewModel.FluidUI.Stand.Angle, NotifyOnSourceUpdated=True}"
                                   TextAlignment="Right"
                                   Padding="0 0 5 0"/>
                    </Border>

                    <TextBlock Text="{Binding ElementViewModel.Plugin.ElementPluginName, NotifyOnSourceUpdated=True, Mode=OneWay}"
                               Grid.Column="4"
                               Grid.Row="0"/>
                    <TextBlock Text="{Binding ViewModel.FluidUI.DataBlock.Title, NotifyOnSourceUpdated=True}"
                               Grid.Column="4"
                               Grid.Row="1"/>

                    <Separator Foreground="{Binding ViewModel.FluidUI.Design.Foreground}"
                               Grid.Column="0"
                               Grid.ColumnSpan="5"
                               Grid.Row="2" />

                    <TextBlock Text="{Binding ViewModel.FluidUI.DataBlock.Text,NotifyOnSourceUpdated=True}"
                               Grid.Column="0"
                               Grid.ColumnSpan="5"
                               Grid.Row="3"/>
                </Grid>

            </ToolTip>
        </Rectangle.ToolTip>

        <Rectangle.ContextMenu>
            <ContextMenu Background="{Binding ViewModel.FluidUI.Design.Background}"
                         BorderBrush="{Binding ViewModel.FluidUI.Design.Border}"
                         Foreground="{Binding ViewModel.FluidUI.Design.Foreground}"
                         Style="{StaticResource ContextMenuStyle}">

                <TextBlock Text="{Binding ViewModel.FluidUI.DataBlock.Title, NotifyOnSourceUpdated=True}"/>

                <MenuItem Header="Duplicate"
                          Style="{StaticResource menuitem}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding DuplicationCount, UpdateSourceTrigger=Default, Delay=5}"
                                 Grid.Column="0"/>
                        <Button Content="Duplicate"
                                Command="{Binding DuplicateNTimesCommand}"
                                Grid.Column="1"/>
                    </Grid>
                </MenuItem>

                <esdkfuim:FluidUIMenuView DataContext="{Binding ViewModel.FluidUIMenuViewModel, NotifyOnSourceUpdated=True}"
                                          Style="{StaticResource menuitem}"/>

                <MenuItem Header="Delete" Command="{Binding DeleteElementCommand}" Style="{StaticResource menuitem}"/>
            </ContextMenu>
        </Rectangle.ContextMenu>
    </Rectangle>
</UserControl>

