<UserControl x:Class="EBoardSDK.Plugins.Tools.PolygonMaker.PolygonMakerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EBoardSDK.Plugins.Tools.PolygonMaker"
             d:DataContext="{d:DesignInstance Type=local:PolygonMakerViewModel}"
             FontSize="{Binding ElementViewModel.FluidUI.Font.FontSize, NotifyOnSourceUpdated=True}"
             FontFamily="{Binding ElementViewModel.FluidUI.Font.FontFamily, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
             FontWeight="{Binding ElementViewModel.FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             
             >

    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultTextBlock}" >
            <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBox}">
            <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding ElementViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>


        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding ElementViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DefaultButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="3"                            
                                CornerRadius="5" 
                                MinWidth="50"
                                MinHeight="25"
                                Margin="5"
                                Padding="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                    <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Background, NotifyOnSourceUpdated=True}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ToolTip" BasedOn="{StaticResource DefaultToolTip}">
            <Setter Property="Background" Value="{Binding ElementViewModel.FluidUI.Design.Background}"/>
            <Setter Property="BorderBrush" Value="{Binding ElementViewModel.FluidUI.Design.Border}"/>
            <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground}"/>
            <Setter Property="FontSize" Value="{Binding ElementViewModel.FluidUI.Font.FontSize}"/>
            <Setter Property="FontFamily" Value="{Binding ElementViewModel.FluidUI.Font.FontFamily, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"/>
            <Setter Property="FontWeight" Value="{Binding ElementViewModel.FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}"/>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Name}"
                   Visibility="{Binding ElementViewModel.HideControl3, Converter={StaticResource InverseVisibilityToCollapsed}}"
                   Margin="0 0 0 10"
                   Grid.Row="0"/>

        <Grid HorizontalAlignment="Center"
              Grid.Column="0"
              Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" SharedSizeGroup="B"/>
                <ColumnDefinition Width="auto" SharedSizeGroup="A"/>
                <ColumnDefinition Width="auto" SharedSizeGroup="B"/>
                <ColumnDefinition Width="auto" SharedSizeGroup="A"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="width"
                       Grid.Column="0"/>

            <TextBox Text="{Binding PanelWidth, UpdateSourceTrigger=PropertyChanged}"
                     TextAlignment="Center"
                     Grid.Column="1">
                <TextBox.InputBindings>
                    <KeyBinding Key="Execute" Command="{Binding AddPointCommand}" />
                    <KeyBinding Key="Return" Command="{Binding AddPointCommand}" />
                </TextBox.InputBindings>
            </TextBox>

            <TextBlock Text="height"
                       Margin="10 0 0 0"
                       Grid.Column="2"/>

            <TextBox Text="{Binding PanelHeight, UpdateSourceTrigger=PropertyChanged}"
                     TextAlignment="Center"
                     Grid.Column="3">
                <TextBox.InputBindings>
                    <KeyBinding Key="Execute" Command="{Binding AddPointCommand}" />
                    <KeyBinding Key="Return" Command="{Binding AddPointCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </Grid>

        <Border Background="{Binding ElementViewModel.FluidUI.Design.Foreground}"
                MinWidth="250"
                MinHeight="250"
                x:Name="polygonmakerpanel"
                Width="{Binding PanelWidth}"
                Height="{Binding PanelHeight}"
                Margin="5"
                
                Grid.Column="0"
                Grid.Row="2">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick"
                              Command="{Binding NewMousePointCommand}"
                              CommandParameter="{Binding ElementName=polygonmakerpanel}"/>
            </Border.InputBindings>
            
            <Polygon Points="{Binding PolygonPointCollection}"
                     Stroke="{Binding ElementViewModel.FluidUI.Design.Background}"/>
        </Border>

        <Grid Grid.Column="1"
              Grid.Row="1"
              Grid.RowSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBox Text="{Binding NewPoint, UpdateSourceTrigger=PropertyChanged}"
                         TextAlignment="Center"
                         Grid.Column="0"
                         Grid.ColumnSpan="3"
                         Grid.Row="0">
                <TextBox.InputBindings>
                    <KeyBinding Key="Execute" Command="{Binding AddPointCommand}" />
                    <KeyBinding Key="Return" Command="{Binding AddPointCommand}" />
                </TextBox.InputBindings>
            </TextBox>

            <Button Content="Add Point"
                        Command="{Binding AddPointCommand}"
                        Grid.Column="0"
                        Grid.Row="1"/>

            <Button Content="Edit Point"
                        Command="{Binding EditPointCommand}"
                        Grid.Column="1"
                        Grid.Row="1"/>

            <Button Content="Delete Point"
                        Command="{Binding DeletePointCommand}"
                        Grid.Column="2"
                        Grid.Row="1"/>

            <UniformGrid Rows="1"
                         Grid.Column="0"
                         Grid.ColumnSpan="3"
                         Grid.Row="2">
                <Button Content="Use Coordinates"
                        Command="{Binding UseCoordinatesPositionsCommand}"/>

                <Button Content="Create Coordinates"
                        Command="{Binding CreateCoordinatesCommand}"/>
            </UniformGrid>

            <Button Content="Create Polygon"
                        Command="{Binding CreateCommand}"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Grid.Row="3"/>

            <Button Content="Clear Points"
                     Command="{Binding ClearPointsCommand}"
                     Grid.Column="0"
                     Grid.ColumnSpan="3"
                     Grid.Row="4"/>

            <TextBlock Text="at least 3 points are required"
                           Foreground="{Binding ElementViewModel.FluidUI.Design.Highlight}"
                           Visibility="{Binding BelowMinimumPointCount, Converter={StaticResource VisibilityToCollapsed}}"
                           Grid.Column="0"
                           Grid.ColumnSpan="3"
                           Grid.Row="5"/>

            <ListBox ItemsSource="{Binding Points, NotifyOnSourceUpdated=True}"
                         SelectedItem="{Binding SelectedPoint}"
                         x:Name="PointCollectionListBox"
                     MaxHeight="{Binding PanelHeight}"
                         HorizontalContentAlignment="Center"
                     DragOver="PointCollectionListBox_DragOver"
                     DragLeave="PointCollectionListBox_DragLeave"
                     AllowDrop="True"
                         Grid.Column="0"
                         Grid.ColumnSpan="3"
                         Grid.Row="6">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <EventSetter Event="MouseMove" Handler="ListBoxItem_MouseMove" />
                        <EventSetter Event="DragOver" Handler="ListBoxItem_DragOver" />
                    </Style>
                </ListBox.ItemContainerStyle>
                
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                       Foreground="{Binding ElementViewModel.FluidUI.Design.Foreground, RelativeSource={RelativeSource AncestorType=ListBox, Mode=FindAncestor}}"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

    </Grid>
</UserControl>

<!-- EOF -->