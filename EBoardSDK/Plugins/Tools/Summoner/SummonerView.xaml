<UserControl x:Class="EBoardSDK.Plugins.Tools.Summoner.SummonerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EBoardSDK.Plugins.Tools.Summoner"
               d:DataContext="{d:DesignInstance Type=local:SummonerViewModel}"
             FontSize="{Binding ElementViewModel.FluidUI.Font.FontSize, NotifyOnSourceUpdated=True}"
             FontFamily="{Binding ElementViewModel.FluidUI.Font.FontFamily, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
             FontWeight="{Binding ElementViewModel.FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

        <Grid HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
                     Margin="{Binding ElementViewModel.FluidUI.Size.Margin}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                           Foreground="{Binding ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"
                           FontWeight="Bold"
                           Text="{Binding PluginHeader}"
                           TextWrapping="Wrap"
                       HorizontalAlignment="Center"/>

            <TextBox Grid.Row="1"
                         Text="{Binding UserCommandString, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent"
                     Foreground="{Binding ElementViewModel.FluidUI.Design.Foreground}"
                         BorderBrush="{Binding ElementViewModel.FluidUI.Design.Border}"
                         CaretBrush="{Binding ElementViewModel.FluidUI.Design.Foreground}"
                     HorizontalContentAlignment="Left"
                         MinWidth="100">

                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding ExecuteCommandStringCommand}" />
                </TextBox.InputBindings>

            </TextBox>

            <Border Grid.Row="2"
                    Margin="0 10 0 0"
                    Padding="10"
                    BorderBrush="{Binding ElementViewModel.FluidUI.Design.Border}"
                    BorderThickness="1">
                
                <ScrollViewer 
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                    <Border
                     RenderTransformOrigin="{Binding TransformOriginPoint, NotifyOnSourceUpdated=True}"
                     RenderTransform="{Binding RotateTransformValue, NotifyOnSourceUpdated=True}">

                        <Border.InputBindings>
                            <MouseBinding Gesture="Shift+LeftClick" Command="{Binding SelectCommand}"/>
                        </Border.InputBindings>

                        <Border.ContextMenu>

                            <ContextMenu Name="ElementContextMenu"
                                         Style="{StaticResource ContextMenuStyle}">

                            <Label Content="Element" Foreground="{Binding Summonee.ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>

                                <MenuItem Header="Placement"
                                          Style="{StaticResource MenuItemStyle}">

                                    <WrapPanel Orientation="Horizontal">
                                        <Label Content="R"
                               Foreground="{Binding Summonee.ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"
                           MinWidth="50"/>
                                        <Label Content="{Binding RotationAngleValue, NotifyOnSourceUpdated=True}"
                               Foreground="{Binding Summonee.ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"
                           MinWidth="30"/>
                                        <Slider Value="{Binding RotationAngleValue, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True, UpdateSourceTrigger=PropertyChanged}"
                            Minimum="-180"
                            Maximum="180"
                            Width="361"
                            SmallChange="1"
                            LargeChange="5"
                            Interval="1"
                            Orientation="Horizontal"/>

                                    </WrapPanel>

                                </MenuItem>

                                <MenuItem Header="Design"
                                           Style="{StaticResource MenuItemStyle}">

                                    <WrapPanel Orientation="Horizontal">
                                        <Label Content="Width"
                               Foreground="{Binding Summonee.ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"
                           MinWidth="50"/>
                                    <Label Content="{Binding Summonee.ElementViewModel.FluidUI.Size.Width, NotifyOnSourceUpdated=True}"
                               Foreground="{Binding Summonee.ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"
                           MinWidth="35"/>
                                    <Slider Value="{Binding Summonee.ElementViewModel.FluidUI.Size.Width, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True, UpdateSourceTrigger=PropertyChanged}"
                            Minimum="60"
                            Maximum="1024"
                            MinWidth="100"
                            SmallChange="1"
                            LargeChange="5"
                            Interval="1"
                            Orientation="Horizontal"/>

                                    </WrapPanel>


                                    <WrapPanel Orientation="Horizontal">
                                        <Label Content="Height"
                               Foreground="{Binding Summonee.ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"
                           MinWidth="50"/>
                                    <Label Content="{Binding Summonee.ElementViewModel.FluidUI.Size.Height,NotifyOnSourceUpdated=True}"
                               Foreground="{Binding Summonee.ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"
                           MinWidth="35"/>
                                    <Slider Value="{Binding Summonee.ElementViewModel.FluidUI.Size.Height, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True, UpdateSourceTrigger=PropertyChanged}"
                            Minimum="60"
                            Maximum="1024"
                            MinWidth="100"
                            SmallChange="1"
                            LargeChange="5"
                            Interval="1"
                            Orientation="Horizontal"/>

                                    </WrapPanel>

                                    <WrapPanel Orientation="Horizontal">
                                        <Label Content="Corners"
                               Foreground="{Binding Summonee.ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"
                           MinWidth="50"/>
                                        <Label Content="{Binding CornerRadiusValueSummonee, NotifyOnSourceUpdated=True}"
                               Foreground="{Binding Summonee.ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"
                           MinWidth="30"/>
                                        <Slider Value="{Binding CornerRadiusValueSummonee, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True, UpdateSourceTrigger=PropertyChanged}"
                            Minimum="0"
                            Maximum="90"
                            MinWidth="100"
                            SmallChange="1"
                            LargeChange="5"
                            Interval="1"
                            Orientation="Horizontal"/>

                                    </WrapPanel>

                                    <MenuItem Header="+Image" Command="{Binding SetImageCommand}"
                                               Style="{StaticResource MenuItemStyle}"/>

                                    <MenuItem Header="Reset" Command="{Binding ResetImageCommand}"
                                               Style="{StaticResource MenuItemStyle}"/>

                                </MenuItem>

                                <MenuItem Header="Delete" Command="{Binding DeleteElementCommand}"
                                           Style="{StaticResource MenuItemStyle}"/>

                            </ContextMenu>

                        </Border.ContextMenu>

                        <ContentPresenter Content="{Binding Summonee}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"/>
                    </Border>
                </ScrollViewer>                
            </Border>
        </Grid>
</UserControl>

<!-- EOF -->