<UserControl x:Class="EBoardSDK.Plugins.Tools.Uptime.UptimeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EBoardSDK.Plugins.Tools.Uptime"
             d:DataContext="{d:DesignInstance Type=local:UptimeViewModel}"
             FontSize="{Binding ElementViewModel.FluidUI.Font.FontSize, NotifyOnSourceUpdated=True}"
             FontFamily="{Binding ElementViewModel.FluidUI.Font.FontFamily, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
             FontWeight="{Binding ElementViewModel.FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Grid>
                            <Border Background="{Binding ElementViewModel.FluidUI.Design.Background}"
                                BorderBrush="{Binding ElementViewModel.FluidUI.Design.Border}"
                                BorderThickness="{Binding ElementViewModel.FluidUI.Design.BorderThickness}">
                                <TextBlock Text="{Binding ToolTipMessage}"
                                       Foreground="{Binding  ElementViewModel.FluidUI.Design.Foreground}"
                                       Margin="5"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"          
                     Margin="{Binding ElementViewModel.FluidUI.Size.Margin}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Grid.ColumnSpan="2"
                           Foreground="{Binding ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"
                           FontWeight="Bold"
                           Text="{Binding PluginHeader}"
                           TextWrapping="Wrap"
                       HorizontalAlignment="Center"/>

        <TextBlock Grid.Row="1"
                       
                       Grid.Column="0"        
                       Background="Transparent"
                       Padding="0 10 0 0"
                     Foreground="{Binding ElementViewModel.FluidUI.Design.Foreground}"
                         Text="now"/>

        <TextBlock Grid.Row="1"
                       Grid.Column="1"
                         Text="{Binding Clock, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent"
                       TextAlignment="Right"
                     Foreground="{Binding ElementViewModel.FluidUI.Design.Foreground}"
                       Padding="0 10 0 0"
                         MinWidth="100"/>


        <TextBlock Grid.Row="2"
                       
                       Grid.Column="0"        
                       Background="Transparent"
                       Padding="0 10 0 0"
                     Foreground="{Binding ElementViewModel.FluidUI.Design.Foreground}"     
                         Text="uptime"/>

        <TextBlock Grid.Row="2"                      
                       Grid.Column="1"
                       Text="{Binding Uptime, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="{Binding ToolTipMessage}"
                       Background="Transparent"     
                       TextAlignment="Right"         
                       VerticalAlignment="Center"         
                       Foreground="{Binding ElementViewModel.FluidUI.Design.Foreground}"
                       Padding="0 10 0 0"
                       MinWidth="100"/>
    </Grid>
</UserControl>

