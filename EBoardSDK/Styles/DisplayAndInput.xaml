<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sm="clr-namespace:EBoardSDK.SharedMethods">

    <sm:InverseBooleanToVisibilityCollapsedConverter x:Key="InverseVisibilityToCollapsed"/>
    <sm:BooleanToVisibilityCollapsedConverter x:Key="VisibilityToCollapsed"/>
    
    <Style TargetType="Grid">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style TargetType="Slider" x:Key="DefaultHorizontalSlider">
        <Setter Property="SmallChange" Value="1"/>
        <Setter Property="LargeChange" Value="5" />
        <Setter Property="Interval" Value="1"/>
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="MinWidth" Value="100"/>
    </Style>

    <Style TargetType="Slider" x:Key="DefaultVerticalSlider" BasedOn="{StaticResource DefaultHorizontalSlider}">
        <Setter Property="Orientation" Value="Vertical"/>
    </Style>

    <Style TargetType="TabControl" x:Key="DefaultTabControl">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style TargetType="TabItem" x:Key="DefaultTabItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="3 0 3 1"/>
    </Style>

    <Style TargetType="TextBlock" x:Key="DefaultTextBlock">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="MinWidth" Value="50"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style TargetType="TextBox" x:Key="DefaultTextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="MinWidth" Value="50"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="0 0 10 0"/>
    </Style>

    <Style TargetType="ToolTip" x:Key="DefaultToolTip">
        <Setter Property="BorderThickness" Value="3"/>
        <Setter Property="Padding" Value="5"/>
    </Style>
</ResourceDictionary>

<!-- EOF -->