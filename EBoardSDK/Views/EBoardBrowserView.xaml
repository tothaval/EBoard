<UserControl x:Class="EBoardSDK.Views.EBoardBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EBoardSDK.Views"
             xmlns:ut="clr-namespace:EBoardSDK.Utilities"
             xmlns:vms="clr-namespace:EBoardSDK.ViewModels" 
             xmlns:esdkfuim="clr-namespace:EBoardSDK.Controls.FluidUIMenu"
             xmlns:esdkCtrlQuadSetup="clr-namespace:EBoardSDK.Controls.QuadValueSetup"
             x:Name="EBoard_EBoardBrowser"
             d:DataContext="{d:DesignInstance Type=vms:EBoardBrowserViewModel}"
             mc:Ignorable="d" 
             ClipToBounds="True"
             d:DesignHeight="450" d:DesignWidth="800"
             FontSize="{Binding FluidUI.Font.FontSize, NotifyOnSourceUpdated=True}"
             FontFamily="{Binding FluidUI.Font.FontFamily, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
             FontWeight="{Binding FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}"
             Foreground="{Binding FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"    
             >

    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultTextBlock}" >
            <Setter Property="Foreground" Value="{Binding FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBox}">
            <Setter Property="Foreground" Value="{Binding FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="0 0 10 0"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderThickness" Value="3"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DefaultButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="3"                            
                                CornerRadius="5" 
                                MinWidth="50"
                                MinHeight="25"
                                Margin="5"
                                Padding="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                    <Setter Property="Foreground" Value="{Binding FluidUI.Design.Background, NotifyOnSourceUpdated=True}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{Binding FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <ut:VisibilityConverterToCollapsed x:Key="VisibilityToCollapsed"/>

        <Style TargetType="MenuItem" BasedOn="{StaticResource MenuItemStyle}" x:Key="menuitem">
            <Setter Property="BorderBrush" Value="{Binding FluidUI.Design.Border}"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="TextBlock.Foreground" Value="{Binding FluidUI.Design.Foreground}"/>
            <Setter Property="Foreground" Value="{Binding FluidUI.Design.Foreground}"/>
            <Setter Property="Background" Value="{Binding FluidUI.Design.Background}"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{Binding FluidUI.Design.Highlight}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Foreground" Value="{Binding FluidUI.Design.Foreground}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource MenuItemStyle}" x:Key="sub">
            <Setter Property="BorderBrush" Value="{Binding FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="TextBlock.Foreground" Value="{Binding FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="Foreground" Value="{Binding FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="Background" Value="{Binding FluidUI.Design.Background, NotifyOnSourceUpdated=True}"/>
        </Style>
    </UserControl.Resources>

    <Border Margin="{Binding FluidUI.Size.Margin, NotifyOnSourceUpdated=True}"       
            Background="{Binding FluidUI.Design.Background}"
            BorderThickness="{Binding FluidUI.Size.BorderThickness, NotifyOnSourceUpdated=True}"
            BorderBrush="{Binding FluidUI.Design.Border, NotifyOnSourceUpdated=True}"
            CornerRadius="{Binding FluidUI.Size.CornerRadius, NotifyOnSourceUpdated=True}"
            HorizontalAlignment="Left">        
        <Border.ToolTip>
            <ToolTip Content="{Binding FluidUI.DataBlock.Text,NotifyOnSourceUpdated=True}"
                     Background="{Binding FluidUI.Design.Background}"
                     BorderBrush="{Binding FluidUI.Design.Border}"
                     BorderThickness="2"
                     Padding="{Binding FluidUI.Size.Padding}"
                     Foreground="{Binding FluidUI.Design.Foreground}"
                     FontSize="{Binding FluidUI.Font.FontSize}"
                     FontFamily="{Binding FluidUI.Font.FontFamily, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
                     FontWeight="{Binding FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}">
            </ToolTip>
        </Border.ToolTip>

        <Border.ContextMenu >
            <ContextMenu Background="{Binding FluidUI.Design.Background}"
                         BorderBrush="{Binding FluidUI.Design.Border}"
                         Style="{StaticResource ContextMenuStyle}">
                <TextBlock Text="{Binding FluidUI.DataBlock.Title,NotifyOnSourceUpdated=True}"/>

                <esdkfuim:FluidUIMenuView DataContext="{Binding FluidUIMenuViewModel, NotifyOnSourceUpdated=True}"
                                          Style="{StaticResource menuitem}"
                                          SizeMenuItemVisible="False"/>

                <MenuItem Header="Delete" Command="{Binding DeleteElementCommand}" Style="{StaticResource menuitem}"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid >
            <Grid.OpacityMask>
                <VisualBrush Visual="{Binding ElementName=mask}"/>
            </Grid.OpacityMask>

            <Border Name="mask"
            Background="{Binding FluidUI.Design.Background}"
            CornerRadius="{Binding FluidUI.Size.CornerRadius, NotifyOnSourceUpdated=True}" />

            <Border Padding="{Binding FluidUI.Size.Padding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Margin="5 10 0 0"
                                   Grid.Row="0">
                            <Run Text="Selected: "/>
                            <Run Text="{Binding SelectedEBoard.FluidUI.DataBlock.Title}"/>
                            <Run Text="{Binding CurrentSelectionID, NotifyOnSourceUpdated=True}"/>
                            <Run Text="/"/>
                            <Run Text="{Binding EBoardCount, NotifyOnSourceUpdated=True}"/>
                        </TextBlock>

                        <ScrollViewer CanContentScroll="True"
                                      VerticalScrollBarVisibility="Auto"
                                      MaxWidth="320"
                                      MaxHeight="160"
                                      Margin="0 0 0 0"
                                      Grid.Row="1">

                            <ListBox ItemsSource="{Binding EBoards}"
                                     Background="Transparent"
                                     BorderBrush="Transparent"
                                     SelectedItem="{Binding SelectedEBoard, NotifyOnSourceUpdated=True}">

                                <ListBox.ContextMenu>
                                    <ContextMenu Background="{Binding FluidUI.Design.Background}"
                                             Style="{StaticResource ContextMenuStyle}"
                                                 BorderBrush="{Binding FluidUI.Design.Border}" >
                                        
                                        <Label Content="Screen Panel" Background="Transparent"
                                               Foreground="{Binding FluidUI.Design.Foreground}"/>
                                        
                                        <MenuItem Header="Delete Selected" Style="{StaticResource menuitem}"
                                              Command="{Binding DeleteEBoardCommand}"/>
                                        
                                        <MenuItem Header="Delete All" Style="{StaticResource menuitem}"
                                              Command="{Binding DeleteAllScreensCommand}"/>
                                        
                                    </ContextMenu>
                                </ListBox.ContextMenu>

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel x:Name="wp_eBoardBrowser"
                                           MaxWidth="300"
                                   Background="Transparent"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Stretch"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!--<local:EBoardView Content="{Binding }" MaxHeight="50" MaxWidth="50"/>-->

                                        <Border Background="{Binding FluidUI.Design.Background}"
                                                CornerRadius="10"
                                                BorderBrush="{Binding FluidUI.Design.Border}"
                                                BorderThickness="3">
                                            <Grid VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SelectedEBoard.FluidUI.DataBlock.Title, NotifyOnSourceUpdated=True}"
                                                           Padding="0 10 0 0"
                                                           MinWidth="42"
                                                           MinHeight="42"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </Grid>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Button Content="Add EBoard"
                                Command="{Binding AddEBoardCommand}"
                                Grid.Row="0"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="100"/>
                                <ColumnDefinition Width="Auto" MinWidth="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Name"
                                       Grid.Column="0"
                                       Grid.Row="0"/>

                            <TextBox Text="{Binding SelectedEBoard.FluidUI.DataBlock.Title,
                                NotifyOnSourceUpdated=True,
                                UpdateSourceTrigger=LostFocus}"
                                     Grid.Column="1"
                                     Grid.Row="0"/>

                            <TextBlock Text="Depth"
                                       Grid.Column="0"
                                       Grid.Row="1"/>
                            
                            <TextBox Text="{Binding EBoardDepth,
                                NotifyOnSourceUpdated=True,
                                UpdateSourceTrigger=LostFocus}"
                                     Grid.Column="1"
                                     Grid.Row="1"/>

                            <TextBlock Text="Width"
                                       Grid.Column="0"
                                       Grid.Row="2"/>
                            
                            <TextBox Text="{Binding NewEBoardWidth,
                                NotifyOnSourceUpdated=True,
                                UpdateSourceTrigger=LostFocus}"
                                     Grid.Column="1"
                                     Grid.Row="2"/>

                            <TextBlock Text="Height"
                                       Grid.Column="0"
                                       Grid.Row="3"/>
                            
                            <TextBox Text="{Binding NewEBoardHeight,
                                NotifyOnSourceUpdated=True,
                                UpdateSourceTrigger=LostFocus}"
                                     Grid.Column="1"
                                     Grid.Row="3"/>

                            <Button Content="Edit EBoard"
                                    Margin="5 0 0 0"
                                    Command="{Binding EditEBoardParametersCommand}"
                                    Grid.Column="2"
                                    Grid.Row="0"
                                    Grid.RowSpan="6"/>

                            <TextBlock Text="Created"
                                       Grid.Column="0"
                                       Grid.Row="4"/>
                            
                            <TextBlock Text="{Binding EBoardCreatedDate,
                                NotifyOnSourceUpdated=True}"
                                       Grid.Column="1"
                                       Grid.Row="4"/>

                            <TextBlock Text="Active"
                                       Grid.Column="0"
                                       Grid.Row="5"/>
                            
                            <TextBlock Grid.Column="1"
                                       Grid.Row="5">
                                
                                <Run Text="{Binding EBoardContainerCount, NotifyOnSourceUpdated=True}"/>
                                <Run Text="elements"/>
                                <Run Text=":"/>
                                <Run Text="{Binding EBoardElementCount, NotifyOnSourceUpdated=True}"/>
                                <Run Text="plugins" />
                                <Run Text="&amp;"/>
                                <Run Text="{Binding EBoardShapeCount, NotifyOnSourceUpdated=True}"/>
                                <Run Text="shapes" />
                            </TextBlock>
                        </Grid>

                        <Button Content="Delete EBoard"
                                Command="{Binding DeleteEBoardCommand}"
                                Grid.Row="2"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

