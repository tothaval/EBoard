<UserControl x:Class="EBoardSDK.Views.ElementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EBoardSDK.Views"
             xmlns:vms="clr-namespace:EBoardSDK.ViewModels"
             xmlns:esdkfuim="clr-namespace:EBoardSDK.Controls.FluidUIMenu"
             xmlns:esdkCtrlQuadSetup="clr-namespace:EBoardSDK.Controls.QuadValueSetup"
             d:DataContext="{d:DesignInstance Type=vms:ElementViewModel}"
             x:Name="Element"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             FontSize="{Binding FluidUI.Font.FontSize, NotifyOnSourceUpdated=True}"
             FontFamily="{Binding FluidUI.Font.FontFamily, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
             FontWeight="{Binding FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}"
             Foreground="{Binding FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"
             Opacity="{Binding FluidUI.Design.Opacity, NotifyOnSourceUpdated=True}"
             Loaded="Element_Loaded"
             Unloaded="Element_Unloaded"
             
             AllowDrop="True"
             Drop="Element_Drop">

    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultTextBlock}" >
            <Setter Property="Foreground" Value="{Binding FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="MinWidth" Value="25"/>
        </Style>

        <Style TargetType="MenuItem" BasedOn="{StaticResource MenuItemStyle}" x:Key="menuitem">
            <Setter Property="BorderBrush" Value="{Binding FluidUI.Design.Border}"/>
            <Setter Property="TextBlock.Foreground" Value="{Binding FluidUI.Design.Foreground}"/>
            <Setter Property="Foreground" Value="{Binding FluidUI.Design.Foreground}"/>
            <Setter Property="Background" Value="{Binding FluidUI.Design.Background}"/>

            <Style.Triggers>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter Property="Foreground" Value="{Binding FluidUI.Design.Highlight}"/>
                </Trigger>

                <Trigger Property="IsSubmenuOpen" Value="false">
                    <Setter Property="Foreground" Value="{Binding FluidUI.Design.Foreground}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{Binding FluidUI.Design.Highlight}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Foreground" Value="{Binding FluidUI.Design.Foreground}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource MenuItemStyle}" x:Key="sub">
            <Setter Property="BorderBrush" Value="{Binding FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="TextBlock.Foreground" Value="{Binding FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="Foreground" Value="{Binding FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="Background" Value="{Binding FluidUI.Design.Background, NotifyOnSourceUpdated=True}"/>
        </Style>

        <Style TargetType="ToolTip" BasedOn="{StaticResource DefaultToolTip}">
            <Setter Property="Background" Value="{Binding FluidUI.Design.Background}"/>
            <Setter Property="BorderBrush" Value="{Binding FluidUI.Design.Border}"/>
            <Setter Property="Foreground" Value="{Binding FluidUI.Design.Foreground}"/>
            <Setter Property="FontSize" Value="{Binding FluidUI.Font.FontSize}"/>
            <Setter Property="FontFamily" Value="{Binding FluidUI.Font.FontFamily, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"/>
            <Setter Property="FontWeight" Value="{Binding FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}"/>
        </Style>
    </UserControl.Resources>

    <Border MouseLeftButtonDown="Border_MouseLeftButtonDown"
            MouseLeftButtonUp="Border_MouseLeftButtonUp"
            MouseMove="Border_MouseMove"
            MouseWheel="Border_MouseWheel"
            x:Name="ElementBorder"
            ClipToBounds="True"
            SnapsToDevicePixels="True">

        <Border.LayoutTransform>
            <TransformGroup>
            </TransformGroup>
        </Border.LayoutTransform>

        <Border.RenderTransform>
            <TransformGroup>
                <!--<TranslateTransform X="{Binding FluidUI.Stand.Position.X}"
                                    Y="{Binding FluidUI.Stand.Position.Y}"/>-->

                <ScaleTransform ScaleX="{Binding FluidUI.Size.ScaleX}"
                                ScaleY="{Binding FluidUI.Size.ScaleY}"/>

                <SkewTransform AngleX="{Binding FluidUI.Stand.SkewAngleX}"
                               AngleY="{Binding FluidUI.Stand.SkewAngleY}"
                               CenterX="{Binding FluidUI.Stand.SkewCenterPoint.X}"
                               CenterY="{Binding FluidUI.Stand.SkewCenterPoint.Y}"/>

                <RotateTransform Angle="{Binding FluidUI.Stand.Angle}"
                                 CenterX="{Binding FluidUI.Stand.TransformOriginPoint.X}"
                                 CenterY="{Binding FluidUI.Stand.TransformOriginPoint.Y}"/>
            </TransformGroup>
        </Border.RenderTransform>

        <Border.InputBindings>
            <MouseBinding Gesture="Shift+LeftClick" Command="{Binding SelectCommand}"/>
        </Border.InputBindings>

        <Border.Resources>
            <Style TargetType="MenuItem" BasedOn="{StaticResource ContextMenuItem}">
                <Setter Property="BorderBrush" Value="{Binding FluidUI.Design.Border}"/>
                <Setter Property="Background" Value="{Binding FluidUI.Design.Background}"/>
            </Style>
        </Border.Resources>

        <Border.ToolTip>
            <ToolTip Visibility="{Binding FluidUI.DataBlock.ShowToolTip, NotifyOnSourceUpdated=True, Converter={StaticResource VisibilityToCollapsed}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto" SharedSizeGroup="stand1"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto" SharedSizeGroup="stand2"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto" SharedSizeGroup="stand3"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="x"
                               Grid.Column="0"
                               Grid.Row="0"/>
                    <Border BorderBrush="{Binding FluidUI.Design.Border}"
                            BorderThickness="0 0 2 0"
                            Margin="0 0 5 0"
                            Grid.Column="1"
                            Grid.Row="0">
                        <TextBlock Text="{Binding FluidUI.Stand.Position.X, NotifyOnSourceUpdated=True}"
                                   TextAlignment="Right"
                                   Padding="0 0 5 0"/>
                    </Border>

                    <TextBlock Text="y"
                               Grid.Column="0"
                               Grid.Row="1"/>
                    <Border BorderBrush="{Binding FluidUI.Design.Border}"
                            BorderThickness="0 0 2 0"
                            Margin="0 0 5 0"
                            Grid.Column="1"
                            Grid.Row="1">
                        <TextBlock Text="{Binding FluidUI.Stand.Position.Y, NotifyOnSourceUpdated=True}"
                                   TextAlignment="Right"
                                   Padding="0 0 5 0"/>
                    </Border>

                    <TextBlock Text="z"
                               Grid.Column="2"
                               Grid.Row="0"/>
                    <Border BorderBrush="{Binding FluidUI.Design.Border}"
                            BorderThickness="0 0 2 0"
                            Margin="0 0 5 0"
                            Grid.Column="3"
                            Grid.Row="0">
                        <TextBlock Text="{Binding FluidUI.Stand.Z, NotifyOnSourceUpdated=True}"
                                   TextAlignment="Right"
                                   Padding="0 0 5 0"/>
                    </Border>

                    <TextBlock Text="°"
                               Grid.Column="2"
                               Grid.Row="1"/>
                    <Border BorderBrush="{Binding FluidUI.Design.Border}"
                            BorderThickness="0 0 2 0"
                            Margin="0 0 5 0"
                            Grid.Column="3"
                            Grid.Row="1">
                        <TextBlock Text="{Binding FluidUI.Stand.Angle, NotifyOnSourceUpdated=True}"
                                   TextAlignment="Right"
                                   Padding="0 0 5 0"/>
                    </Border>

                    <TextBlock Text="°X"
                               Grid.Column="4"
                               Grid.Row="0"/>
                    
                    <Border BorderBrush="{Binding FluidUI.Design.Border}"
                            BorderThickness="0 0 2 0"
                            Margin="0 0 5 0"
                            Grid.Column="5"
                            Grid.Row="0">
                        <TextBlock Text="{Binding FluidUI.Stand.SkewAngleX, NotifyOnSourceUpdated=True, StringFormat=N2}"
                                   TextAlignment="Right"
                                   Padding="0 0 5 0"/>
                    </Border>

                    <TextBlock Text="°Y"
                               Grid.Column="4"
                               Grid.Row="1"/>
                    <Border BorderBrush="{Binding FluidUI.Design.Border}"
                            BorderThickness="0 0 2 0"
                            Margin="0 0 5 0"
                            Grid.Column="5"
                            Grid.Row="1">
                        <TextBlock Text="{Binding FluidUI.Stand.SkewAngleY, NotifyOnSourceUpdated=True, StringFormat=N2}"
                                   TextAlignment="Right"
                                   Padding="0 0 5 0"/>
                    </Border>

                    <TextBlock Text="{Binding Plugin.Name, NotifyOnSourceUpdated=True, Mode=OneWay}"
                               Grid.Column="6"
                               Grid.Row="0"/>
                    
                    <TextBlock Text="{Binding FluidUI.DataBlock.Title, NotifyOnSourceUpdated=True}"
                               Grid.Column="6"
                               Grid.Row="1"/>

                    <Separator Foreground="{Binding FluidUI.Design.Foreground}"
                               Grid.Column="0"
                               Grid.ColumnSpan="5"
                               Grid.Row="2" />

                    <TextBlock Text="{Binding FluidUI.DataBlock.Text,NotifyOnSourceUpdated=True}"
                               Grid.Column="0"
                               Grid.ColumnSpan="5"
                               Grid.Row="3"/>
                </Grid>

            </ToolTip>
        </Border.ToolTip>

        <Border.ContextMenu >
            
            <ContextMenu Background="{Binding FluidUI.Design.Background}"
                         BorderBrush="{Binding FluidUI.Design.Border}"
                         Visibility="{Binding Plugin.HideElement, Converter={StaticResource InverseVisibilityToCollapsed}}"
                         Style="{StaticResource ContextMenuStyle}">
                <TextBlock Text="{Binding FluidUI.DataBlock.Title, NotifyOnSourceUpdated=True}"/>

                <MenuItem Header="{Binding Plugin.Name}"
                          Style="{StaticResource menuitem}"
                          Visibility="{Binding Plugin.MenuItemSet, Converter={StaticResource VisibilityToCollapsed}}">

                    <ContentPresenter Content="{Binding Plugin.MenuItem}"
                                      DataContext="{Binding Plugin.MenuItemViewModel}"/>
                </MenuItem>

                <MenuItem Header="Element"
                          Style="{StaticResource menuitem}">

                    <MenuItem Header="Duplicate"
                              Visibility="{Binding CopyAllowed, Converter={StaticResource VisibilityToCollapsed}}"
                              Style="{StaticResource menuitem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding DuplicationCount, UpdateSourceTrigger=Default, Delay=5}"
                                     Grid.Column="0"/>
                            <Button Content="Duplicate"
                                    Command="{Binding DuplicateNTimesCommand}"
                                    Grid.Column="1"/>
                        </Grid>
                    </MenuItem>

                    <MenuItem Header="Copy"
                              Visibility="{Binding CopyAllowed, Converter={StaticResource VisibilityToCollapsed}}"
                          Command="{Binding CopyCommand}"
                          Style="{StaticResource menuitem}"/>

                    <MenuItem Header="Move"
                              Visibility="{Binding CopyAllowed, Converter={StaticResource VisibilityToCollapsed}}"
                          Command="{Binding MoveCommand}"
                          Style="{StaticResource menuitem}"/>

                    <MenuItem Header="Save"
                          Command="{Binding SaveCommand}"
                          Style="{StaticResource menuitem}"/>

                    <MenuItem Header="Select"
                          Command="{Binding SelectCommand}"
                          Style="{StaticResource menuitem}"/>

                    <MenuItem Header="Delete"
                          Command="{Binding DeleteCommand}"
                          Style="{StaticResource menuitem}"/>
                </MenuItem>

                <esdkfuim:FluidUIMenuView DataContext="{Binding FluidUIMenuViewModel, NotifyOnSourceUpdated=True}"
                                          Style="{StaticResource menuitem}"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid Background="Transparent" >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Border
                Background="{Binding FluidUI.Design.Background, NotifyOnSourceUpdated=True}"
                BorderBrush="{Binding FluidUI.Design.Border,NotifyOnSourceUpdated=True}"
                BorderThickness="{Binding FluidUI.Size.BorderThickness, NotifyOnSourceUpdated=True}"
                CornerRadius="{Binding FluidUI.Size.CornerRadius, NotifyOnSourceUpdated=True}"
            
                Margin="{Binding FluidUI.Size.Margin, NotifyOnSourceUpdated=True}"
                Padding="{Binding FluidUI.Size.Padding, NotifyOnSourceUpdated=True}"

                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                IsHitTestVisible="True"                
                MinHeight="10"
                MinWidth="10">

                <Grid>
                    <!--<Border Name="mask"
                    Background="{Binding Plugin.BrushManagement.Background, NotifyOnSourceUpdated=True}"
                    CornerRadius="{Binding Plugin.BorderManagement.CornerRadius, NotifyOnSourceUpdated=True}"
      
                    />-->

                    <Grid Width="{Binding FluidUI.Size.Width, NotifyOnSourceUpdated=True}"
                          Height="{Binding FluidUI.Size.Height, NotifyOnSourceUpdated=True}">

                        <!--<Grid.OpacityMask>
                            <VisualBrush Visual="{Binding ElementName=mask}"/>
                        </Grid.OpacityMask>-->

                        <ContentPresenter Content="{Binding Plugin}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

<!-- EOF -->