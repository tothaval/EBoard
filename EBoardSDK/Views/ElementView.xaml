<UserControl x:Class="EBoardSDK.Views.ElementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EBoardSDK.Views"
             xmlns:vms="clr-namespace:EBoardSDK.ViewModels"
             xmlns:ut="clr-namespace:EBoardSDK.Utilities"
             xmlns:esdkfuim="clr-namespace:EBoardSDK.Controls.FluidUIMenu"
             xmlns:esdkCtrlQuadSetup="clr-namespace:EBoardSDK.Controls.QuadValueSetup"
             d:DataContext="{d:DesignInstance Type=vms:ElementViewModel}"
             x:Name="Element"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             FontSize="{Binding FluidUI.Font.FontSize, NotifyOnSourceUpdated=True}"
             FontFamily="{Binding FluidUI.Font.FontFamily, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
             FontWeight="{Binding FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}"
             Foreground="{Binding FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"
             Loaded="Element_Loaded"
             Unloaded="Element_Unloaded">

    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultTextBlock}" >
            <Setter Property="Foreground" Value="{Binding FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBox}">
            <Setter Property="Foreground" Value="{Binding FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="0 0 10 0"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderThickness" Value="3"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DefaultButtonBorder"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="3"                            
                          CornerRadius="5" 
                          MinWidth="50"
                          MinHeight="25"
                          Margin="5"
                          Padding="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                    <Setter Property="Foreground" Value="{Binding FluidUI.Design.Background, NotifyOnSourceUpdated=True}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{Binding FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <ut:VisibilityConverterToCollapsed x:Key="VisibilityToCollapsed"/>

        <Style TargetType="MenuItem" BasedOn="{StaticResource MenuItemStyle}" x:Key="menuitem">
            <Setter Property="BorderBrush" Value="{Binding FluidUI.Design.Border}"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="TextBlock.Foreground" Value="{Binding FluidUIDesign.Foreground}"/>
            <Setter Property="Foreground" Value="{Binding FluidUI.Design.Foreground}"/>
            <Setter Property="Background" Value="{Binding FluidUI.Design.Background}"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{Binding FluidUI.Design.Highlight}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Foreground" Value="{Binding FluidUI.Design.Foreground}"/>
                </Trigger>
            </Style.Triggers>

        </Style>

        <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource MenuItemStyle}" x:Key="sub">
            <Setter Property="BorderBrush" Value="{Binding FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="TextBlock.Foreground" Value="{Binding FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="Foreground" Value="{Binding FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="Background" Value="{Binding FluidUI.Design.Background, NotifyOnSourceUpdated=True}"/>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}" x:Key="MenuButtonStyle">
            <Setter Property="Foreground" Value="{Binding FluidUI.Design.Foreground}"/>
            <Setter Property="Background" Value="{Binding FluidUI.Design.Background}"/>
            <Setter Property="BorderBrush" Value="{Binding FluidUI.Design.Border}"/>
        </Style>
    </UserControl.Resources>

    <Border MouseLeftButtonDown="Border_MouseLeftButtonDown"
            MouseLeftButtonUp="Border_MouseLeftButtonUp"
            MouseMove="Border_MouseMove"
            MouseWheel="Border_MouseWheel"
            x:Name="ElementBorder"
            RenderTransformOrigin="{Binding FluidUIMenuViewModel.FluidUIStandSetupViewModel.TransformOriginPoint, NotifyOnSourceUpdated=True}"
            RenderTransform="{Binding FluidUIMenuViewModel.FluidUIStandSetupViewModel.RotateTransformValue, NotifyOnSourceUpdated=True}"
            ClipToBounds="True">

        <Border.InputBindings>
            <MouseBinding Gesture="Shift+LeftClick" Command="{Binding SelectCommand}"/>
        </Border.InputBindings>

        <Border.Resources>
            <Style TargetType="MenuItem" BasedOn="{StaticResource ContextMenuItem}">
                <Setter Property="BorderBrush" Value="{Binding FluidUI.Design.Border}"/>
                <Setter Property="BorderThickness" Value="5"/>
                <Setter Property="Foreground" Value="Red"/>
                <Setter Property="Background" Value="{Binding FluidUI.Design.Background}"/>
            </Style>
        </Border.Resources>
        
        <Border.ToolTip>
            <ToolTip Content="{Binding FluidUI.DataBlock.Text,NotifyOnSourceUpdated=True}"
                     Background="{Binding FluidUI.Design.Background}"
                     BorderBrush="{Binding FluidUI.Design.Border}"
                     BorderThickness="2"
                     Padding="{Binding FluidUI.Size.Padding}"
                     Foreground="{Binding FluidUI.Design.Foreground}"
                     FontSize="{Binding FluidUI.Font.FontSize}"
                     FontFamily="{Binding FluidUI.Font.FontFamily, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
                     FontWeight="{Binding FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}">
            </ToolTip>
        </Border.ToolTip>

        <Border.ContextMenu >
            <ContextMenu Background="{Binding FluidUI.Design.Background}"
                         BorderBrush="{Binding FluidUI.Design.Border}"
                         Style="{StaticResource ContextMenuStyle}">
                <TextBlock Text="{Binding FluidUI.DataBlock.Title,NotifyOnSourceUpdated=True}"/>

                <MenuItem Header="Arrange" Style="{StaticResource menuitem}">

                    <WrapPanel Orientation="Vertical">
                        <WrapPanel Orientation="Horizontal">
                            <Label Content="Arrangement Rotation"/>
                            <Label Content="{Binding EBoardViewModel.EBoardSettingsViewModel.ArrangementRotationValue, NotifyOnSourceUpdated=True}"/>
                        </WrapPanel>
                        <Slider Value="{Binding EBoardViewModel.EBoardSettingsViewModel.ArrangementRotationValue, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True, UpdateSourceTrigger=PropertyChanged}"
                            Minimum="-90"
                            Maximum="90"
                            Width="361"
                            SmallChange="1"
                            LargeChange="5"
                            Interval="1"
                            Orientation="Horizontal"/>
                    </WrapPanel>

                    <WrapPanel Orientation="Vertical">
                        <WrapPanel Orientation="Horizontal">
                            <Label Content="Arrangement Offset"
                           MinWidth="50"/>
                            <Label Content="{Binding EBoardViewModel.EBoardSettingsViewModel.ArrangementOffsetValue, NotifyOnSourceUpdated=True}"
                               MinWidth="30"/>
                        </WrapPanel>
                        <Slider Value="{Binding EBoardViewModel.EBoardSettingsViewModel.ArrangementOffsetValue, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True, UpdateSourceTrigger=PropertyChanged}"
                            Minimum="-90"
                            Maximum="90"
                            Width="361"
                            SmallChange="1"
                            LargeChange="5"
                            Interval="1"
                            Orientation="Horizontal"/>
                    </WrapPanel>

                    <Rectangle StrokeThickness="1" Stroke="{Binding FluidUI.Design.Border}" HorizontalAlignment="Stretch"/>

                    <WrapPanel Orientation="Horizontal">
                        <Button Content="Line" Command="{Binding ArrangeGroupAsLineCommand}" Style="{StaticResource DefaultButtonStyle}"/>
                        <Button Content="Square" Command="{Binding ArrangeGroupAsSquareCommand}" Style="{StaticResource DefaultButtonStyle}"/>
                        <Button Content="Random 10x10" Command="{Binding ArrangeGroupAsRandomMatrix10x10Command}" Style="{StaticResource DefaultButtonStyle}"/>
                    </WrapPanel>
                </MenuItem>

                <esdkfuim:FluidUIMenuView DataContext="{Binding FluidUIMenuViewModel, NotifyOnSourceUpdated=True}"
                                              Style="{StaticResource menuitem}"/>

                <MenuItem Header="Delete" Command="{Binding DeleteElementCommand}" Style="{StaticResource menuitem}"/>

            </ContextMenu>
        </Border.ContextMenu>

        <Grid Background="Transparent" >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Border
                Background="{Binding FluidUI.Design.Background, NotifyOnSourceUpdated=True}"
                BorderBrush="{Binding FluidUI.Design.Border,NotifyOnSourceUpdated=True}"
                BorderThickness="{Binding FluidUI.Size.BorderThickness, NotifyOnSourceUpdated=True}"
                CornerRadius="{Binding FluidUI.Size.CornerRadius, NotifyOnSourceUpdated=True}"
            
                Margin="{Binding FluidUI.Size.Margin, NotifyOnSourceUpdated=True}"
                Padding="{Binding FluidUI.Size.Padding, NotifyOnSourceUpdated=True}"
            
                MouseLeftButtonDown="Border_MouseLeftButtonDown_1"
                MouseLeftButtonUp="Border_MouseLeftButtonUp_1"
                MouseMove="Border_MouseMove_1"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                IsHitTestVisible="True"
                
                MinHeight="60"
                MinWidth="60">
                <Grid>

                    <!--<Border Name="mask"
                    Background="{Binding Plugin.BrushManagement.Background, NotifyOnSourceUpdated=True}"
                    CornerRadius="{Binding Plugin.BorderManagement.CornerRadius, NotifyOnSourceUpdated=True}"
      
                    />-->

                    <Grid 
                Width="{Binding FluidUI.Size.Width, NotifyOnSourceUpdated=True}"
                Height="{Binding FluidUI.Size.Height, NotifyOnSourceUpdated=True}">

                        <!--<Grid.OpacityMask>
                            <VisualBrush Visual="{Binding ElementName=mask}"/>
                        </Grid.OpacityMask>-->

                        <ContentPresenter Content="{Binding Plugin}" />

                    </Grid>

                </Grid>
            </Border>

            <TextBlock Foreground="{Binding FluidUI.Design.Highlight}"
                       MinWidth="30"
                       Text="{Binding FluidUIMenuViewModel.FluidUIStandSetupViewModel.ZIndexValue, NotifyOnSourceUpdated=True}"
                       TextWrapping="Wrap"
                       Margin="5 0 0 0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Grid.Row="0"/>

            <TextBlock Foreground="{Binding FluidUI.Design.Highlight}"
                       Text="{Binding FluidUIMenuViewModel.FluidUIStandSetupViewModel.RotationAngleValue, NotifyOnSourceUpdated=True}"
                       TextWrapping="Wrap"
                       Margin="0 0 5 0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Grid.Row="0"/>
        </Grid>
    </Border>
</UserControl>

<!-- EOF -->