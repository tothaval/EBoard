<UserControl x:Class="EBoardSDK.Views.MainWindowMenuBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:eboard="clr-namespace:EBoardSDK"
             xmlns:vms="clr-namespace:EBoardSDK.ViewModels"
             xmlns:views="clr-namespace:EBoardSDK.Views"
             d:DataContext="{d:DesignInstance Type=vms:MainWindowMenuBarViewModel}"
             FontSize="{Binding MainViewModel.FluidUI.Font.FontSize, NotifyOnSourceUpdated=True}"
             FontFamily="{Binding MainViewModel.FluidUI.Font.FontFamily,NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
             FontWeight="{Binding MainViewModel.FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="mainwindowmenubarname">

    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultTextBlock}" >
            <Setter Property="Foreground" Value="{Binding MainViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBox}">
            <Setter Property="Foreground" Value="{Binding MainViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding MainViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="0 0 10 0"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding MainViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding MainViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderThickness" Value="3"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DefaultButtonBorder"
                   Background="{TemplateBinding Background}"
                   BorderBrush="{TemplateBinding BorderBrush}"
                   BorderThickness="3"                            
                   CornerRadius="5" 
                   MinWidth="50"
                   MinHeight="25"
                   Margin="5"
                   Padding="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding MainViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                    <Setter Property="Foreground" Value="{Binding MainViewModel.FluidUI.Design.Background, NotifyOnSourceUpdated=True}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{Binding MainViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ToggleButton">

            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>

            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding MainViewModel.FluidUI.Design.Foreground}"/>
            <Setter Property="BorderBrush" Value="{Binding MainViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderThickness" Value="3"/>

            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="DefaultButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="3"                            
                                CornerRadius="5" 
                                MinWidth="50"
                                MinHeight="25"
                                Margin="5"
                                Padding="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background"
                                    TargetName="DefaultButtonBorder"
                                    Value="{Binding MainViewModel.FluidUI.Design.Highlight}"/>
                                <!--<Setter Property="Foreground"
                                        Value="{Binding MainViewModel.FluidUI.Design.Highlight}"/>-->
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding MainViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                    <Setter Property="Foreground" Value="{Binding MainViewModel.FluidUI.Design.Background, NotifyOnSourceUpdated=True}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{Binding MainViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="MenuItem" BasedOn="{StaticResource MenuItemStyle}" x:Key="menuitem">
            <Setter Property="BorderBrush" Value="{Binding ScreenBrushManagement.Border}"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="TextBlock.Foreground" Value="{Binding ScreenBrushManagement.Foreground}"/>
            <Setter Property="Foreground" Value="{Binding ScreenBrushManagement.Foreground}"/>
            <Setter Property="Background" Value="{Binding ScreenBrushManagement.Background}"/>
            <Setter Property="FontSize" Value="{Binding ScreenFontManagement.FontSize, NotifyOnSourceUpdated=True}" />
            <Setter Property="FontFamily" Value="{Binding ScreenFontManagement.FontFamily, NotifyOnTargetUpdated=True, NotifyOnSourceUpdated=True}" />
            <Setter Property="FontWeight" Value="{Binding ScreenFontManagement.FontWeight, NotifyOnTargetUpdated=True, NotifyOnSourceUpdated=True}" />

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{Binding ScreenBrushManagement.Highlight}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Foreground" Value="{Binding ScreenBrushManagement.Foreground}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="MenuItem" x:Key="PluginLogoMenuItem">
            <Setter Property="Command" Value="{Binding DataContext.InvokePluginCommand, RelativeSource={RelativeSource AncestorType=Menu}}"/>
            <Setter Property="CommandParameter" Value="{Binding}" />

            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{Binding ScreenBrushManagement.Foreground, NotifyOnSourceUpdated=True, RelativeSource={RelativeSource AncestorType=Menu}}"/>
            <Setter Property="FontSize" Value="{Binding ScreenFontManagement.FontSize, NotifyOnSourceUpdated=True}" />
            <Setter Property="FontFamily" Value="{Binding ScreenFontManagement.FontFamily, NotifyOnTargetUpdated=True, NotifyOnSourceUpdated=True}" />
            <Setter Property="FontWeight" Value="{Binding ScreenFontManagement.FontWeight, NotifyOnTargetUpdated=True, NotifyOnSourceUpdated=True}" />
            
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid Background="Transparent"
                              Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Fill="{Binding PluginLogo}"
                                       MinWidth="25"
                                       MinHeight="25"
                                       Grid.Column="0"/>
                            <TextBlock Text="{Binding PluginHeader}"
                                       Foreground="{Binding DataContext.MainWindowMenuBarVM.ScreenBrushManagement.Foreground, RelativeSource={RelativeSource AncestorType=eboard:MainWindow, Mode=FindAncestor}}"
                                       FontSize="{Binding DataContext.MainWindowMenuBarVM.ScreenFontManagement.FontSize, RelativeSource={RelativeSource AncestorType=eboard:MainWindow, Mode=FindAncestor}}"
                                       FontFamily="{Binding DataContext.MainWindowMenuBarVM.ScreenFontManagement.FontFamily, RelativeSource={RelativeSource AncestorType=eboard:MainWindow, Mode=FindAncestor}}"
                                       FontWeight="{Binding DataContext.MainWindowMenuBarVM.ScreenFontManagement.FontWeight, RelativeSource={RelativeSource AncestorType=eboard:MainWindow, Mode=FindAncestor}}"                                       
                                       Grid.Column="1">
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{Binding ScreenBrushManagement.Highlight, NotifyOnSourceUpdated=True}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Foreground" Value="{Binding ScreenBrushManagement.Foreground, NotifyOnSourceUpdated=True}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Left">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <ToggleButton Content="Eboard Browser"
                      FontSize="{Binding MainViewModel.FluidUI.Font.FontSize, NotifyOnSourceUpdated=True}"
                      IsChecked="{Binding EBoardBrowserSwitch,
                NotifyOnSourceUpdated=True,
                UpdateSourceTrigger=PropertyChanged}"
                      Grid.Column="0"/>

        <ToggleButton Content="Screen Control"
                      FontSize="{Binding MainViewModel.FluidUI.Font.FontSize, NotifyOnSourceUpdated=True}"    
                      IsChecked="{Binding ScreenControlSwitch,
                NotifyOnSourceUpdated=True,
                UpdateSourceTrigger=PropertyChanged}"
                      Grid.Column="1"/>

        <Border Background="{Binding ScreenBrushManagement.Background}"
                BorderBrush="{Binding ScreenBrushManagement.Border}"
                BorderThickness="3"
                CornerRadius="5"
                Grid.Column="2">
            <Menu Foreground="{Binding ScreenBrushManagement.Foreground}"
                  Background="Transparent">
                <MenuItem Header="Addons"
                          Style="{StaticResource menuitem}"
                          ItemsSource="{Binding FoundAddons}"
                          ItemContainerStyle="{StaticResource PluginLogoMenuItem}"/>
                <MenuItem Header="Elements"
                          Style="{StaticResource menuitem}"
                          ItemsSource="{Binding FoundElements}"
                          ItemContainerStyle="{StaticResource PluginLogoMenuItem}"/>
                <MenuItem Header="Shapes"
                          Style="{StaticResource menuitem}"
                          ItemsSource="{Binding FoundShapes}"
                          ItemContainerStyle="{StaticResource PluginLogoMenuItem}"/>
                <MenuItem Header="Areas"
                          Style="{StaticResource menuitem}"
                          ItemsSource="{Binding FoundAreas}"
                          ItemContainerStyle="{StaticResource PluginLogoMenuItem}"/>
                <MenuItem Header="Tools"
                          Style="{StaticResource menuitem}"
                          ItemsSource="{Binding FoundTools, NotifyOnSourceUpdated=True}"
                          ItemContainerStyle="{StaticResource PluginLogoMenuItem}"/>
            </Menu>
        </Border>
    </Grid>
</UserControl>

<!-- EOF -->