<UserControl x:Class="EBoardSDK.Views.ScreenControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EBoardSDK.Views"
             xmlns:vms="clr-namespace:EBoardSDK.ViewModels" 
             xmlns:esdkCtrlQuadSetup="clr-namespace:EBoardSDK.Controls.QuadValueSetup"
             xmlns:enums="clr-namespace:EBoardSDK.Enums"
             xmlns:fuim="clr-namespace:EBoardSDK.Controls.FluidUIMenu"
             x:Name="EBoard_EBoardSettings"
             d:DataContext="{d:DesignInstance Type=vms:ScreenControlViewModel}"
             FontSize="{Binding ViewModel.FluidUI.Font.FontSize, NotifyOnSourceUpdated=True}"
             FontFamily="{Binding ViewModel.FluidUI.Font.FontFamily,NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
             FontWeight="{Binding ViewModel.FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}"
             mc:Ignorable="d" 
             ClipToBounds="True"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultTextBlock}" >
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="Margin" Value="0 10 10 10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBox}">
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding ViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0 0 10 0"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding ViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderThickness" Value="3"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DefaultButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="3"                            
                                CornerRadius="5" 
                                MinWidth="50"
                                MinHeight="25"
                                Margin="5"
                                Padding="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Background, NotifyOnSourceUpdated=True}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Slider" BasedOn="{StaticResource DefaultHorizontalSlider}">
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground}"/>
            <Setter Property="BorderBrush" Value="{Binding ViewModel.FluidUI.Design.Border}"/>
            <Setter Property="BorderThickness" Value="3 0"/>

            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{Binding ViewModel.FluidUI.Design.Foreground}"/>
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Background}"/>
                </Trigger>

                <Trigger Property="IsSelected" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding ViewModel.FluidUI.Design.Highlight}"/>
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Background}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{Binding ViewModel.FluidUI.Design.Foreground}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="{Binding ViewModel.FluidUI.Design.Background}"
            BorderBrush="{Binding ViewModel.FluidUI.Design.Border}"
            BorderThickness="{Binding ViewModel.FluidUI.Size.BorderThickness}"
            CornerRadius="{Binding ViewModel.FluidUI.Size.CornerRadius}"
            Padding="{Binding ViewModel.FluidUI.Size.Padding}"
            Margin="{Binding ViewModel.FluidUI.Size.Margin}">

        <TabControl Background="Transparent">
            <TabItem Header="Plugins">
                <!-- arrangement 
        TODO: move to separate view and implement new viewmodel-->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <!-- Button >Select< ComboBox >SelectionTargets< ComboBox >Plugins<-->
                    <Button Content="Select" Command="{Binding SelectCommand}"
                            Grid.Column="0"
                            Grid.Row="0"/>

                    <Button Content="Copy"
                            IsEnabled="False"
                            Command="{Binding CopyCommand}"
                            Grid.Column="0"
                            Grid.Row="1"/>

                    <Button Content="Clear" Command="{Binding ClearCommand}"
                            Grid.Column="0"
                            Grid.Row="2"/>

                    <fuim:PluginSelectionView DataContext="{Binding PluginSelectionViewModel}"
                                              Grid.Column="1"
                                              Grid.Row="0"/>
                </Grid>
            </TabItem>

            <TabItem Header="FluidUI">
                <!-- arrangement 
        TODO: move to separate view and implement new viewmodel-->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <!-- Button >Reset< ComboBox >ConfigurationTargets< -->
                    <Button Content="Reset" Command="{Binding ResetSelectedCommand}"
                            Grid.Column="0"
                            Grid.Row="0"/>

                    <Button Content="Load" Command="{Binding LoadConfigurationOnSelectedCommand}"
                            Grid.Column="0"
                            Grid.Row="1"/>

                    <fuim:FluidUISelectionView DataContext="{Binding FluidUISelectionViewModel}"
                                               ConfirmationButtonVisible="False"
                                               Grid.Column="1"
                                               Grid.Row="0"
                                               Grid.RowSpan="2"/>
                    <!--<ComboBox ItemsSource="{Binding Source={StaticResource configurationTargetsEnum}, NotifyOnSourceUpdated=True}"
                          SelectedItem="{Binding ConfigurationTarget}"
                          Foreground="{Binding ViewModel.FluidUI.Design.Foreground}"
                            Grid.Column="1"
                          Grid.Row="1"/>-->
                    

                </Grid>
            </TabItem>
            
            <TabItem Header="Commands">
                <!-- arrangement 
        TODO: move to separate view and implement new viewmodel-->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                </Grid>
            </TabItem>

            <TabItem Header="Grouping">
                <!-- arrangement 
        TODO: move to separate view and implement new viewmodel-->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Arrangement Rotation"
                       Grid.Column="0"
                       Grid.Row="0"/>
                    <TextBox Text="{Binding ArrangementRotationValue, NotifyOnSourceUpdated=True}"
                       Grid.Column="1"
                       Grid.Row="0"/>
                    <Slider Value="{Binding ArrangementRotationValue, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True, UpdateSourceTrigger=PropertyChanged}"
                    Minimum="-90"
                    Maximum="90"
                    Width="361"
                    Grid.Column="2"
                    Grid.Row="0"/>

                    <TextBlock Text="Arrangement Offset"
                       Grid.Column="0"
                       Grid.Row="1"/>
                    <TextBox Text="{Binding ArrangementOffsetValue, NotifyOnSourceUpdated=True}"
                       Grid.Column="1"
                       Grid.Row="1"/>
                    <Slider Value="{Binding ArrangementOffsetValue, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True, UpdateSourceTrigger=PropertyChanged}"
                    Minimum="-90"
                    Maximum="90"
                    Width="361"
                    Grid.Column="2"
                    Grid.Row="1"/>

                    <Button Content="Line" Command="{Binding ArrangeGroupAsLineCommand}"
                    Grid.Column="0"
                    Grid.Row="2"/>
                    <Button Visibility="Hidden" IsEnabled="False" Content="Square" Command="{Binding ArrangeGroupAsSquareCommand}"
                    Grid.Column="1"
                    Grid.Row="2"/>
                    <Button Visibility="Hidden" IsEnabled="False" Content="Random 10x10" Command="{Binding ArrangeGroupAsRandomMatrix10x10Command}"
                    Grid.Column="2"
                    Grid.Row="2"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Border>
</UserControl>

<!-- EOF -->