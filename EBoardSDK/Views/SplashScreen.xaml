<Window x:Class="EBoardSDK.Views.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EBoardSDK.ViewModels"
        Name="splashscreenWindow"
        d:DataContext="{d:DesignInstance Type=local:SplashScreenViewModel}"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        
        mc:Ignorable="d"
        Background="Transparent"
        Foreground ="AntiqueWhite">
    <Grid Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding TitleMessage}"
                   Grid.Row="0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                 FontSize="15"                
                   Foreground="Wheat"/>

        <TextBlock Text="{Binding LogMessage}"
                   Grid.Row="1"
                   Padding="20 10"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   TextWrapping="Wrap"
                   MinWidth="500"
                   MinHeight="250"
                 FontSize="15"                
                   Foreground="Wheat"/>
    </Grid>

</Window>
