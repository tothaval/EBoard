<UserControl x:Class="EboardElementPluginCountDownTimer.Views.CountDownTimerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EboardElementPluginCountDownTimer.Views"
             xmlns:vms="clr-namespace:EboardElementPluginCountDownTimer.ViewModels"
             xmlns:comps="clr-namespace:EboardElementPluginCountDownTimer.Components"
             d:DataContext="{d:DesignInstance Type=vms:CountDownTimerViewModel}"
             Foreground="{Binding ElementViewModel.FluidUI.Design.Foreground}"
             FontSize="{Binding ElementViewModel.FluidUI.Font.FontSize, NotifyOnSourceUpdated=True}"
             FontFamily="{Binding ElementViewModel.FluidUI.Font.FontFamily, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
             FontWeight="{Binding ElementViewModel.FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}"
             mc:Ignorable="d"
             Margin="10"
             ClipToBounds="True"
             d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultTextBlock}" >
            <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBox}">
            <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding ElementViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0 0 10 0"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding ElementViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderThickness" Value="3"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DefaultButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="3"                            
                                CornerRadius="5" 
                                MinWidth="50"
                                MinHeight="25"
                                Margin="5"
                                Padding="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                    <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Background, NotifyOnSourceUpdated=True}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <Grid HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   FontWeight="Bold"
                   Text="{Binding Name}"
                   Visibility="{Binding ElementViewModel.HideControl3, Converter={StaticResource InverseVisibilityToCollapsed}}"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"/>

        <TextBlock Text="{Binding Countdown, NotifyOnSourceUpdated=True}"
                   Foreground="{Binding ElementViewModel.FluidUI.Design.Foreground}"
                   TextAlignment="Right"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   Grid.Row="1"/>

        <Grid Grid.Column="0"
              Grid.ColumnSpan="2"
              Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Text="Start:"
                       Grid.Column="0"/>

            <comps:DateTimePicker Year="{Binding SelectedYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Months="{Binding Months, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Month="{Binding SelectedMonth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Days="{Binding Days, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Day="{Binding SelectedDay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Hours="{Binding Hours, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Hour="{Binding SelectedHour, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Minutes="{Binding Minutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Minute="{Binding SelectedMinute, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Grid.Column="1"/>
        </Grid>

        <Grid Grid.Column="0"
              Grid.ColumnSpan="2"
              Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Text="Stop:"
                       Grid.Column="0"/>

            <comps:DateTimePicker Year="{Binding SelectedYear_Stop, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Months="{Binding Months, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Month="{Binding SelectedMonth_Stop, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Days="{Binding Days_Stop, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Day="{Binding SelectedDay_Stop, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Hours="{Binding Hours, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Hour="{Binding SelectedHour_Stop, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Minutes="{Binding Minutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Minute="{Binding SelectedMinute_Stop, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Grid.Column="2"/>

        </Grid>


        <Button Content="Start" Command="{Binding StartTimerCommand}"
                CommandParameter="ExampleButton"
                Grid.Column="0"
                Grid.Row="4"/>

        <Button Content="Stop" Command="{Binding StopTimerCommand}"
                CommandParameter="ExampleButton"
                Grid.Column="1"
                Grid.Row="4"/>
        
    </Grid>
</UserControl>

<!-- EOF -->