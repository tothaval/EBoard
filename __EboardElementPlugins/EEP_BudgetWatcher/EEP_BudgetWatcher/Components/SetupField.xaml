<UserControl x:Class="EEP_BudgetWatcher.Components.SetupField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EEP_BudgetWatcher.Components"
             xmlns:System="clr-namespace:System;assembly=mscorlib"             
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>
        <Style TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0 5"/>
        </Style>

        <Style TargetType="Border">
            <Setter Property="BorderThickness" Value="2 2 2 2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource HeaderBrush}"/>
        </Style>
    </UserControl.Resources>

    <UniformGrid Margin="5" Columns="3">
        <Border/>
        <!-- SelectedCulture (date and currency) combobox -->
        <Border>
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Culture"
                           Style="{StaticResource StringValueTextBlock}"
                           MinWidth="100"
                           Grid.Column="0"
                           VerticalAlignment="Center"/>

                <ComboBox ItemsSource="{Binding Currency}"
                          SelectedItem="{Binding SelectedCulture}"
                          MinWidth="100" 
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          VerticalContentAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Text="{Binding DisplayName}"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource StringValueTextBlock}"/>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </Border>
        
        <!-- FontFamily combobox -->
        <Border>
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="FontFamily"
                           Style="{StaticResource StringValueTextBlock}"
                           MinWidth="100"
                           Grid.Column="0"
                           VerticalAlignment="Center"/>

                <ComboBox ItemsSource="{Binding Source={x:Static Fonts.SystemFontFamilies}}"
                          SelectedItem="{Binding FontFamily}"
                          MinWidth="100" 
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          VerticalContentAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Text="{Binding Source}"
                                           FontFamily="{Binding Source}"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource StringValueTextBlock}"/>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </Border>
        
        <!-- ButtonCornerRadius slider -->
        <Border>
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Style="{StaticResource StringValueTextBlock}"
                           MinWidth="100"
                           VerticalAlignment="Center"
                           Grid.Column="0"
                           Text="Button Radius"/>

                <Slider Interval="1"
                        Grid.Column="1"
                        Value="{Binding ButtonCornerRadius}"
                        LargeChange="5"
                        SmallChange="1"
                        IsSnapToTickEnabled="True"
                        Minimum="0"
                        Maximum="55"
                        Width="100">
                </Slider>

                <TextBlock Style="{StaticResource DoubleValueTextBlock}"
                           VerticalAlignment="Center"
                           MinWidth="50"
                           Grid.Column="2" Text="{Binding ButtonCornerRadius}"/>
            </Grid>
        </Border>

        <!-- VisibilityFieldCornerRadius slider -->
        <Border>
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Style="{StaticResource StringValueTextBlock}"
                           MinWidth="100"
                           VerticalAlignment="Center"
                           Grid.Column="0"
                           Text="Field Radius"/>

                <Slider Interval="1"
                        Grid.Column="1"
                        Value="{Binding VisibilityFieldCornerRadius}"
                        LargeChange="5"
                        SmallChange="1"
                        IsSnapToTickEnabled="True"
                        Minimum="0"
                        Maximum="55"
                        Width="100">
                </Slider>

                <TextBlock Style="{StaticResource DoubleValueTextBlock}"
                           VerticalAlignment="Center"
                           MinWidth="50"
                           Grid.Column="2"
                           Text="{Binding VisibilityFieldCornerRadius}"/>
            </Grid>
        </Border>

        <!-- FontSize slider -->
        <Border>
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Style="{StaticResource StringValueTextBlock}"
                           MinWidth="100"
                           VerticalAlignment="Center"
                           Grid.Column="0"
                           Text="FontSize"/>

                <Slider Interval="1"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        Value="{Binding FontSize,
                UpdateSourceTrigger=PropertyChanged,
                Mode=TwoWay}"
                        LargeChange="4"
                        SmallChange="1"
                        IsSnapToTickEnabled="True"
                        Minimum="8"
                        Maximum="20"   
                        Width="100">
                </Slider>

                <TextBlock Text="{Binding FontSize}"
                           FontSize="{Binding FontSize}"
                           Style="{StaticResource DoubleValueTextBlock}"
                           Grid.Column="2"
                           MinWidth="75"/>
                
                <Button Content="*"
                        Command="{Binding ApplyFontSizeCommand}"
                        Style="{DynamicResource buttonStyle}"
                        Grid.Column="3"/>
            </Grid>
        </Border>

        <!-- ForegroundColor picker -->
        <Border>
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Foreground"
                           Style="{StaticResource StringValueTextBlock}"
                           MinWidth="100"
                           VerticalAlignment="Center"
                           Grid.Column="0"/>
            </Grid>
        </Border>

        <!-- BackgroundColor picker  -->
        <Border>
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Background"
                           Style="{StaticResource StringValueTextBlock}"
                           MinWidth="100"
                           Grid.Column="0"/>
            </Grid>
        </Border>

        <!-- HeaderTextColor picker  -->
        <Border>
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Header"
                           Style="{StaticResource StringValueTextBlock}"
                           MinWidth="100"
                           Grid.Column="0"/>
            </Grid>
        </Border>

        <!-- SelectionColor picker  -->
        <Border>
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Selection"
                           Style="{StaticResource StringValueTextBlock}"
                           MinWidth="100"
                           Grid.Column="0"/>
            </Grid>
        </Border>

        <!-- GainColor picker  -->
        <Border>
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Gain"
                           Style="{StaticResource StringValueTextBlock}"
                           MinWidth="100"
                           Grid.Column="0"/>
            </Grid>
        </Border>

        <!-- ExpenseColor picker  -->
        <Border>
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Expense"
                           Style="{StaticResource StringValueTextBlock}"
                           MinWidth="100"
                           Grid.Column="0"/>
            </Grid>
        </Border>
    </UniformGrid>
</UserControl>

<!-- EOF -->