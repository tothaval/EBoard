<UserControl x:Class="EEP_Drives.DriveInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EEP_Drives"
             d:DataContext="{d:DesignInstance Type=local:DriveInfoViewModel}"
             FontSize="{Binding Plugin.ElementViewModel.FluidUI.Font.FontSize, NotifyOnSourceUpdated=True}"
             FontFamily="{Binding Plugin.ElementViewModel.FluidUI.Font.FontFamily, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
             FontWeight="{Binding Plugin.ElementViewModel.FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}"
             Name="DrivesElement"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="5 2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{Binding Plugin.ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="{Binding Plugin.ElementViewModel.FluidUI.Design.Background, NotifyOnSourceUpdated=True}"/>
            <Setter Property="BorderBrush" Value="{Binding Plugin.ElementViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"/>
            <Setter Property="Foreground" Value="{Binding Plugin.ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
        </Style>

        <Style TargetType="ToolTip" BasedOn="{StaticResource DefaultToolTip}">
            <Setter Property="Background" Value="{Binding Plugin.ElementViewModel.FluidUI.Design.Background}"/>
            <Setter Property="BorderBrush" Value="{Binding Plugin.ElementViewModel.FluidUI.Design.Border}"/>
            <Setter Property="Foreground" Value="{Binding Plugin.ElementViewModel.FluidUI.Design.Foreground}"/>
            <Setter Property="FontSize" Value="{Binding Plugin.ElementViewModel.FluidUI.Font.FontSize}"/>
            <Setter Property="FontFamily" Value="{Binding Plugin.ElementViewModel.FluidUI.Font.FontFamily, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"/>
            <Setter Property="FontWeight" Value="{Binding Plugin.ElementViewModel.FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}"/>
        </Style>
    </UserControl.Resources>

    <Button Background="Transparent"
            Command="{Binding ElementName=DrivesElement, Path=DriveButtonCommand}"
            CommandParameter="{Binding DriveInfo}"
            FontFamily="{Binding Plugin.ElementViewModel.FluidUI.Font.FontFamily}"
            FontSize="{Binding Plugin.ElementViewModel.FluidUI.Font.FontSize}"
            FontWeight="{Binding Plugin.ElementViewModel.FluidUI.Font.FontWeight}">

        <Button.ToolTip>
            <ToolTip>
                <TextBlock>
                            <Run Text="{Binding RootDirectory}"/>
                            <Run Text="{Binding DriveType}"/>
                            <Run Text="{Binding DriveFormat}"/>
                            <Run Text="{Binding FreeSpace}"/>
                            <Run Text="/"/>
                            <Run Text="{Binding Size}"/>
                </TextBlock>
            </ToolTip>
        </Button.ToolTip>

        <Button.Content>
            <TextBlock>               
                <Run Text="{Binding VolumeLabel}"/>
                
                <LineBreak/>
                
                <Border Width="100"
                    BorderBrush="{Binding Plugin.ElementViewModel.FluidUI.Design.Border}"
                    BorderThickness="1"
                    HorizontalAlignment="Left"
                    Height="4">
                    <Rectangle Width="{Binding SizeIndicationPercent}"
                               Fill="{Binding Plugin.ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"
                               HorizontalAlignment="Left"/>
                </Border>
                
            <LineBreak/>
                
                <Run Text="{Binding Name}"/>
                <Run Text="{Binding AvailableFreeSpace}"/>
                <Run Text="/"/>                
                <Run Text="{Binding Size}"/>
            </TextBlock>
        </Button.Content>
    </Button>
</UserControl>

