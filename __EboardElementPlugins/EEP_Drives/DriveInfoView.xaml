<UserControl x:Class="EEP_Drives.DriveInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EEP_Drives"
             xmlns:link="clr-namespace:EBoardSDK.Plugins.Elements.Link;assembly=EBoardSDK"
             d:DataContext="{d:DesignInstance Type=local:DriveInfoViewModel}"
             FontSize="{Binding DrivesViewModel.ElementViewModel.FluidUI.Font.FontSize, NotifyOnSourceUpdated=True}"
             FontFamily="{Binding DrivesViewModel.ElementViewModel.FluidUI.Font.FontFamily, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
             FontWeight="{Binding DrivesViewModel.ElementViewModel.FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}"
             Name="DrivesElement"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <Style TargetType="ToolTip" BasedOn="{StaticResource DefaultToolTip}">
            <Setter Property="Background" Value="{Binding DrivesViewModel.ElementViewModel.FluidUI.Design.Background}"/>
            <Setter Property="BorderBrush" Value="{Binding DrivesViewModel.ElementViewModel.FluidUI.Design.Border}"/>
            <Setter Property="Foreground" Value="{Binding DrivesViewModel.ElementViewModel.FluidUI.Design.Foreground}"/>
            <Setter Property="FontSize" Value="{Binding DrivesViewModel.ElementViewModel.FluidUI.Font.FontSize}"/>
            <Setter Property="FontFamily" Value="{Binding DrivesViewModel.ElementViewModel.FluidUI.Font.FontFamily, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"/>
            <Setter Property="FontWeight" Value="{Binding DrivesViewModel.ElementViewModel.FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}"/>
        </Style>
        
        <Style TargetType="Border" x:Key="itemBorder">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding DrivesViewModel.ElementViewModel.FluidUI.Design.Highlight}"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
    </UserControl.Resources>
    <UserControl.ToolTip>
        <ToolTip Content="{Binding ToolTipText}"
                 Visibility="{Binding DrivesViewModel.ShowToolTip, Converter={StaticResource VisibilityToCollapsed}}"/>
    </UserControl.ToolTip>

    <Border BorderBrush="{Binding DrivesViewModel.ElementViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"
                                BorderThickness="1"
                                CornerRadius="{Binding DrivesViewModel.ElementViewModel.FluidUI.Size.CornerRadius}"
                                Margin="2"
                                MinWidth="50"
                                MinHeight="20"
            Style="{StaticResource itemBorder}">
        <Border.InputBindings>
            <MouseBinding Gesture="LeftClick"
                          Command="{Binding OpenDriveCommand}"/>
        </Border.InputBindings>

        <link:LinkView DataContext="{Binding LinkViewModel}"/>
    </Border>
</UserControl>

<!-- EOF -->