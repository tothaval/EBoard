<UserControl x:Class="EEP_Drives.DrivesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EEP_Drives"
             d:DataContext="{d:DesignInstance Type=local:DrivesViewModel}"
             FontSize="{Binding ElementViewModel.FluidUI.Font.FontSize, NotifyOnSourceUpdated=True}"
             FontFamily="{Binding ElementViewModel.FluidUI.Font.FontFamily, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
             FontWeight="{Binding ElementViewModel.FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultTextBlock}" >
            <Setter Property="Foreground" Value="{Binding ElementViewModel.FluidUI.Design.Foreground, NotifyOnSourceUpdated=True}"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Header, Mode=OneWay}"
                   HorizontalAlignment="Center"
                   Grid.Row="0"/>

        <Border Grid.Row="1"
                BorderBrush="{Binding ElementViewModel.FluidUI.Design.Border, NotifyOnSourceUpdated=True}"
                BorderThickness="1"
                CornerRadius="{Binding ElementViewModel.FluidUI.Size.CornerRadius, NotifyOnSourceUpdated=True}"
                ClipToBounds="True">

            <ItemsControl ItemsSource="{Binding Drives}" 
                          x:Name="drivesList"
                  BorderThickness="0"
                  ClipToBounds="True">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:DriveInfoView HorizontalContentAlignment="Stretch"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</UserControl>

<!-- EOF -->