<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:viewmodels="clr-namespace:EEP_FSNavigator.ViewModels"
                    xmlns:views="clr-namespace:EEP_FSNavigator.Views">

    <DataTemplate DataType="{x:Type viewmodels:FSNMainViewModel}">
        <views:FSNMainView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewmodels:FSNDirectoryDetailsViewModel}">
        <views:FSNDirectoryDetailsView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewmodels:FSNFileSystemTreeViewModel}">
        <views:FSNFileSystemTreeView/>
    </DataTemplate>

    <ImageBrush ImageSource="/EEP_FSNavigator;component/Images/FSNavigator_Logo.png"
                x:Key="FSNavigator_Logo"/>

    <Style TargetType="TextBlock" x:Key="FSNavigatorTextBlockStyle">
        <Setter Property="Foreground"  Value="{Binding BrushManagement.Foreground, NotifyOnSourceUpdated=True}"/>
    </Style>

    <Style TargetType="TextBox" x:Key="txtbx">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="IsReadOnlyCaretVisible" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{Binding BrushManagement.Foreground, NotifyOnSourceUpdated=True}"/>
        <Setter Property="FontSize" Value="15"/>
    </Style>

</ResourceDictionary>