<UserControl x:Class="EEP_FSNavigator.Views.FSNFileSystemTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"              
             xmlns:classes="clr-namespace:EEP_FSNavigator.TreeViewFileExplorer.ShellClasses"
             xmlns:conv="clr-namespace:EEP_FSNavigator.Converters"
             xmlns:local="clr-namespace:EEP_FSNavigator.Views"
             xmlns:viewmodels="clr-namespace:EEP_FSNavigator.ViewModels"
             x:Name="FSNFileSystemTree"
             d:DataContext="{d:DesignInstance Type=viewmodels:FSNFileSystemTreeViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    
    <TreeView Name="treeView" Margin="5"
              Background="Transparent"
              BorderBrush="Transparent"
              BorderThickness="0">

        <TreeView.ItemContainerStyle>
            <Style TargetType="{x:Type TreeViewItem}">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />                
                <Setter Property="KeyboardNavigation.AcceptsReturn" Value="True" />
            </Style>
        </TreeView.ItemContainerStyle>
        <TreeView.Resources>
            <HierarchicalDataTemplate DataType="{x:Type classes:FileSystemObjectInfo}" ItemsSource="{Binding Path=Children}">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{Binding Path=ImageSource, UpdateSourceTrigger=PropertyChanged}" Margin="0,1,8,1"></Image>
                    <TextBlock Text="{Binding Path=FileSystemInfo.Name}"
                               Foreground="{Binding Path=DataContext.BrushManagement.Foreground,
                        RelativeSource={RelativeSource AncestorType={x:Type local:FSNMainView}}}"
                               Style="{StaticResource FSNavigatorTextBlockStyle}"></TextBlock>
                </StackPanel>
            </HierarchicalDataTemplate>
        </TreeView.Resources>
    </TreeView>
    
</UserControl>
