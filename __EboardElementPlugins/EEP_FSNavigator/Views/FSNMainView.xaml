<UserControl x:Class="EEP_FSNavigator.Views.FSNMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EEP_FSNavigator.Views"
             xmlns:viewmodels="clr-namespace:EEP_FSNavigator.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:FSNMainViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding PluginHeader}" Foreground="{Binding BrushManagement.Foreground}"
                   Grid.Column="0" Grid.ColumnSpan="3"
                   Grid.Row="0"/>

        <local:FSNFileSystemTreeView DataContext="{Binding FileSystemTreeVM}"
                                     Grid.Column="0"
                                     Grid.Row="1"/>

        <GridSplitter Grid.Column="1" 
                      Grid.Row="1"
                      Margin="20 0 0 0"
                      Width="4"
                      ResizeBehavior="PreviousAndNext"                      
                      Background="{Binding BrushManagement.Border}"/>

        <local:FSNDirectoryDetailsView DataContext="{Binding DirectoryDetailsVM}"
                                       Grid.Column="2"
                                       Grid.Row="1"
                                       Margin="5 0 0 0"
                                       HorizontalAlignment="Left"
                                       HorizontalContentAlignment="Stretch"/>
        
    </Grid>
</UserControl>
