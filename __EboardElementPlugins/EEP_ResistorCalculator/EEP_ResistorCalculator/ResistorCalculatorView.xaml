<UserControl x:Class="EEP_ResistorCalculator.ResistorCalculatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EEP_ResistorCalculator"    
             d:DataContext="{d:DesignInstance Type=local:ResistorCalculatorViewModel}"
             FontSize="{Binding ElementViewModel.FluidUI.Font.FontSize, NotifyOnSourceUpdated=True}"
             FontFamily="{Binding ElementViewModel.FluidUI.Font.FontFamily, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
             FontWeight="{Binding ElementViewModel.FluidUI.Font.FontWeight, NotifyOnSourceUpdated=True}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>
        <Style TargetType="Rectangle" x:Key="rectStyle">
            <Setter Property="MinWidth" Value="20"/>
            <Setter Property="MaxWidth" Value="10"/>
            <Setter Property="MinHeight" Value="35"/>
            <Setter Property="MaxHeight" Value="35"/>
            <Setter Property="Margin" Value="10 10"/>
        </Style>        
    </UserControl.Resources>

    <Grid Background="Transparent"
          MinWidth="100" 
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   FontWeight="Bold"
                   Text="{Binding Name}"
                   Visibility="{Binding ElementViewModel.HideControl3, Converter={StaticResource InverseVisibilityToCollapsed}}"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"/>

        <Border BorderBrush="DarkSlateGray"
                BorderThickness="3"
                Background="AntiqueWhite"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Grid.Column="0"
                Grid.ColumnSpan="4"
                Grid.Row="1"
                Grid.RowSpan="3" />

        <Rectangle Fill="{Binding Band1ColorIndicatorRectangle}"
                   Style="{StaticResource rectStyle}"
                   Stroke="Black"
                   Grid.Column="0"
                   Grid.Row="1"/>

        <Rectangle Fill="{Binding Band2ColorIndicatorRectangle}"
                   Style="{StaticResource rectStyle}"
                   Stroke="Black"
                   Grid.Column="1"
                   Grid.Row="1"/>

        <Rectangle Fill="{Binding Band3ColorIndicatorRectangle}"
                   Style="{StaticResource rectStyle}"
                   Stroke="Black"
                   Grid.Column="2"
                   Grid.Row="1"/>

        <Rectangle Fill="{Binding Band4ColorIndicatorRectangle}"
                   Style="{StaticResource rectStyle}"
                   Stroke="Black"
                   Grid.Column="3"
                   Grid.Row="1"/>

        <Border Background="Transparent"
                Grid.Column="0"
                Grid.ColumnSpan="4"
                Grid.Row="2">
            <TextBlock Text="TODO implement color value selection"
                       Margin="5"/>
        </Border>

        <Border Background="Transparent"
                Grid.Column="0"
                Grid.ColumnSpan="4"
                Grid.Row="3">
            <TextBlock Text="TODO implement color value selection"
                       Margin="5"/>
        </Border>
    </Grid>
</UserControl>

<!-- EOF -->